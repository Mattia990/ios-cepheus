#!/usr/bin/env python3
"""Grab the cepheus panel from /dev/pmem and save it as a PNG.

  tools/cepheus-shot OUT.png [--stride 4352] [--width 1080] [--height 2340]
                              [--base 0x9c000000] [--raw FILE]

The GPU-presented framebuffer is 1088x2340 BGRA with a 4352-byte stride; the
left 1080 columns are the panel.  --raw decodes an existing dump instead of
reading the phone.  CEPH_FILES_HOST selects the phone (default 127.0.0.1:2223,
i.e. FlameBridge; use 192.168.7.2 for the direct USB route).
"""
import argparse
import os
import struct
import subprocess
import sys
import tempfile
import zlib

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))


def png_chunk(kind, data):
    return struct.pack(">I", len(data)) + kind + data + struct.pack(">I", zlib.crc32(kind + data) & 0xffffffff)


def write_png(path, width, height, rows):
    raw = b"".join(b"\x00" + row for row in rows)
    ihdr = struct.pack(">IIBBBBB", width, height, 8, 2, 0, 0, 0)
    data = b"\x89PNG\r\n\x1a\n"
    data += png_chunk(b"IHDR", ihdr)
    data += png_chunk(b"IDAT", zlib.compress(raw, 6))
    data += png_chunk(b"IEND", b"")
    with open(path, "wb") as f:
        f.write(data)


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("out")
    ap.add_argument("--stride", type=lambda s: int(s, 0), default=4352)
    ap.add_argument("--width", type=int, default=1080)
    ap.add_argument("--height", type=int, default=2340)
    ap.add_argument("--base", type=lambda s: int(s, 0), default=0x9C000000)
    ap.add_argument("--raw")
    args = ap.parse_args()

    tmp = None
    try:
        if args.raw:
            raw = open(args.raw, "rb").read()
        else:
            fd, tmp = tempfile.mkstemp(prefix="cepheus-fb-", suffix=".raw")
            os.close(fd)
            env = dict(os.environ)
            cmd = [sys.executable, os.path.join(ROOT, "tools", "cepheus-files.py"), "read",
                   "/dev/pmem", hex(args.base), str(args.stride * args.height), tmp]
            subprocess.run(cmd, check=True, env=env, stdout=subprocess.DEVNULL)
            raw = open(tmp, "rb").read()
    finally:
        if tmp:
            try:
                os.unlink(tmp)
            except OSError:
                pass

    need = args.stride * args.height
    if len(raw) < need:
        sys.exit(f"short framebuffer: {len(raw)} of {need} bytes")

    # BGRA rows -> RGB, cropping the padding columns on the right.
    rows = []
    for y in range(args.height):
        off = y * args.stride
        line = raw[off:off + args.width * 4]
        rgb = bytearray(args.width * 3)
        rgb[0::3] = line[2::4]
        rgb[1::3] = line[1::4]
        rgb[2::3] = line[0::4]
        rows.append(bytes(rgb))
    write_png(args.out, args.width, args.height, rows)
    print(f"{args.out}: {args.width}x{args.height} from 0x{args.base:x} stride {args.stride}")


if __name__ == "__main__":
    main()
