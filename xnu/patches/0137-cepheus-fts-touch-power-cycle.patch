+/*
+ * Both touch rails are dedicated to the controller: vdd-supply is
+ * touch_vddio_vreg (fixed regulator, GPIO 84) and avdd-supply is PM8150L L1
+ * (RPMh ldoc1, 1.8 V). Assert reset and remove both before powering up again.
+ */
+static void
+fts_rails_off(void)
+{
+	const uint32_t enable_off[1] = { 4 };
+	const uint32_t value_off[1] = { 0 };
+
+	fts_gpio(ft.gpio_n, FTS_PIN_RESET, 0, 3, 3, true, false);
+	(void)sweet_rpmh_write("ldoc1", 1, enable_off, value_off);
+	fts_gpio(ft.gpio_n, FTS_PIN_VDDIO, 0, 0, 0, true, false);
+	fts_wait(100);
+}
+
+/*
+ * A warm reboot (TWRP -> bootloader -> fastboot boot) leaves the controller's
+ * analog front end powered. A reset alone does not clear that state: the first
+ * force calibration then fails (43 05 30/31 or water mode) and the chip goes
+ * silent. Cycling both rails reproduces a cold boot.
+ */
+static int
+fts_power_cycle(void)
+{
+	fts_release_all();
+	fts_rails_off();
+	int aerr = sweet_rpmh_vreg_enable("ldoc1", 1800);
+	fts_wait(20);
+	fts_gpio(ft.gpio_n, FTS_PIN_VDDIO, 0, 0, 0, true, true);
+	fts_wait(4);
+	fts_gpio(ft.gpio_n, FTS_PIN_RESET, 0, 3, 3, true, true);
+	fts_wait(50);
+	if (!fts_bb_recover()) {
+		printf("SWEET FTS: power cycle: SCL stuck low\n");
+		return EIO;
+	}
+	int err = fts_wait_ready(500);
+	if (err) {
+		printf("SWEET FTS: power cycle: ready err=%d avdd=%d\n", err, aerr);
+	}
+	return err;
 }
 
