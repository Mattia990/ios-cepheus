+static int
+fts_panel_replay_on(void)
+{
+	uint8_t image[160];
+	static volatile uint32_t *dsi;
+	uint32_t dma_save;
+	unsigned pos = 0, n = 0, sent = 0, errs = 0;
+	int enabled = 1;
+	unsigned hs = 0;
+	int lpm;
+
+	(void)PE_parse_boot_argn("cepheustouchpanel", &enabled, sizeof(enabled));
+	if (!enabled) {
+		return 0;
+	}
+	(void)PE_parse_boot_argn("cepheustouchpanelhs", &hs, sizeof(hs));
+	lpm = hs ? 0 : 1;
+
+	if (dsi == NULL) {
+		dsi = (volatile uint32_t *)ml_io_map(FTS_DSI0_PA, FTS_DSI0_SIZE);
+		if (dsi == NULL) {
+			printf("SWEET FTS: panel replay: cannot map DSI0\n");
+			return EIO;
+		}
+	}
+	printf("SWEET FTS: panel replay dsi hw %x ctrl %x status %x fifo %x "
+	    "int %x dma %x\n",
+	    fts_rd((vm_offset_t)dsi, FTS_DSI_HW_VERSION),
+	    fts_rd((vm_offset_t)dsi, FTS_DSI_CTRL),
+	    fts_rd((vm_offset_t)dsi, FTS_DSI_STATUS),
+	    fts_rd((vm_offset_t)dsi, FTS_DSI_FIFO_STATUS),
+	    fts_rd((vm_offset_t)dsi, FTS_DSI_INT_CTRL),
+	    fts_rd((vm_offset_t)dsi, FTS_DSI_COMMAND_MODE_DMA_CTRL));
+	dma_save = fts_rd((vm_offset_t)dsi, FTS_DSI_COMMAND_MODE_DMA_CTRL);
+
+	while (pos + 7 <= sizeof(fts_panel_on)) {
+		const uint8_t *cmd = fts_panel_on + pos;
+		unsigned len = ((unsigned)cmd[5] << 8) | cmd[6];
+		unsigned wait = cmd[4];
+		unsigned size;
+		int rc;
+
+		if (pos + 7 + len > sizeof(fts_panel_on)) {
+			printf("SWEET FTS: panel cmd %u truncated at %u\n",
+			    n, pos);
+			errs++;
+			break;
+		}
+		/* Brightness is XNU's: 0x51 00 00 would blank the panel. */
+		if (cmd[0] == 0x39 && len == 3 && cmd[7] == 0x51) {
+			pos += 7 + len;
+			n++;
+			continue;
+		}
+		if (cmd[0] == 0x39) {
+			if (len > sizeof(image) - 4) {
+				errs++;
+				break;
+			}
+			image[0] = (uint8_t)len;
+			image[1] = (uint8_t)(len >> 8);
+			image[2] = 0x39;
+			image[3] = 0xc0;	/* long packet, last */
+			for (unsigned i = 0; i < len; i++) {
+				image[4 + i] = cmd[7 + i];
+			}
+			size = (4 + len + 3u) & ~3u;
+			for (unsigned i = 4 + len; i < size; i++) {
+				image[i] = 0xff;
+			}
+		} else {
+			/* Short packet: data0, data1, type, last. */
+			image[0] = cmd[7];
+			image[1] = cmd[8];
+			image[2] = cmd[0];
+			image[3] = 0x80;
+			size = 4;
+		}
+		rc = fts_dsi_send_image(dsi, image, size, lpm);
+		if (rc) {
+			errs++;
+		}
+		if (wait) {
+			fts_wait(wait);
+		}
+		pos += 7 + len;
+		n++;
+		sent++;
+	}
+
+	fts_wr((vm_offset_t)dsi, FTS_DSI_COMMAND_MODE_DMA_CTRL, dma_save);
+	printf("SWEET FTS: panel replay %u cmds, %u sent, %u errors, pos %u/%u\n",
+	    n, sent, errs, pos, (unsigned)sizeof(fts_panel_on));
+	/* TWRP's DRM notifier resets the controller 42 ms after SET_ON. */
+	fts_wait(50);
+	return errs ? EIO : 0;
+}
