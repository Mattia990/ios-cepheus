+/*
+ * 0143: replay the EA8076 SET_ON sequence at display-on.
+ *
+ * A cold boot gets a true panel POR in ABL, and the FTS calibration that
+ * follows is clean.  A warm reset skips ABL's panel init: the DDIC keeps
+ * internal state across the reset and the first scan locks onto a bad
+ * baseline (right-edge/top-row ghosts, 43 05 30) 3-4 s after sense-on.
+ * TWRP works warm because it re-inits the panel (DSI_CMD_SET_ON at 1.838 s)
+ * before its FTS sense-on at 1.880 s.
+ *
+ * XNU never replays SET_ON; it only sends DCS 0x51 for brightness.  Send
+ * the live DTB's 34-command on sequence through the DSI0 command FIFO at
+ * display-on, then let the existing display-on path reset and recalibrate
+ * the controller, mirroring TWRP's order.  The DTB marks the sequence
+ * dsi_lp_mode.  The FIFO image format is the one dsi_cmd_dma_add() builds
+ * (same as shim/panel.c and the DCS 0x51 path in SweetFramebuffer.cpp):
+ *
+ *   long:  wc_lo wc_hi 0x39 0xc0 payload... 0xff padding
+ *   short: data0 data1 dtype 0x80
+ *
+ * The 0x51 step is skipped: it writes brightness 0, and CoreBrightness's
+ * first 0x51 write lands in the middle of this replay.  XNU owns brightness.
+ *
+ * cepheustouchpanel=0 disables the replay; cepheustouchpanelhs=1 sends the
+ * commands in HS mode instead of the DTB's LP mode.
+ */
+#define FTS_DSI0_PA			0xae94000u
+#define FTS_DSI0_SIZE			0x400u
+
+#define FTS_DSI_HW_VERSION		0x0000
+#define FTS_DSI_CTRL			0x0004
+#define FTS_DSI_STATUS			0x0008
+#define FTS_DSI_FIFO_STATUS		0x000c
+#define FTS_DSI_COMMAND_MODE_DMA_CTRL	0x003c
+#define FTS_DSI_DMA_CMD_LENGTH		0x004c
+#define FTS_DSI_CMD_MODE_DMA_SW_TRIGGER	0x0090
+#define FTS_DSI_INT_CTRL		0x0110
+#define FTS_DSI_TEST_PATTERN_GEN_CTRL	0x015c
+#define FTS_DSI_TEST_PATTERN_GEN_CMD_DMA_INIT_VAL 0x017c
