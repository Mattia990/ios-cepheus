+static int
+fts_dsi_send_image(volatile uint32_t *dsi, const uint8_t *image, unsigned size,
+    int lpm)
+{
+	uint32_t ctrl, ints;
+	uint64_t deadline;
+	unsigned i;
+
+	fts_wr((vm_offset_t)dsi, FTS_DSI_TEST_PATTERN_GEN_CTRL, 0);
+	fts_wr((vm_offset_t)dsi, FTS_DSI_TPG_DMA_FIFO_RESET, 1);
+	fts_udelay(1000);
+	fts_wr((vm_offset_t)dsi, FTS_DSI_TPG_DMA_FIFO_RESET, 0);
+	fts_wr((vm_offset_t)dsi, FTS_DSI_TEST_PATTERN_GEN_CTRL,
+	    (1u << 1) | (1u << 2) | (0x3u << 16));
+	for (i = 0; i < size; i += 4) {
+		uint32_t w = (uint32_t)image[i] |
+		    ((uint32_t)image[i + 1] << 8) |
+		    ((uint32_t)image[i + 2] << 16) |
+		    ((uint32_t)image[i + 3] << 24);
+		fts_wr((vm_offset_t)dsi,
+		    FTS_DSI_TEST_PATTERN_GEN_CMD_DMA_INIT_VAL, w);
+	}
+	/* The hardware wants an extra zero DWORD for an odd word count. */
+	if ((size / 4) & 1u) {
+		fts_wr((vm_offset_t)dsi,
+		    FTS_DSI_TEST_PATTERN_GEN_CMD_DMA_INIT_VAL, 0);
+	}
+
+	ctrl = fts_rd((vm_offset_t)dsi, FTS_DSI_COMMAND_MODE_DMA_CTRL);
+	ctrl &= ~((1u << 31) | (1u << 30) | (1u << 26));
+	if (lpm) {
+		ctrl |= 1u << 26;
+	}
+	ctrl |= 1u << 28;		/* embedded FIFO mode */
+	fts_wr((vm_offset_t)dsi, FTS_DSI_COMMAND_MODE_DMA_CTRL, ctrl);
+
+	ints = fts_rd((vm_offset_t)dsi, FTS_DSI_INT_CTRL);
+	if (ints & FTS_DSI_INT_CMD_DMA_DONE) {
+		fts_wr((vm_offset_t)dsi, FTS_DSI_INT_CTRL,
+		    ints & ~FTS_DSI_INT_ERROR);
+	}
+	fts_wr((vm_offset_t)dsi, FTS_DSI_DMA_CMD_LENGTH, size);
+	__sync_synchronize();
+	fts_wr((vm_offset_t)dsi, FTS_DSI_CMD_MODE_DMA_SW_TRIGGER, 1);
+
+	deadline = mach_absolute_time() +
+	    (uint64_t)50u * FTS_TICKS_PER_US * 1000u;
+	while (!(fts_rd((vm_offset_t)dsi, FTS_DSI_INT_CTRL) &
+	    FTS_DSI_INT_CMD_DMA_DONE)) {
+		if (mach_absolute_time() > deadline) {
+			return EIO;
+		}
+		__asm__ volatile("yield" ::: "memory");
+	}
+	ints = fts_rd((vm_offset_t)dsi, FTS_DSI_INT_CTRL);
+	fts_wr((vm_offset_t)dsi, FTS_DSI_INT_CTRL, ints & ~FTS_DSI_INT_ERROR);
+	fts_wr((vm_offset_t)dsi, FTS_DSI_TEST_PATTERN_GEN_CTRL, 0);
+	fts_wr((vm_offset_t)dsi, FTS_DSI_TPG_DMA_FIFO_RESET, 1);
+	fts_udelay(1000);
+	fts_wr((vm_offset_t)dsi, FTS_DSI_TPG_DMA_FIFO_RESET, 0);
+	return 0;
+}
