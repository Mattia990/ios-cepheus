+/*
+ * boot-arg sweetbl: when to publish the fake AppleARMBacklight.
+ *   0 = never (control: CoreBrightness sees no backlight service)
+ *   1 = at AppleCLCD::start (default, phase-1 behaviour)
+ *   2 = on the first display-on requested by backboardd
+ */
+static int
+sweet_bl_mode(void)
+{
+	static int mode = -1;
+
+	if (mode < 0) {
+		mode = 1;
+		PE_parse_boot_argn("sweetbl", &mode, sizeof(mode));
+		if (mode < 0) {
+			mode = 0;
+		} else if (mode > 2) {
+			mode = 2;
+		}
+	}
+	return mode;
+}
+
 static void
-sweet_bl_publish(IOService *parent)
+sweet_bl_publish(IOService *parent, bool display_on)
 {
 	static bool published;
+	static bool reported;
 	AppleARMBacklight *backlight;
+	int mode = sweet_bl_mode();
 
 	if (published) {
+		return;
+	}
+	if (mode == 0 || (mode == 2 && !display_on)) {
+		if (!reported) {
+			IOLog("SWEET BL: %s (sweetbl=%d)\n",
+			    mode == 0 ? "disabled" : "deferred to first display-on", mode);
+			reported = true;
+		}
 		return;
 	}
 	backlight = new AppleARMBacklight;
