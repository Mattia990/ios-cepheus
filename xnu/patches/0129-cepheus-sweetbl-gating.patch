+/* boot-arg sweetfb_sel_log=1: log every externalMethod call, not just the first per selector */
+static int sweet_fb_sel_log;
+
 class IOMobileFramebuffer : public IOService {
 	OSDeclareDefaultStructors(IOMobileFramebuffer);
 
