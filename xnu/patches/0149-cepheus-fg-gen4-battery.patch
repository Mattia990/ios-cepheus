+/* FG-gen4 keeps a second copy of each sample register (the _CP register);
+ * use it for the torn-read check the vendor driver performs. */
+bool
+SweetBattery::readShadowByte(unsigned sid, unsigned address, unsigned shadow,
+    uint8_t *value)
+{
+	for (unsigned attempt = 0; attempt < 4; ++attempt) {
+		uint8_t first, second;
+		if (!readByte(sid, address, &first) ||
+		    !readByte(sid, shadow, &second)) {
+			return false;
+		}
+		if (first == second) {
+			*value = first;
+			return true;
+		}
+	}
+	return false;
+}
+
+bool
+SweetBattery::readShadowWord(unsigned sid, unsigned address, unsigned shadow,
+    uint16_t *value)
+{
+	for (unsigned attempt = 0; attempt < 4; ++attempt) {
+		uint8_t lo, hi, shadowLo, shadowHi;
+		if (!readByte(sid, address, &lo) ||
+		    !readByte(sid, address + 1, &hi) ||
+		    !readByte(sid, shadow, &shadowLo) ||
+		    !readByte(sid, shadow + 1, &shadowHi)) {
+			return false;
+		}
+		if (lo != shadowLo || hi != shadowHi) {
+			continue;
+		}
+		*value = (uint16_t)((unsigned)lo | ((unsigned)hi << 8));
+		return true;
+	}
+	return false;
+}
