+void
+SweetBattery::pollCepheus(void)
+{
+	uint8_t subtype, missing, msoc = 0;
+	uint16_t rawVoltage = 0, rawCurrent = 0;
+	unsigned mv = 0;
+	int tempCenti = 2500;
+	unsigned rawTempOut = 0;
+	bool socValid, voltageValid, currentValid, tempValid;
+
+	/* The fuel-gauge algorithm runs on the PMIC; this only observes it. */
+	bool hardware = readByte(PM8150B_USID, FG_BATT_SOC_SUBTYPE, &subtype) &&
+	    subtype == 0x10 &&
+	    readByte(PM8150B_USID, FG_BATT_INFO_SUBTYPE, &subtype) &&
+	    subtype == 0x11 &&
+	    readByte(PM8150B_USID, FG_BATT_SYS_BATT, &missing) &&
+	    !(missing & FG_BATT_MISSING_HW);
+	if (!hardware) {
+		fHaveSample = false;
+		publish(100, 4200, 0, true, true, false, true, false, false,
+		    false, 2500, false);
+		return;
+	}
+	socValid = false;
+	uint8_t socReady = 0;
+	bool socFlag = readByte(PM8150B_USID, FG_BATT_SOC_RT_STS, &socReady) &&
+	    (socReady & FG_SOC_READY);
+	bool msocRead = readShadowByte(PM8150B_USID, FG_MONOTONIC_SOC,
+	    FG_MONOTONIC_SOC_CP, &msoc);
+	socValid = socFlag && msocRead;
+	voltageValid = readShadowWord(PM8150B_USID, FG_BATT_VBATT_LSB,
+	    FG_BATT_VBATT_CP, &rawVoltage);
+	if (voltageValid) {
+		unsigned sample = (unsigned)(((uint64_t)rawVoltage * 122070u) / 1000000u);
+		if (sample >= 2800 && sample <= 4600) {
+			mv = sample;
+		} else {
+			voltageValid = false;
+		}
+	}
+	/* A transient read failure keeps the last good sample (30 s old); only a
+	 * missing PMIC or the first failed probe publishes the 100% fallback. */
+	if (!socValid && !voltageValid) {
+		if (!fHaveSample) {
+			publish(100, 4200, 0, true, true, false, true, false, false,
+			    false, 2500, false);
+		}
+		return;
+	}
+
+	currentValid = readShadowWord(PM8150B_USID, FG_BATT_IBATT_LSB,
+	    FG_BATT_IBATT_CP, &rawCurrent);
+	int ma = 0;
+	if (currentValid) {
+		int signedRaw = (rawCurrent & 0x8000u) ?
+		    (int)rawCurrent - 65536 : (int)rawCurrent;
+		/* FG negative while charging; IOPMPowerSource positive while charging. */
+		ma = (int)(-((int64_t)signedRaw * 488281) / 1000000);
+	}
+
+	tempValid = false;
+	uint8_t tempLsb, tempMsb;
+	if (readByte(PM8150B_USID, FG_BATT_TEMP_LSB, &tempLsb) &&
+	    readByte(PM8150B_USID, FG_BATT_TEMP_MSB, &tempMsb)) {
+		/* 0.25 K/LSB on the FG-gen3/4 BATT_INFO block; the gen4 SRAM
+		 * copy is 0.25 C/LSB. Accept a plausible reading from either
+		 * encoding, rejecting uninitialised zero. */
+		int rawTemp = ((int)(tempMsb & 0x07u) << 8) | tempLsb;
+		rawTempOut = (unsigned)rawTemp;
+		int kelvin = rawTemp * 25 - 27315;
+		int celsiusRaw = (rawTemp & 0x400) ? rawTemp - 2048 : rawTemp;
+		int celsius = celsiusRaw * 25;
+		if (rawTemp != 0 && kelvin >= -2000 && kelvin <= 8000) {
+			tempCenti = kelvin;
+			tempValid = true;
+		} else if (rawTemp != 0 && celsius >= -2000 && celsius <= 8000) {
+			tempCenti = celsius;
+			tempValid = true;
+		}
+	}
+
+	bool external = false, capable = false, charging = false, full = false;
+	uint8_t usbin = 0, path = 0, charger = 0, error = 0, thermal = 0;
+	bool usbValid = readByte(PM8150B_USID, SMB5_USBIN_STATUS, &usbin);
+	bool pathValid = readByte(PM8150B_USID, SMB5_POWER_PATH, &path);
+	bool statusValid = readByte(PM8150B_USID, SMB5_CHARGER_STATUS, &charger);
+	bool errorValid = readByte(PM8150B_USID, SMB5_CHARGER_ERROR, &error);
+	bool thermalValid = readByte(PM8150B_USID, SMB5_CHARGER_TEMP, &thermal);
+	if (usbValid) {
+		external = (usbin & 0x10u) != 0;
+	} else if (pathValid) {
+		external = (path & 0x10u) != 0;
+	}
+	capable = external && pathValid && (path & 0x10u) && (path & 1u) &&
+	    !(path & 0x40u);
+	if (statusValid) {
+		unsigned state = charger & 7u;
+		bool inhibit = (errorValid && (error & 0x02u)) ||
+		    (thermalValid && (thermal & 0x0cu));
+		charging = capable && state >= 1 && state <= 4 && !inhibit;
+		/* Inhibit (0) does not by itself establish full capacity. */
+		full = external && state == 5 &&
+		    !(errorValid && (error & 0x02u));
+	}
+	unsigned percent = socValid ? scaleMsoc(msoc) : estimatePercent(mv);
+	/* Raw values for bring-up: compare with TWRP/vendor sysfs. */
+	putNumber("SweetBatteryRawMSOC", msoc);
+	putNumber("SweetBatteryRawVBATT", rawVoltage);
+	putNumber("SweetBatteryRawIBATT", rawCurrent);
+	putNumber("SweetBatteryRawTemp", rawTempOut);
+	putNumber("SweetBatterySocReady", socValid);
+	putNumber("SweetBatteryChargerState", statusValid ? (charger & 7u) : 0xffu);
+	if (!fHaveSample) {
+		IOLog("SWEET BATTERY: FG sample msoc=%u ready=%d percent=%u vbatt=%u mV ibatt=%d mA temp=%d charger=%#x\n",
+		    (unsigned)msoc, socValid, percent, mv, ma, tempCenti,
+		    (unsigned)charger);
+	}
+	fHaveSample = true;
+	publish(full ? 100 : percent, mv, ma, external, capable, charging, full,
+	    true, currentValid, !socValid, tempCenti, tempValid);
+}
