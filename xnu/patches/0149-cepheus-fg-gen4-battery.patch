+/* fg_get_msoc: 0 and 255 are the endpoints; 1..254 scale to 1..99. */
+unsigned
+SweetBattery::scaleMsoc(unsigned raw)
+{
+	if (raw >= 255) {
+		return 100;
+	}
+	if (raw == 0) {
+		return 0;
+	}
+	return ((raw - 1) * 98 + 126) / 253 + 1;
+}
+
+bool
+SweetBattery::probeCepheus(void)
+{
+	uint8_t subtype;
+	/* PM8150B is SPMI USID 2. Require both FG-gen4 subtypes so an
+	 * unrelated or stale APID cannot masquerade as the fuel gauge. */
+	if (!readByte(PM8150B_USID, FG_BATT_SOC_SUBTYPE, &subtype)) {
+		IOLog("SWEET BATTERY: PM8150B batt-soc read failed (USID 2)\n");
+		return false;
+	}
+	if (subtype != 0x10) {
+		IOLog("SWEET BATTERY: PM8150B batt-soc subtype %#x, expected 0x10\n",
+		    (unsigned)subtype);
+		return false;
+	}
+	if (!readByte(PM8150B_USID, FG_BATT_INFO_SUBTYPE, &subtype)) {
+		IOLog("SWEET BATTERY: PM8150B batt-info read failed\n");
+		return false;
+	}
+	if (subtype != 0x11) {
+		IOLog("SWEET BATTERY: PM8150B batt-info subtype %#x, expected 0x11\n",
+		    (unsigned)subtype);
+		return false;
+	}
+	return true;
+}
