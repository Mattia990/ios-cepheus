@@ -0,0 +1,774 @@
+/*
+ * cepheus touch: ST FTS on I2C, slave address 0x49, panel 1080x2340.
+ * Live FDT: /soc/i2c@0xc80000/fts@49 (compatible "st,fts"). The bus is
+ * qup17 on GPIO 55 (SDA) / 56 (SCL), south TLMM; IRQ 122 (south TLMM),
+ * reset 12 and VDDIO enable 84 (north TLMM). VDDIO is touch_vddio_vreg
+ * (fixed regulator on GPIO 84), AVDD is pm8150l-l1 (RPMh ldoc1, 1.8 V).
+ *
+ * SE17's FIFO interface is hardware-disabled: GENI_IF_DISABLE_RO (0x64)
+ * reads 0x64 and TWRP's i2c-geni log says "i2c in GSI ONLY mode". Android
+ * drives this bus through GPI DMA; porting the GSI/DMA engine to XNU for
+ * one slow I2C bus is not practical, so this driver bit-bangs the same two
+ * open-drain pins as GPIO. Commands and events follow Xiaomi's cepheus
+ * fts_521 driver (the newer ST FTS API), not the mainline stmfts command
+ * set: 0x86 reads an event, 0xa0/00/01 enables active scanning, 0xa6/00/00
+ * reads the automatically loaded system-info frame, and event 0x03 means
+ * controller ready after a reset. Reset is active low as in that driver
+ * (low 10 ms, then high), and both reset and IRQ use the DT active
+ * pull-up/8 mA state.
+ *
+ * The chip carries its own firmware (aboot/TWRP report FW VER 0060 without
+ * an update), so only a hardware reset, the controller-ready event and
+ * sense-on are needed. Call once after the scheduler is running; all work
+ * runs on one thread.
+ *
+ * Boot-args: cepheustouch=0 off, cepheustouchdelay=N start after N s,
+ * cepheustouchlog=1 log every event.
+ * Disabled by default until the bit-banged transport is verified.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include <mach/mach_time.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern kern_return_t thread_terminate(thread_t);
+extern int sweet_rpmh_vreg_enable(const char *res, unsigned mv);
+extern void sweet_hid_touch(int finger, int down, int x, int y);
+void sweet_fts_init(void);
+
+#define FTS_TLMM_SOUTH_PA 0x03d00000u   /* SDA 55 / SCL 56 / IRQ 122 */
+#define FTS_TLMM_NORTH_PA 0x03900000u   /* reset 12, VDDIO enable 84 */
+#define FTS_GPIO_CFG(n)  ((uint32_t)(n) * 0x1000u)
+#define FTS_GPIO_IO(n)   (FTS_GPIO_CFG(n) + 4u)
+#define FTS_PIN_SDA      55
+#define FTS_PIN_SCL      56
+#define FTS_PIN_IRQ      122
+#define FTS_PIN_RESET    12
+#define FTS_PIN_VDDIO    84
+#define FTS_MAX          10u
+#define FTS_ADDR         0x49u
+#define FTS_RX_MAX       FTS_DATA_MAX
+
+/*
+ * mach_absolute_time() ticks at 19.2 MHz on SM8150 (UFS and USB divide by
+ * 19200 for milliseconds). 19 ticks is 0.99 us; the uncached GPIO writes
+ * in each edge add to the period, so the bus stays far below the chip's
+ * 400 kHz limit even if the timebase were different.
+ */
+#define FTS_TICKS_PER_US 19u
+#define FTS_SETUP_US     4u
+#define FTS_LOW_US       2u
+#define FTS_HIGH_US      3u
+
+/* ST FTS commands, as used by Xiaomi's cepheus fts_521 driver. */
+#define FTS_CMD_FIFO_READ    0x86u  /* one event; byte 7 = remaining count */
+#define FTS_CMD_SCAN_MODE    0xa0u
+#define FTS_CMD_FRAMEBUFFER  0xa6u
+#define FTS_SCAN_ACTIVE      0x00u
+#define FTS_SENSE_ON         0x01u
+#define FTS_SYSINFO_SIZE     208u
+#define FTS_SYSINFO_SIG      0xa5u
+#define FTS_SYSINFO_LOAD_ID  0x01u
+
+/*
+ * ST FTS events (ftsSoftware.h): event[0] is the event id, event[1] holds
+ * the touch id in the high nibble and the type in the low nibble.
+ */
+#define FTS_EVT_READY        0x03u  /* controller ready after a reset */
+#define FTS_EVT_ENTER        0x13u
+#define FTS_EVT_MOTION       0x23u
+#define FTS_EVT_LEAVE        0x33u
+#define FTS_EVT_STATUS       0x43u
+#define FTS_EVT_ERROR        0xf3u
+#define FTS_TOUCH_FINGER     0x01u
+#define FTS_TOUCH_GLOVE      0x02u
+#define FTS_TOUCH_STYLUS     0x03u
+#define FTS_TOUCH_PALM       0x04u
+#define FTS_TOUCH_HOVER      0x05u
+#define FTS_EVENT_SIZE       8u
+#define FTS_STACK_DEPTH      32u
+#define FTS_DATA_MAX         (FTS_EVENT_SIZE * FTS_STACK_DEPTH)
+
+static struct {
+	vm_offset_t gpio_n, gpio_s;
+	bool started, dead;
+	int log;
+	unsigned sda, scl;
+	uint32_t active;
+	int x[FTS_MAX], y[FTS_MAX];
+} ft;
+static int fts_sleep_chan;
+
+static uint32_t
+fts_rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+fts_wr(vm_offset_t base, uint32_t off, uint32_t val)
+{
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(base + off) = val;
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
+static void
+fts_udelay(unsigned us)
+{
+	uint64_t deadline = mach_absolute_time() + (uint64_t)us * FTS_TICKS_PER_US;
+	while (mach_absolute_time() < deadline) {
+		__asm__ volatile("yield" ::: "memory");
+	}
+}
+
+static void
+fts_wait(unsigned ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&fts_sleep_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+/* TLMM: [1:0] pull, [5:2] function, [8:6] drive (mA/2 - 1), [9] output. */
+static void
+fts_gpio(vm_offset_t base, unsigned pin, unsigned mux, unsigned pull,
+    unsigned drive, bool out, bool high)
+{
+	uint32_t off = FTS_GPIO_CFG(pin);
+	if (out) {
+		/* Set the output latch before enabling output, avoiding a glitch. */
+		fts_wr(base, FTS_GPIO_IO(pin),
+		    (fts_rd(base, FTS_GPIO_IO(pin)) & ~2u) | (high ? 2u : 0u));
+	}
+	uint32_t cfg = fts_rd(base, off) & ~0x3ffu;
+	cfg |= (mux << 2) | pull | (drive << 6) | (out ? 0x200u : 0u);
+	fts_wr(base, off, cfg);
+}
+
+/*
+ * The bus is open-drain: a line is driven low by enabling the output with a
+ * zero latch, and released by switching back to input (the board pull-ups
+ * and the internal pull-up then take it high). SDA is never driven high.
+ */
+static void
+fts_sda_low(void)
+{
+	fts_gpio(ft.gpio_s, ft.sda, 0, 3, 0, true, false);
+}
+
+static void
+fts_sda_release(void)
+{
+	fts_gpio(ft.gpio_s, ft.sda, 0, 3, 0, false, false);
+}
+
+static void
+fts_scl_low(void)
+{
+	fts_gpio(ft.gpio_s, ft.scl, 0, 3, 0, true, false);
+}
+
+static bool
+fts_sda_read(void)
+{
+	return (fts_rd(ft.gpio_s, FTS_GPIO_IO(ft.sda)) & 1u) != 0;
+}
+
+static bool
+fts_scl_read(void)
+{
+	return (fts_rd(ft.gpio_s, FTS_GPIO_IO(ft.scl)) & 1u) != 0;
+}
+
+/* Release SCL and wait through any slave clock stretching (10 ms max). */
+static bool
+fts_scl_raise(void)
+{
+	fts_gpio(ft.gpio_s, ft.scl, 0, 3, 0, false, false);
+	for (unsigned i = 0; i < 10000; ++i) {
+		if (fts_scl_read()) {
+			return true;
+		}
+		fts_udelay(1);
+	}
+	return false;
+}
+
+/* START, or repeated START when both lines were left released. */
+static bool
+fts_bb_start(void)
+{
+	fts_sda_release();
+	fts_udelay(1);
+	if (!fts_scl_raise()) {
+		return false;
+	}
+	fts_udelay(FTS_SETUP_US);
+	fts_sda_low();
+	fts_udelay(FTS_SETUP_US);
+	fts_scl_low();
+	fts_udelay(FTS_LOW_US);
+	return true;
+}
+
+/* STOP; the caller leaves SCL low after every byte, so SDA may go low first. */
+static bool
+fts_bb_stop(void)
+{
+	fts_sda_low();
+	fts_udelay(FTS_LOW_US);
+	bool ok = fts_scl_raise();
+	fts_udelay(FTS_SETUP_US);
+	fts_sda_release();
+	fts_udelay(FTS_SETUP_US);
+	return ok;
+}
+
+static bool
+fts_bb_write_bit(bool one)
+{
+	if (one) {
+		fts_sda_release();
+	} else {
+		fts_sda_low();
+	}
+	fts_udelay(1);
+	if (!fts_scl_raise()) {
+		return false;
+	}
+	fts_udelay(FTS_HIGH_US);
+	fts_scl_low();
+	fts_udelay(FTS_LOW_US);
+	return true;
+}
+
+static bool
+fts_bb_read_bit(bool *one)
+{
+	fts_sda_release();
+	fts_udelay(1);
+	if (!fts_scl_raise()) {
+		return false;
+	}
+	fts_udelay(FTS_HIGH_US);
+	*one = fts_sda_read();
+	fts_scl_low();
+	fts_udelay(FTS_LOW_US);
+	return true;
+}
+
+/* Write one byte and the ninth (ACK) clock: 0 = ACK, ENXIO = NACK. */
+static int
+fts_bb_write_byte(uint8_t byte)
+{
+	for (unsigned i = 0; i < 8; ++i) {
+		if (!fts_bb_write_bit((byte & 0x80u) != 0)) {
+			return EIO;
+		}
+		byte <<= 1;
+	}
+	fts_sda_release();
+	fts_udelay(1);
+	if (!fts_scl_raise()) {
+		return EIO;
+	}
+	fts_udelay(FTS_HIGH_US);
+	bool ack = !fts_sda_read();
+	fts_scl_low();
+	fts_udelay(FTS_LOW_US);
+	return ack ? 0 : ENXIO;
+}
+
+/* Read one byte and drive ACK (or NACK on the last byte). */
+static int
+fts_bb_read_byte(uint8_t *out, bool last)
+{
+	uint8_t byte = 0;
+	for (unsigned i = 0; i < 8; ++i) {
+		bool one;
+		if (!fts_bb_read_bit(&one)) {
+			return EIO;
+		}
+		byte = (uint8_t)((byte << 1) | (one ? 1u : 0u));
+	}
+	if (last) {
+		fts_sda_release(); /* NACK: let go before the STOP. */
+	} else {
+		fts_sda_low();     /* ACK. */
+	}
+	fts_udelay(1);
+	if (!fts_scl_raise()) {
+		return EIO;
+	}
+	fts_udelay(FTS_HIGH_US);
+	fts_scl_low();
+	fts_udelay(FTS_LOW_US);
+	fts_sda_release();
+	*out = byte;
+	return 0;
+}
+
+/*
+ * Clock a slave that was interrupted mid-byte out of the way, then send a
+ * STOP. A reset pulse normally frees the bus first; this also covers a
+ * previous kernel or ABL leaving the SE mid-transaction.
+ */
+static bool
+fts_bb_recover(void)
+{
+	fts_sda_release();
+	fts_udelay(10);
+	if (!fts_scl_raise()) {
+		return false;
+	}
+	for (unsigned i = 0; i < 9 && !fts_sda_read(); ++i) {
+		fts_scl_low();
+		fts_udelay(FTS_LOW_US);
+		if (!fts_scl_raise()) {
+			return false;
+		}
+		fts_udelay(FTS_HIGH_US);
+	}
+	fts_scl_low();
+	fts_udelay(FTS_LOW_US);
+	fts_sda_low();
+	fts_udelay(FTS_SETUP_US);
+	bool ok = fts_scl_raise();
+	fts_udelay(FTS_SETUP_US);
+	fts_sda_release();
+	fts_udelay(FTS_SETUP_US);
+	return ok;
+}
+
+/* Write n command bytes, then STOP (one i2c_msg). */
+static int
+fts_i2c_write_buf(const uint8_t *buf, unsigned len)
+{
+	if (len == 0) {
+		return EINVAL;
+	}
+	if (!fts_bb_start()) {
+		return ETIMEDOUT;
+	}
+	int err = fts_bb_write_byte((uint8_t)(FTS_ADDR << 1));
+	for (unsigned i = 0; !err && i < len; ++i) {
+		err = fts_bb_write_byte(buf[i]);
+	}
+	if (!fts_bb_stop() && !err) {
+		err = EIO;
+	}
+	return err;
+}
+
+/* Write n command bytes, then repeated START and read (two i2c_msg). */
+static int
+fts_i2c_read_buf(const uint8_t *cmd, unsigned cmdlen, uint8_t *buf,
+    unsigned len)
+{
+	if (cmdlen == 0 || len > FTS_RX_MAX) {
+		return EINVAL;
+	}
+	if (!fts_bb_start()) {
+		return ETIMEDOUT;
+	}
+	int err = fts_bb_write_byte((uint8_t)(FTS_ADDR << 1));
+	for (unsigned i = 0; !err && i < cmdlen; ++i) {
+		err = fts_bb_write_byte(cmd[i]);
+	}
+	if (!err && !fts_bb_start()) {
+		err = ETIMEDOUT;
+	}
+	if (!err) {
+		err = fts_bb_write_byte((uint8_t)((FTS_ADDR << 1) | 1u));
+	}
+	for (unsigned i = 0; !err && i < len; ++i) {
+		err = fts_bb_read_byte(&buf[i], i + 1u == len);
+	}
+	if (!fts_bb_stop() && !err) {
+		err = EIO;
+	}
+	return err;
+}
+
+static int
+fts_fifo_read(uint8_t *buf, unsigned len)
+{
+	uint8_t cmd = FTS_CMD_FIFO_READ;
+	return fts_i2c_read_buf(&cmd, 1, buf, len);
+}
+
+/*
+ * Read one FIFO event plus, if byte 7 of the first event reports more
+ * pending events, the rest of the stack in one transfer (fts_event_handler
+ * in the cepheus driver does the same). Returns the number of events.
+ */
+static int
+fts_read_events(uint8_t *buf, unsigned *count)
+{
+	int err = fts_fifo_read(buf, FTS_EVENT_SIZE);
+	if (err) {
+		return err;
+	}
+	unsigned more = buf[7] & 0x1fu;
+	if (more > FTS_STACK_DEPTH - 1u) {
+		more = FTS_STACK_DEPTH - 1u;
+	}
+	if (more) {
+		err = fts_fifo_read(buf + FTS_EVENT_SIZE,
+		    more * FTS_EVENT_SIZE);
+		if (err) {
+			return err;
+		}
+	}
+	*count = more + 1u;
+	return 0;
+}
+
+/* 0xa0/00/01: active scan mode, MT sensing on. */
+static int
+fts_sense_on(void)
+{
+	const uint8_t cmd[3] = { FTS_CMD_SCAN_MODE, FTS_SCAN_ACTIVE, FTS_SENSE_ON };
+	return fts_i2c_write_buf(cmd, sizeof(cmd));
+}
+
+/* 0xa6/00/00 loads the system-info frame into the framebuffer. */
+static int
+fts_read_sysinfo(uint8_t *buf)
+{
+	const uint8_t cmd[3] = { FTS_CMD_FRAMEBUFFER, 0x00, 0x00 };
+	return fts_i2c_read_buf(cmd, sizeof(cmd), buf, FTS_SYSINFO_SIZE);
+}
+
+/*
+ * qup17 sleep state: function 0 (GPIO), pull-up, 2 mA. IRQ and reset use
+ * the live DT active state (pull-up, 8 mA): reset is active low, as in the
+ * downstream cepheus driver, and is held asserted from before power-up.
+ */
+static void
+fts_pins(void)
+{
+	fts_gpio(ft.gpio_s, ft.sda, 0, 3, 0, false, false);
+	fts_gpio(ft.gpio_s, ft.scl, 0, 3, 0, false, false);
+	fts_gpio(ft.gpio_s, FTS_PIN_IRQ, 0, 3, 3, false, false);
+	fts_gpio(ft.gpio_n, FTS_PIN_RESET, 0, 3, 3, true, false);
+}
+
+static void
+fts_reset(void)
+{
+	/*
+	 * fts_system_reset in Xiaomi's cepheus driver drives reset low
+	 * (asserted) for 10 ms, then high and waits for the controller-ready
+	 * event. The DT flag is not a polarity: the driver uses raw GPIO
+	 * values, so 0 = low = reset and 1 = high = run.
+	 */
+	fts_gpio(ft.gpio_n, FTS_PIN_RESET, 0, 3, 3, true, false);
+	fts_wait(10);
+	fts_gpio(ft.gpio_n, FTS_PIN_RESET, 0, 3, 3, true, true);
+	fts_wait(50);
+}
+
+static int fts_wait_ready(unsigned ms);
+static void fts_release_all(void);
+
+/*
+ * Hardware reset, then wait for the controller-ready event. A wrong SDA/SCL
+ * order leaves the chip without a valid address, so every transfer NACKs; a
+ * reset between attempts leaves the chip in a known state.
+ */
+static int
+fts_probe(void)
+{
+	int err = ETIMEDOUT;
+	for (unsigned attempt = 0; attempt < 3; ++attempt) {
+		fts_reset();
+		if (!fts_bb_recover()) {
+			printf("SWEET FTS: SCL stuck low after reset\n");
+			fts_wait(50);
+			continue;
+		}
+		err = fts_wait_ready(500);
+		printf("SWEET FTS: ready try %u sda=%u scl=%u idle=%u/%u err=%d\n",
+		    attempt + 1u, ft.sda, ft.scl, fts_sda_read(), fts_scl_read(), err);
+		if (!err) {
+			return 0;
+		}
+		fts_wait(20);
+	}
+	return err;
+}
+
+static void
+fts_log_event(const char *what, const uint8_t ev[FTS_EVENT_SIZE])
+{
+	printf("SWEET FTS: %s %02x %02x %02x %02x %02x %02x %02x %02x\n", what,
+	    ev[0], ev[1], ev[2], ev[3], ev[4], ev[5], ev[6], ev[7]);
+}
+
+/*
+ * Poll the FIFO for the controller-ready event (0x03 after a hardware reset;
+ * the chip also sends it if it reboots). Empty reads keep the loop going, and
+ * a NACK right after reset is normal while the chip is still booting.
+ */
+static int
+fts_wait_ready(unsigned ms)
+{
+	uint8_t ev[FTS_EVENT_SIZE];
+	for (unsigned t = 0; t < ms; t += 5) {
+		int err = fts_fifo_read(ev, sizeof(ev));
+		if (!err) {
+			if (ev[0] == FTS_EVT_READY) {
+				return 0;
+			}
+			if (ev[0] != 0x00u) {
+				fts_log_event("pre-ready", ev);
+			}
+		} else if (ft.log || t == 0) {
+			printf("SWEET FTS: ready poll err=%d\n", err);
+		}
+		fts_wait(5);
+	}
+	return ETIMEDOUT;
+}
+
+/*
+ * Event layout from Xiaomi's cepheus driver: event[0] is the event id,
+ * event[1] holds the touch id (high nibble) and touch type (low nibble);
+ * for enter/motion, x is in event[2]/event[3][3:0] and y in event[3][7:4]/
+ * event[4], both 12-bit panel pixels.
+ */
+static void
+fts_handle(const uint8_t ev[FTS_EVENT_SIZE])
+{
+	unsigned id = ev[1] >> 4, type = ev[1] & 0x0fu;
+
+	switch (ev[0]) {
+	case FTS_EVT_ENTER:
+	case FTS_EVT_MOTION: {
+		if (id >= FTS_MAX) {
+			fts_log_event("bad id", ev);
+			return;
+		}
+		if (type != FTS_TOUCH_FINGER && type != FTS_TOUCH_GLOVE &&
+		    type != FTS_TOUCH_PALM) {
+			if (ft.log) {
+				fts_log_event("skip type", ev);
+			}
+			return;
+		}
+		int x = (int)(((unsigned)ev[3] & 0x0fu) << 8) | ev[2];
+		int y = ((int)ev[4] << 4) | ((ev[3] & 0xf0u) >> 4);
+		if (x >= 1080) {
+			x = 1079;
+		}
+		if (y >= 2340) {
+			y = 2339;
+		}
+		if (ft.log) {
+			fts_log_event(ev[0] == FTS_EVT_ENTER ? "enter" : "motion",
+			    ev);
+		}
+		ft.active |= 1u << id;
+		ft.x[id] = x;
+		ft.y[id] = y;
+		sweet_hid_touch((int)id, 1, x, y);
+		break;
+	}
+	case FTS_EVT_LEAVE:
+		if (id < FTS_MAX && (ft.active & (1u << id))) {
+			if (ft.log) {
+				fts_log_event("leave", ev);
+			}
+			ft.active &= ~(1u << id);
+			sweet_hid_touch((int)id, 0, ft.x[id], ft.y[id]);
+		}
+		break;
+	case FTS_EVT_READY:
+		/* Unexpected reset while running: drop touches and sense on. */
+		if (ft.log) {
+			fts_log_event("ready", ev);
+		}
+		fts_release_all();
+		(void)fts_sense_on();
+		break;
+	case FTS_EVT_ERROR:
+		fts_log_event("error", ev);
+		break;
+	default:
+		if (ft.log) {
+			fts_log_event("other", ev);
+		}
+		break;
+	}
+}
+
+static void
+fts_release_all(void)
+{
+	for (unsigned id = 0; id < FTS_MAX; ++id) {
+		if (ft.active & (1u << id)) {
+			sweet_hid_touch((int)id, 0, ft.x[id], ft.y[id]);
+		}
+	}
+	ft.active = 0;
+}
+
+static void
+fts_thread(void *arg, wait_result_t result)
+{
+	unsigned delay_s = 20;
+	uint8_t buf[FTS_DATA_MAX];
+	uint8_t si[FTS_SYSINFO_SIZE];
+	(void)arg;
+	(void)result;
+	(void)PE_parse_boot_argn("cepheustouchdelay", &delay_s, sizeof(delay_s));
+	printf("SWEET FTS: starting in %u s\n", delay_s);
+	fts_wait(delay_s * 1000u);
+	ft.gpio_n = ml_io_map(FTS_TLMM_NORTH_PA, 0x81000);
+	ft.gpio_s = ml_io_map(FTS_TLMM_SOUTH_PA, 0x81000);
+	if (!ft.gpio_n || !ft.gpio_s) {
+		printf("SWEET FTS: MMIO mapping failed\n");
+		goto out;
+	}
+	printf("SWEET FTS: TLMM reset=%#x/%#x vddio=%#x/%#x irq=%#x/%#x\n",
+	    fts_rd(ft.gpio_n, FTS_GPIO_CFG(FTS_PIN_RESET)),
+	    fts_rd(ft.gpio_n, FTS_GPIO_IO(FTS_PIN_RESET)),
+	    fts_rd(ft.gpio_n, FTS_GPIO_CFG(FTS_PIN_VDDIO)),
+	    fts_rd(ft.gpio_n, FTS_GPIO_IO(FTS_PIN_VDDIO)),
+	    fts_rd(ft.gpio_s, FTS_GPIO_CFG(FTS_PIN_IRQ)),
+	    fts_rd(ft.gpio_s, FTS_GPIO_IO(FTS_PIN_IRQ)));
+	/* Take the qup17 pins away from the SE before the chip is reset. */
+	ft.sda = FTS_PIN_SDA;
+	ft.scl = FTS_PIN_SCL;
+	fts_pins();
+	/* VDDIO first (fixed regulator on GPIO 84, 4 ms startup delay). */
+	fts_gpio(ft.gpio_n, FTS_PIN_VDDIO, 0, 0, 0, true, true);
+	fts_wait(4);
+	/* AVDD is PM8150L L1 (RPMh ldoc1). Keep going if the rail is already on. */
+	int perr = sweet_rpmh_vreg_enable("ldoc1", 1800);
+	printf("SWEET FTS: vddio gpio 84 high, avdd ldoc1 err=%d\n", perr);
+	fts_wait(20);
+	/*
+	 * Board notes say SDA=55/SCL=56; if that order is wrong the chip never
+	 * ACKs its address, so try the swapped pair once before giving up. A
+	 * reset between attempts leaves the chip in a known state.
+	 */
+	int err = ETIMEDOUT;
+	for (unsigned m = 0; m < 2; ++m) {
+		ft.sda = m ? FTS_PIN_SCL : FTS_PIN_SDA;
+		ft.scl = m ? FTS_PIN_SDA : FTS_PIN_SCL;
+		fts_pins();
+		err = fts_probe();
+		if (!err) {
+			break;
+		}
+		printf("SWEET FTS: no answer with this pin order\n");
+	}
+	if (err) {
+		printf("SWEET FTS: touch controller did not answer; stopping\n");
+		goto out;
+	}
+	printf("SWEET FTS: bus sda=%u scl=%u\n", ft.sda, ft.scl);
+
+	/*
+	 * The chip loads its system info at reset. The header proves that the
+	 * framebuffer command and the protocol are right; touch only needs the
+	 * scan-mode command below, so a mismatch is logged, not fatal.
+	 */
+	err = fts_read_sysinfo(si);
+	if (!err && si[0] == FTS_SYSINFO_SIG && si[1] == FTS_SYSINFO_LOAD_ID) {
+		unsigned chip0 = si[10] | ((unsigned)si[11] << 8);
+		unsigned chip1 = si[14] | ((unsigned)si[15] << 8);
+		unsigned fw = si[16] | ((unsigned)si[17] << 8);
+		printf("SWEET FTS: sysinfo fw=%04x chip0=%04x chip1=%04x\n",
+		    fw, chip0, chip1);
+	} else {
+		printf("SWEET FTS: sysinfo err=%d sig=%02x id=%02x\n",
+		    err, si[0], si[1]);
+	}
+
+	err = fts_sense_on();
+	printf("SWEET FTS: sense on err=%d; polling every 5 ms\n", err);
+	if (err) {
+		goto out;
+	}
+	unsigned errors = 0, ticks = 0;
+	while (!ft.dead) {
+		/* The IRQ line (active low) says events are pending; also read
+		 * every ~10 ms in case the line does not work as assumed. */
+		bool poll = (++ticks % 2u) == 0;
+		while ((poll || !(fts_rd(ft.gpio_s, FTS_GPIO_IO(FTS_PIN_IRQ)) & 1u)) &&
+		    !ft.dead) {
+			poll = false;
+			unsigned count = 0;
+			if (fts_read_events(buf, &count)) {
+				if ((errors++ % 100u) == 0) {
+					printf("SWEET FTS: read error (%u)\n", errors);
+				}
+				if (errors == 10) {
+					fts_release_all();
+					if (!fts_bb_recover()) {
+						printf("SWEET FTS: bus stuck low; stopping\n");
+						ft.dead = true;
+					}
+				}
+				break;
+			}
+			errors = 0;
+			bool any = false;
+			for (unsigned i = 0; i < count; ++i) {
+				const uint8_t *ev = buf + i * FTS_EVENT_SIZE;
+				if (ev[0] == 0x00u) {
+					break;
+				}
+				any = true;
+				fts_handle(ev);
+			}
+			if (!any) {
+				break;
+			}
+		}
+		fts_wait(5);
+	}
+	fts_release_all();
+out:
+	printf("SWEET FTS: thread exits\n");
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+void
+sweet_fts_init(void)
+{
+	int enabled = 0;
+	thread_t thread;
+	if (ft.started) {
+		return;
+	}
+	ft.started = true;
+	(void)PE_parse_boot_argn("cepheustouch", &enabled, sizeof(enabled));
+	(void)PE_parse_boot_argn("cepheustouchlog", &ft.log, sizeof(ft.log));
+	if (!enabled) {
+		printf("SWEET FTS: disabled (cepheustouch=0)\n");
+		return;
+	}
+	kern_return_t kr = kernel_thread_start(fts_thread, NULL, &thread);
+	if (kr == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		printf("SWEET FTS: kernel_thread_start failed %d\n", kr);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
