@@ -0,0 +1,666 @@
+/*
+ * cepheus touch: ST FTS on the GENI I2C SE17 controller at 0xc80000, slave
+ * address 0x49. Live FDT: /soc/i2c@0xc80000/fts@49 (compatible "st,fts"),
+ * panel 1080x2340. Pins: SDA 55, SCL 56 (qup17, south tile), IRQ 122
+ * (south tile), reset 12 and VDDIO enable 84 (north tile). VDDIO is
+ * touch_vddio_vreg (fixed regulator on GPIO 84), AVDD is pm8150l-l1
+ * (RPMh ldoc1, 1.8 V). The chip carries its own firmware: the aboot/TWRP
+ * driver reports FW VER 0060 without an update, so only a system reset and
+ * sense-on are needed. Call once after the scheduler is running; all work
+ * runs on one thread.
+ *
+ * Boot-args: cepheustouch=0 off, cepheustouchdelay=N start after N s,
+ * cepheustouchlog=1 log every event.
+ * Disabled by default until the I2C transport is verified on hardware.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern kern_return_t thread_terminate(thread_t);
+extern int sweet_rpmh_vreg_enable(const char *res, unsigned mv);
+extern void sweet_hid_touch(int finger, int down, int x, int y);
+void sweet_fts_init(void);
+
+#define FTS_SE_PA        0x00c80000u    /* QUPv3 wrapper 2, SE17 */
+#define FTS_WRAPPER_PA   0x00cc0000u    /* QUPv3 wrapper 2 registers */
+#define FTS_GCC_PA       0x00100000u
+#define FTS_TLMM_SOUTH_PA 0x03d00000u   /* SDA 55/SCL 56, IRQ 122 */
+#define FTS_TLMM_NORTH_PA 0x03900000u   /* reset 12, VDDIO enable 84 */
+#define FTS_GCC_VOTE     0x52014u       /* APCS_CLOCK_BRANCH_ENA_VOTE_2 */
+/* wrapper 2: s_ahb (1), m_ahb (2), s1 branch (5): gcc-sm8150.c */
+#define FTS_GCC_BITS     ((1u << 1) | (1u << 2) | (1u << 5))
+#define FTS_RCG          0x1e278u       /* gcc_qupv3_wrap2_s1_clk_src */
+#define FTS_RCG_HALT     0x1e274u       /* gcc_qupv3_wrap2_s1_clk halt */
+#define FTS_GPIO_CFG(n)  ((uint32_t)(n) * 0x1000u)
+#define FTS_GPIO_IO(n)   (FTS_GPIO_CFG(n) + 4u)
+#define FTS_PIN_SDA      55
+#define FTS_PIN_SCL      56
+#define FTS_PIN_IRQ      122
+#define FTS_PIN_RESET    12
+#define FTS_PIN_VDDIO    84
+#define FTS_MAX          10u
+#define FTS_ADDR         0x49u
+
+#define SE_STATUS        0x040u
+#define SE_MCLK          0x048u
+#define SE_FW            0x068u
+#define SE_CLK_SEL       0x07cu
+#define SE_DMA           0x258u
+#define SE_TX_LEN        0x26cu
+#define SE_RX_LEN        0x270u
+#define SE_SCL           0x278u
+#define SE_CMD           0x600u
+#define SE_CTRL          0x604u
+#define SE_IRQ           0x610u
+#define SE_IRQ_EN        0x614u
+#define SE_IRQ_CLR       0x618u
+#define SE_TX            0x700u
+#define SE_RX            0x780u
+#define SE_TX_COUNT      0x800u
+#define SE_RX_COUNT      0x804u
+#define SE_HW_TX         0xe24u
+#define SE_HW_RX         0xe28u
+#define SE_DONE          (1u << 0)
+#define SE_NACK          (1u << 10)
+#define SE_ERRORS        (0x0eu | (1u << 9) | (1u << 10) | (1u << 12) | \
+                          (1u << 13) | (3u << 24) | (3u << 28))
+#define SE_EVENTS        (SE_DONE | SE_ERRORS | (1u << 5) | (1u << 26) | \
+                          (1u << 27) | (1u << 30))
+#define SE_TX_WM_IRQ     (1u << 30)
+#define SE_RX_WM_IRQ     (1u << 26)
+#define SE_RX_LAST       (1u << 27)
+
+/* ST FTS commands (stmfts.c) */
+#define FTS_CMD_READ_INFO    0x80u
+#define FTS_CMD_READ_ALL     0x86u
+#define FTS_CMD_SLEEP_OUT    0x91u
+#define FTS_CMD_SENSE_ON     0x93u
+#define FTS_CMD_SYSTEM_RESET 0xa0u
+#define FTS_CMD_CLEAR_STACK  0xa1u
+#define FTS_CMD_FORCE_CAL    0xa2u
+
+/* ST FTS events: low nibble is the type, high nibble the touch id. */
+#define FTS_EVT_NONE         0x00u
+#define FTS_EVT_ENTER        0x03u
+#define FTS_EVT_LEAVE        0x04u
+#define FTS_EVT_MOTION       0x05u
+#define FTS_EVT_ERROR        0x0fu
+#define FTS_EVT_READY        0x10u
+#define FTS_EVT_SLEEP_READY  0x11u
+#define FTS_EVT_STATUS       0x16u
+#define FTS_EVENT_SIZE       8u
+#define FTS_STACK_DEPTH      32u
+#define FTS_DATA_MAX         (FTS_EVENT_SIZE * FTS_STACK_DEPTH)
+
+/* GENI FIFO message: TX at most 3 bytes, RX at most the 256-byte event stack. */
+#define FTS_TX_MAX           3u
+#define FTS_RX_MAX           FTS_DATA_MAX
+
+static struct {
+	vm_offset_t se, wrapper, gcc, gpio_n, gpio_s;
+	bool started, dead;
+	int log;
+	unsigned fifo_words;
+	uint32_t active;
+	int x[FTS_MAX], y[FTS_MAX];
+} ft;
+static int fts_sleep_chan;
+
+static uint32_t
+fts_rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+fts_wr(vm_offset_t base, uint32_t off, uint32_t val)
+{
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(base + off) = val;
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
+static void
+fts_wait(unsigned ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&fts_sleep_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static bool
+fts_wait_clear(vm_offset_t base, uint32_t off, uint32_t mask)
+{
+	for (unsigned i = 0; i < 5000; ++i) {
+		if (!(fts_rd(base, off) & mask)) {
+			return true;
+		}
+		delay(1);
+	}
+	return false;
+}
+
+/* TLMM: [1:0] pull, [5:2] function, [8:6] drive (mA/2 - 1), [9] output. */
+static void
+fts_gpio(vm_offset_t base, unsigned pin, unsigned mux, unsigned pull,
+    unsigned drive, bool out, bool high)
+{
+	uint32_t off = FTS_GPIO_CFG(pin);
+	if (out) {
+		/* Set the output latch before enabling output, avoiding a glitch. */
+		fts_wr(base, FTS_GPIO_IO(pin),
+		    (fts_rd(base, FTS_GPIO_IO(pin)) & ~2u) | (high ? 2u : 0u));
+	}
+	uint32_t cfg = fts_rd(base, off) & ~0x3ffu;
+	cfg |= (mux << 2) | pull | (drive << 6) | (out ? 0x200u : 0u);
+	fts_wr(base, off, cfg);
+}
+
+static bool
+fts_clocks(void)
+{
+	fts_wr(ft.gcc, FTS_GCC_VOTE, fts_rd(ft.gcc, FTS_GCC_VOTE) | FTS_GCC_BITS);
+	uint32_t cmd = fts_rd(ft.gcc, FTS_RCG), cfg = fts_rd(ft.gcc, FTS_RCG + 4u);
+	uint32_t dfs = fts_rd(ft.gcc, FTS_RCG + 0x14u);
+	printf("SWEET FTS: gcc vote=%#x rcg=%#x cfg=%#x dfs=%#x\n",
+	    fts_rd(ft.gcc, FTS_GCC_VOTE), cmd, cfg, dfs);
+	if (dfs & 1u) {
+		/* SE CLK_SEL 0 selects DFS level 0; it must be XO (19.2 MHz) / 1. */
+		cfg = fts_rd(ft.gcc, FTS_RCG + 0x1cu);
+		printf("SWEET FTS: DFS level0 cfg=%#x\n", cfg);
+		if ((cfg & 0x371fu) != 1u) {
+			printf("SWEET FTS: DFS level 0 is %#x, not XO/1; trying anyway\n", cfg);
+		}
+	} else {
+		/* XO parent 0, HID divider 1 => 19.2 MHz. No PLL or voltage change. */
+		cfg = (cfg & ~(0x371fu | (1u << 20))) | 1u;
+		fts_wr(ft.gcc, FTS_RCG + 4u, cfg);
+		fts_wr(ft.gcc, FTS_RCG, fts_rd(ft.gcc, FTS_RCG) | 1u);
+		if (!fts_wait_clear(ft.gcc, FTS_RCG, 1u)) {
+			printf("SWEET FTS: RCG update timeout\n");
+			return false;
+		}
+	}
+	const uint32_t branches[] = {0x1e004, 0x1e008, FTS_RCG_HALT};
+	for (unsigned i = 0; i < sizeof(branches) / sizeof(branches[0]); ++i) {
+		if (!fts_wait_clear(ft.gcc, branches[i], 1u << 31)) {
+			printf("SWEET FTS: GCC branch %#x halted (%#x)\n", branches[i],
+			    fts_rd(ft.gcc, branches[i]));
+			return false;
+		}
+	}
+	return true;
+}
+
+/* Drain all complete 32-bit words now in the RX FIFO. */
+static int
+fts_drain(uint8_t *rx, unsigned nr, unsigned *got)
+{
+	unsigned words = 0;
+	for (;;) {
+		uint32_t count = fts_rd(ft.se, SE_RX_COUNT) & 0x1ffffffu;
+		if (!count) {
+			return 0;
+		}
+		if (count > 64 || words + count > FTS_RX_MAX / 4u + 8u) {
+			return EIO;
+		}
+		words += count;
+		while (count--) {
+			uint32_t word = fts_rd(ft.se, SE_RX);
+			for (unsigned j = 0; j < 4 && *got < nr; ++j) {
+				rx[(*got)++] = (uint8_t)(word >> (8u * j));
+			}
+		}
+	}
+}
+
+/* Called only for a transfer started by this driver, including a stretched TX. */
+static void
+fts_abort(void)
+{
+	fts_wr(ft.se, SE_CTRL, 2); /* abort M command, release held bus */
+	bool done = false;
+	for (unsigned i = 0; i < 5000; ++i) {
+		if (fts_rd(ft.se, SE_IRQ) & (1u << 5)) {
+			done = true;
+			break;
+		}
+		delay(1);
+	}
+	if (!done || !fts_wait_clear(ft.se, SE_STATUS, 1u)) {
+		ft.dead = true;
+		printf("SWEET FTS: abort failed status=%#x irq=%#x; stopping\n",
+		    fts_rd(ft.se, SE_STATUS), fts_rd(ft.se, SE_IRQ));
+	}
+	/* Bound drain even if the hardware reports an impossible FIFO count. */
+	for (unsigned i = 0; i < 128 && (fts_rd(ft.se, SE_RX_COUNT) & 0x1ffffffu); ++i) {
+		(void)fts_rd(ft.se, SE_RX);
+	}
+	fts_wr(ft.se, SE_IRQ_CLR, 0xffffffffu);
+	if (fts_rd(ft.se, SE_TX_COUNT) & 0xfffffffu) {
+		ft.dead = true;
+		printf("SWEET FTS: TX FIFO not empty after abort; stopping\n");
+	}
+}
+
+/*
+ * One Linux-style FIFO message. STOP_STRETCH on the command write retains
+ * the bus for the repeated START that reads the answer.
+ */
+static int
+fts_msg(uint8_t addr, const uint8_t *tx, unsigned nt, uint8_t *rx,
+    unsigned nr, bool stretch)
+{
+	if (ft.dead || nt > FTS_TX_MAX || nr > FTS_RX_MAX || (nt && nr) || (!nt && !nr)) {
+		return EIO;
+	}
+	if (!fts_wait_clear(ft.se, SE_STATUS, 1u)) {
+		ft.dead = true; /* no other SE17 owner is supported */
+		return EBUSY;
+	}
+	fts_wr(ft.se, SE_IRQ_CLR, 0xffffffffu);
+	fts_wr(ft.se, nr ? SE_RX_LEN : SE_TX_LEN, nr ? nr : nt);
+	fts_wr(ft.se, SE_CMD, ((nr ? 2u : 1u) << 27) |
+	    ((uint32_t)addr << 9) | (stretch ? 4u : 0u));
+	unsigned sent = 0, got = 0;
+	int err = ETIMEDOUT;
+	for (unsigned i = 0; i < 20000; ++i) {
+		uint32_t irq = fts_rd(ft.se, SE_IRQ);
+		if (irq & SE_ERRORS) {
+			err = (irq & SE_NACK) ? ENXIO : EIO;
+			/* A completed NACK is normal while probing; wait for DONE and
+			 * leave a clean idle engine for the next message. */
+			for (unsigned j = 0; j < 5000 && !(irq & SE_DONE); ++j) {
+				delay(1);
+				irq = fts_rd(ft.se, SE_IRQ);
+			}
+			if ((irq & SE_DONE) && !(fts_rd(ft.se, SE_STATUS) & 1u) &&
+			    !(fts_rd(ft.se, SE_TX_COUNT) & 0xfffffffu) &&
+			    !(fts_rd(ft.se, SE_RX_COUNT) & 0x1ffffffu)) {
+				fts_wr(ft.se, SE_IRQ_CLR, irq);
+				return err;
+			}
+			break;
+		}
+		if (nt && !sent && (irq & SE_TX_WM_IRQ)) {
+			uint32_t word = 0;
+			for (unsigned j = 0; j < nt; ++j) {
+				word |= (uint32_t)tx[j] << (8u * j);
+			}
+			fts_wr(ft.se, SE_TX, word);
+			sent = nt;
+		}
+		int derr = fts_drain(rx, nr, &got);
+		if (derr) {
+			err = derr;
+			break;
+		}
+		/* Re-read: DONE and the last RX word can land after the drain. */
+		irq = fts_rd(ft.se, SE_IRQ);
+		if (irq & SE_DONE) {
+			/* The final word becomes visible with DONE; drain once more. */
+			derr = fts_drain(rx, nr, &got);
+			if (derr) {
+				err = derr;
+				break;
+			}
+			fts_wr(ft.se, SE_IRQ_CLR, irq);
+			if (got == nr && sent == nt) {
+				return 0;
+			}
+			err = EIO;
+			break;
+		}
+		/* Preserve DONE/errors if they arrive during this iteration. */
+		fts_wr(ft.se, SE_IRQ_CLR, irq & (SE_RX_WM_IRQ | SE_RX_LAST | SE_TX_WM_IRQ));
+		delay(1);
+	}
+	fts_abort();
+	return err;
+}
+
+static int
+fts_read(uint8_t cmd, uint8_t *buf, unsigned len)
+{
+	int err = fts_msg(FTS_ADDR, &cmd, 1, NULL, 0, true);
+	if (err) {
+		return err;
+	}
+	return fts_msg(FTS_ADDR, NULL, 0, buf, len, false);
+}
+
+static int
+fts_write(uint8_t cmd)
+{
+	return fts_msg(FTS_ADDR, &cmd, 1, NULL, 0, false);
+}
+
+static int
+fts_read_events(uint8_t *buf)
+{
+	return fts_read(FTS_CMD_READ_ALL, buf, FTS_DATA_MAX);
+}
+
+static bool
+fts_se_init(void)
+{
+	uint32_t fw = fts_rd(ft.se, SE_FW);
+	uint32_t tx = fts_rd(ft.se, SE_HW_TX), rx = fts_rd(ft.se, SE_HW_RX);
+	uint32_t ver = fts_rd(ft.wrapper, 0x4); /* QUPV3_HW_VER_REG */
+	unsigned major = (ver >> 28) & 0xfu, minor = (ver >> 16) & 0xfffu;
+	/* QUP >= 3.10 widens the FIFO depth field from 6 to 8 bits. */
+	bool wide = major > 3u || (major == 3u && minor >= 10u);
+	uint32_t tx_depth = (tx >> 16) & (wide ? 0xffu : 0x3fu);
+	uint32_t rx_depth = (rx >> 16) & (wide ? 0xffu : 0x3fu);
+	printf("SWEET FTS: se17 fw=%#x proto=%u status=%#x tx=%#x rx=%#x ios=%#x qup=%#x depth=%u/%u\n",
+	    fw, (fw >> 8) & 0xffu, fts_rd(ft.se, SE_STATUS), tx, rx,
+	    fts_rd(ft.se, 0x908), ver, tx_depth, rx_depth);
+	/* Protocol 3 = I2C; 32-bit FIFO words. */
+	if (((fw >> 8) & 0xffu) != 3u || (fts_rd(ft.se, 0x64) & 1u) ||
+	    ((tx >> 24) & 0x3fu) != 32u || ((rx >> 24) & 0x3fu) != 32u) {
+		printf("SWEET FTS: need ABL-loaded I2C firmware and 32-bit FIFOs; stopping\n");
+		return false;
+	}
+	/* The version may be unreadable; a zero depth then means the other layout. */
+	if (!tx_depth) {
+		tx_depth = (tx >> 16) & 0xffu;
+	}
+	if (!rx_depth) {
+		rx_depth = (rx >> 16) & 0xffu;
+	}
+	if (tx_depth < 2u || rx_depth < 2u) {
+		printf("SWEET FTS: FIFO depth %u/%u unusable; assuming 2\n", tx_depth, rx_depth);
+		tx_depth = tx_depth < 2u ? 2u : tx_depth;
+		rx_depth = rx_depth < 2u ? 2u : rx_depth;
+	}
+	if (fts_rd(ft.se, SE_STATUS) & 0x1001u) {
+		printf("SWEET FTS: SE17 already busy; stopping\n");
+		return false;
+	}
+	ft.fifo_words = tx_depth < rx_depth ? tx_depth : rx_depth;
+	/* geni_se_init + FIFO mode, polled (no GSI, no IRQ routing). */
+	fts_wr(ft.se, 0xe18, 0); /* no GSI events */
+	fts_wr(ft.se, 0xe1c, 0); /* mask external IRQ routing; poll local status */
+	fts_wr(ft.se, 0x644, 0);
+	fts_wr(ft.se, SE_IRQ_CLR, 0xffffffffu);
+	fts_wr(ft.se, 0x648, 0xffffffffu);
+	fts_wr(ft.se, SE_DMA, 0);
+	fts_wr(ft.se, 0x28, fts_rd(ft.se, 0x28) | 0x7fu);
+	fts_wr(ft.se, 0xe30, fts_rd(ft.se, 0xe30) | 0x0fu);
+	fts_wr(ft.se, 0x24, 0x7f);
+	fts_wr(ft.se, 0x20, 1);
+	fts_wr(ft.se, SE_CLK_SEL, 0);
+	fts_wr(ft.se, SE_MCLK, (2u << 4) | 1u); /* 19.2 MHz / 2 for 400 kHz */
+	fts_wr(ft.se, SE_SCL, (5u << 20) | (11u << 10) | 22u);
+	/* Four 8-bit bytes per 32-bit word, LSB byte first (Linux packing). */
+	fts_wr(ft.se, 0x254, 0);
+	fts_wr(ft.se, 0x260, 0x0004380eu);
+	fts_wr(ft.se, 0x264, 0x000c3e0eu);
+	fts_wr(ft.se, 0x284, 0x0004380eu);
+	fts_wr(ft.se, 0x288, 0x000c3e0eu);
+	fts_wr(ft.se, 0x80c, 1);
+	fts_wr(ft.se, 0x810, 0);
+	fts_wr(ft.se, 0x814, ft.fifo_words - 1u);
+	fts_wr(ft.se, SE_IRQ_EN, SE_EVENTS);
+	if ((fts_rd(ft.se, SE_TX_COUNT) & 0xfffffffu) ||
+	    (fts_rd(ft.se, SE_RX_COUNT) & 0x1ffffffu)) {
+		printf("SWEET FTS: inherited FIFO data; stopping\n");
+		return false;
+	}
+	return true;
+}
+
+static void
+fts_log_event(const char *what, const uint8_t ev[FTS_EVENT_SIZE])
+{
+	printf("SWEET FTS: %s %02x %02x %02x %02x %02x %02x %02x %02x\n", what,
+	    ev[0], ev[1], ev[2], ev[3], ev[4], ev[5], ev[6], ev[7]);
+}
+
+/*
+ * Read the whole 32-event stack and look for the controller-ready event a
+ * command produces (0x10 reset, 0x11 sleep out, 0x16 status). Other events
+ * are logged: before sense-on there should be none.
+ */
+static int
+fts_wait_ready(unsigned ms, uint8_t want)
+{
+	uint8_t buf[FTS_DATA_MAX];
+	for (unsigned t = 0; t < ms; t += 5) {
+		int err = fts_read_events(buf);
+		if (err) {
+			return err;
+		}
+		for (unsigned i = 0; i < FTS_STACK_DEPTH; ++i) {
+			const uint8_t *ev = buf + i * FTS_EVENT_SIZE;
+			if (ev[0] == FTS_EVT_NONE) {
+				break;
+			}
+			if (ev[0] == FTS_EVT_READY || ev[0] == FTS_EVT_SLEEP_READY ||
+			    ev[0] == FTS_EVT_STATUS) {
+				if (ft.log) {
+					fts_log_event("ready", ev);
+				}
+				if (!want || ev[0] == want || ev[0] == FTS_EVT_STATUS) {
+					return 0;
+				}
+			} else {
+				fts_log_event("init event", ev);
+			}
+		}
+		fts_wait(5);
+	}
+	return ETIMEDOUT;
+}
+
+static void
+fts_handle(const uint8_t ev[FTS_EVENT_SIZE])
+{
+	unsigned type = ev[0] & 0x0fu, id = ev[0] >> 4;
+	if (id >= FTS_MAX) {
+		if (ft.log) {
+			fts_log_event("bad id", ev);
+		}
+		return;
+	}
+	int x = (int)(ev[1] | ((ev[2] & 0x0fu) << 8));
+	int y = (int)((ev[2] >> 4) | (ev[3] << 4));
+	if (ft.log) {
+		fts_log_event("touch", ev);
+	}
+	switch (type) {
+	case FTS_EVT_ENTER:
+	case FTS_EVT_MOTION:
+		ft.active |= 1u << id;
+		ft.x[id] = x;
+		ft.y[id] = y;
+		sweet_hid_touch((int)id, 1, x, y);
+		break;
+	case FTS_EVT_LEAVE:
+		if (ft.active & (1u << id)) {
+			ft.active &= ~(1u << id);
+			sweet_hid_touch((int)id, 0, ft.x[id], ft.y[id]);
+		}
+		break;
+	case FTS_EVT_ERROR:
+		fts_log_event("error", ev);
+		break;
+	default:
+		if (ft.log) {
+			fts_log_event("other", ev);
+		}
+		break;
+	}
+}
+
+static void
+fts_release_all(void)
+{
+	for (unsigned id = 0; id < FTS_MAX; ++id) {
+		if (ft.active & (1u << id)) {
+			sweet_hid_touch((int)id, 0, ft.x[id], ft.y[id]);
+		}
+	}
+	ft.active = 0;
+}
+
+static void
+fts_thread(void *arg, wait_result_t result)
+{
+	unsigned delay_s = 20;
+	uint8_t buf[FTS_DATA_MAX];
+	(void)arg;
+	(void)result;
+	(void)PE_parse_boot_argn("cepheustouchdelay", &delay_s, sizeof(delay_s));
+	printf("SWEET FTS: starting in %u s\n", delay_s);
+	fts_wait(delay_s * 1000u);
+	ft.gcc = ml_io_map(FTS_GCC_PA, 0x60000);
+	ft.gpio_n = ml_io_map(FTS_TLMM_NORTH_PA, 0x81000);
+	ft.gpio_s = ml_io_map(FTS_TLMM_SOUTH_PA, 0x81000);
+	ft.se = ml_io_map(FTS_SE_PA, 0x4000);
+	ft.wrapper = ml_io_map(FTS_WRAPPER_PA, 0x1000);
+	if (!ft.gcc || !ft.gpio_n || !ft.gpio_s || !ft.se || !ft.wrapper) {
+		printf("SWEET FTS: MMIO mapping failed\n");
+		goto out;
+	}
+	printf("SWEET FTS: TLMM reset=%#x/%#x vddio=%#x/%#x irq=%#x/%#x\n",
+	    fts_rd(ft.gpio_n, FTS_GPIO_CFG(FTS_PIN_RESET)),
+	    fts_rd(ft.gpio_n, FTS_GPIO_IO(FTS_PIN_RESET)),
+	    fts_rd(ft.gpio_n, FTS_GPIO_CFG(FTS_PIN_VDDIO)),
+	    fts_rd(ft.gpio_n, FTS_GPIO_IO(FTS_PIN_VDDIO)),
+	    fts_rd(ft.gpio_s, FTS_GPIO_CFG(FTS_PIN_IRQ)),
+	    fts_rd(ft.gpio_s, FTS_GPIO_IO(FTS_PIN_IRQ)));
+	/* VDDIO first (fixed regulator on GPIO 84, 4 ms startup delay). */
+	fts_gpio(ft.gpio_n, FTS_PIN_VDDIO, 0, 0, 0, true, true);
+	fts_wait(4);
+	/* AVDD is PM8150L L1 (RPMh ldoc1). Keep going if the rail is already on. */
+	int perr = sweet_rpmh_vreg_enable("ldoc1", 1800);
+	printf("SWEET FTS: vddio gpio 84 high, avdd ldoc1 err=%d\n", perr);
+	fts_wait(20);
+	if (!fts_clocks()) {
+		goto out;
+	}
+	fts_gpio(ft.gpio_s, FTS_PIN_SDA, 1, 0, 0, false, false); /* qup17, 2 mA */
+	fts_gpio(ft.gpio_s, FTS_PIN_SCL, 1, 0, 0, false, false);
+	fts_gpio(ft.gpio_s, FTS_PIN_IRQ, 0, 3, 3, false, false); /* input, pull-up, 8 mA */
+	if (!fts_se_init()) {
+		goto out;
+	}
+	/* Datasheet reset: low >= 10 ms, then 50 ms before the first command. */
+	fts_gpio(ft.gpio_n, FTS_PIN_RESET, 0, 0, 0, true, false);
+	fts_wait(20);
+	fts_gpio(ft.gpio_n, FTS_PIN_RESET, 0, 0, 0, true, true);
+	fts_wait(50);
+	uint8_t info[8] = {0};
+	int err = fts_read(FTS_CMD_READ_INFO, info, sizeof(info));
+	printf("SWEET FTS: info err=%d chip=%02x%02x ver=%02x fw=%02x%02x cfg=%02x/%02x\n",
+	    err, info[6], info[7], info[0], info[2], info[3], info[4], info[5]);
+	if (err || ft.dead) {
+		goto out;
+	}
+	err = fts_write(FTS_CMD_SYSTEM_RESET);
+	if (!err) {
+		err = fts_wait_ready(1000, FTS_EVT_READY);
+	}
+	printf("SWEET FTS: system reset err=%d\n", err);
+	if (err || ft.dead) {
+		goto out;
+	}
+	err = fts_write(FTS_CMD_SLEEP_OUT);
+	if (!err) {
+		err = fts_wait_ready(1000, FTS_EVT_SLEEP_READY);
+	}
+	printf("SWEET FTS: sleep out err=%d\n", err);
+	if (err || ft.dead) {
+		goto out;
+	}
+	(void)fts_write(FTS_CMD_CLEAR_STACK);
+	err = fts_write(FTS_CMD_SENSE_ON);
+	printf("SWEET FTS: sense on err=%d; polling every 10 ms\n", err);
+	if (err) {
+		goto out;
+	}
+	unsigned errors = 0, events = 0, ticks = 0;
+	while (!ft.dead) {
+		/* The IRQ line (active low) says events are pending; also read
+		 * every ~20 ms in case the line does not work as assumed. */
+		bool poll = (++ticks % 2u) == 0;
+		while ((poll || !(fts_rd(ft.gpio_s, FTS_GPIO_IO(FTS_PIN_IRQ)) & 1u)) &&
+		    !ft.dead) {
+			poll = false;
+			if (fts_read_events(buf)) {
+				if ((errors++ % 100u) == 0) {
+					printf("SWEET FTS: read error (%u)\n", errors);
+				}
+				break;
+			}
+			bool any = false;
+			for (unsigned i = 0; i < FTS_STACK_DEPTH; ++i) {
+				const uint8_t *ev = buf + i * FTS_EVENT_SIZE;
+				if (ev[0] == FTS_EVT_NONE) {
+					break;
+				}
+				any = true;
+				if (ev[0] == FTS_EVT_READY || ev[0] == FTS_EVT_SLEEP_READY ||
+				    ev[0] == FTS_EVT_STATUS) {
+					if (ft.log) {
+						fts_log_event("ready", ev);
+					}
+					continue;
+				}
+				if (events++ < 32 && !ft.log) {
+					fts_log_event("first", ev);
+				}
+				fts_handle(ev);
+			}
+			if (!any) {
+				break;
+			}
+		}
+		if (errors == 10) {
+			fts_release_all(); /* release after persistent bad reads */
+		}
+		fts_wait(5);
+	}
+	fts_release_all();
+out:
+	printf("SWEET FTS: thread exits\n");
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+void
+sweet_fts_init(void)
+{
+	int enabled = 0;
+	thread_t thread;
+	if (ft.started) {
+		return;
+	}
+	ft.started = true;
+	(void)PE_parse_boot_argn("cepheustouch", &enabled, sizeof(enabled));
+	(void)PE_parse_boot_argn("cepheustouchlog", &ft.log, sizeof(ft.log));
+	if (!enabled) {
+		printf("SWEET FTS: disabled (cepheustouch=0)\n");
+		return;
+	}
+	kern_return_t kr = kernel_thread_start(fts_thread, NULL, &thread);
+	if (kr == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		printf("SWEET FTS: kernel_thread_start failed %d\n", kr);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
