+static volatile uint32_t *
+fts_dsi_ctrl0(void)
+{
+	static volatile uint32_t *dsi;
+	static bool failed;
+
+	if (dsi == NULL && !failed) {
+		dsi = (volatile uint32_t *)ml_io_map(FTS_DSI0_PA, FTS_DSI0_SIZE);
+		if (dsi == NULL) {
+			printf("SWEET FTS: panel: cannot map DSI0\n");
+			failed = true;
+		}
+	}
+	return dsi;
+}
