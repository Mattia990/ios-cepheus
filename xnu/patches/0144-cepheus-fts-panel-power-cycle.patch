+/*
+ * 0144: the FTS panel SET_ON replay owns the DSI command FIFO for a
+ * moment and skips the sequence's DCS 0x51 (it would write brightness 0).
+ * Forget the in-flight state and resend the level CoreBrightness last
+ * asked for, so a panel POR at boot does not leave the screen black.
+ */
+extern "C" void
+sweet_bl_reassert(void)
+{
+	sweet_bl_force = true;
+	sweet_bl_dcs_level(sweet_bl_requested);
+	sweet_bl_force = false;
