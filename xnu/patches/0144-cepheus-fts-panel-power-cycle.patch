+	if (dsi == NULL) {
+		return;
+	}
+	(void)fts_dsi_send_image(dsi, image, sizeof(image), 1);
+	image[0] = 0x10;
+	(void)fts_dsi_send_image(dsi, image, sizeof(image), 1);
+	fts_wait(120);
+}
