+/* Live DTB off-command: 0x28 display off (no wait), 0x10 sleep in + 120 ms. */
+static void
+fts_panel_off_seq(void)
+{
+	volatile uint32_t *dsi = fts_dsi_ctrl0();
+	uint8_t image[4] = { 0x28, 0x00, 0x05, 0x80 };
