+static bool
+sweet_log_properties(const char *tag, IOService *service, OSDictionary *dict)
+{
+	bool brightness = false;
+	OSCollectionIterator *it = OSCollectionIterator::withCollection(dict);
+
+	if (it == NULL) {
+		IOLog("%s: setProperties cannot iterate dictionary\n", tag);
+		return false;
+	}
+	OSObject *object;
+	while ((object = it->getNextObject()) != NULL) {
+		const OSSymbol *key = OSDynamicCast(OSSymbol, object);
+		const OSString *keyString = OSDynamicCast(OSString, object);
+		const char *name = key != NULL ? key->getCStringNoCopy() :
+		    (keyString != NULL ? keyString->getCStringNoCopy() : "?");
+		OSObject *value = dict->getObject(name);
+		OSNumber *number;
+		OSBoolean *boolean;
+		OSString *string;
+		OSData *data;
+
+		if ((number = OSDynamicCast(OSNumber, value)) != NULL) {
+			unsigned long long n = number->unsigned64BitValue();
+			IOLog("%s: setProperties %s = %llu (0x%llx)\n", tag, name, n, n);
+		} else if ((boolean = OSDynamicCast(OSBoolean, value)) != NULL) {
+			IOLog("%s: setProperties %s = %s\n", tag, name,
+			    boolean->getValue() ? "true" : "false");
+		} else if ((string = OSDynamicCast(OSString, value)) != NULL) {
+			IOLog("%s: setProperties %s = \"%s\"\n", tag, name,
+			    string->getCStringNoCopy());
+		} else if ((data = OSDynamicCast(OSData, value)) != NULL) {
+			const uint8_t *bytes = (const uint8_t *)data->getBytesNoCopy();
+			unsigned int len = data->getLength();
+			if (bytes != NULL && len >= 4) {
+				IOLog("%s: setProperties %s = data[%u] %02x %02x %02x %02x\n",
+				    tag, name, len, bytes[0], bytes[1], bytes[2], bytes[3]);
+			} else {
+				IOLog("%s: setProperties %s = data[%u]\n", tag, name, len);
+			}
+		} else {
+			IOLog("%s: setProperties %s = %p\n", tag, name, value);
+		}
+		if (name != NULL && (strcmp(name, "IOMFBBrightnessLevel") == 0 ||
+		    strcmp(name, "brightness-nits") == 0)) {
+			brightness = true;
+			/* store the value too, so a later read-back succeeds */
+			if (service != NULL) {
+				service->setProperty(name, value);
+			}
+		}
+	}
+	it->release();
+	IOLog("%s: setProperties done%s\n", tag, brightness ? " (brightness)" : "");
+	return brightness;
+}
+
 IOReturn
+IOMobileFramebuffer::setProperties(OSObject *properties)
+{
+	OSDictionary *dict = OSDynamicCast(OSDictionary, properties);
+
+	if (dict == NULL) {
+		IOLog("SWEET FB: setProperties non-dictionary %p\n", properties);
+		return kIOReturnSuccess;
+	}
+	sweet_log_properties("SWEET FB", this, dict);
+	return kIOReturnSuccess;
+}
