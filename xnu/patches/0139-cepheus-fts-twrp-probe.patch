+/*
+ * Probe-only HW access, from TWRP's fts_521 driver (ftsHardware.h,
+ * ftsCore.h, ftsCore.c).  TWRP reads the lockdown record and the CRC status
+ * register between its system reset and the sense-on; this driver used to
+ * skip both.  On I2C the fts_521 driver uses no dummy byte (DUMMY_HW_REG and
+ * DUMMY_CONFIG are 0 in the I2C branch), so the value starts at byte 0.
+ */
+#define FTS_CMD_HW_REG_R     0xfbu
+#define FTS_CRC_ADDR         0x20000078u
+#define FTS_CRC_MASK         0x03u
+#define FTS_CMD_LOCKDOWN     0xa6u
+#define FTS_LOCKDOWN_ADDR    0x0000u
+#define FTS_LOCKDOWN_HEAD    4u
+#define FTS_LOCKDOWN_DATA    20u
+#define FTS_LOCKDOWN_SIZE    8u
+#define FTS_LOCKDOWN_RETRY   2u
+#define FTS_LOCKDOWN_ID      0x70u
+#define FTS_EVT_TYPE_ECHO    0x01u
+#define FTS_EVT_CRC_CFG_HEAD 0x20u
+#define FTS_EVT_CRC_CFG      0x21u
+#define FTS_EVT_CRC_CX_HEAD  0xa0u
+#define FTS_EVT_CRC_CX       0xa1u
+#define FTS_EVT_CRC_CX_SUB_HEAD 0xa5u
+#define FTS_EVT_CRC_CX_SUB   0xa6u
+#define FTS_EVT_LOCKDOWN_FLASH 0x30u
+#define FTS_EVT_LOCKDOWN_NO_DATA 0x32u
 
 /*
  * ST FTS events (ftsSoftware.h): event[0] is the event id, event[1] holds
@@ -568,13 +596,187 @@
 			}
 		} else if (ft.log || t == 0) {
 			printf("SWEET FTS: ready poll err=%d\n", err);
