 /* 0xa0/00/01: active scan mode, MT sensing on. */
 static int
-fts_sense_on(void)
+fts_sense_set(uint8_t settings)
 {
-	const uint8_t cmd[3] = { FTS_CMD_SCAN_MODE, FTS_SCAN_ACTIVE, FTS_SENSE_ON };
+	const uint8_t cmd[3] = { FTS_CMD_SCAN_MODE, FTS_SCAN_ACTIVE, settings };
 	return fts_i2c_write_buf(cmd, sizeof(cmd));
 }
 
+static int
+fts_sense_on(void)
+{
+	return fts_sense_set(FTS_SENSE_ON);
+}
+
+/*
+ * TWRP's fts_init_sensing (fts_521, CONFIG_FTS_FOD_AREA_REPORT) turns the
+ * scan on, off again immediately, waits WAIT_AFTER_SENSEOFF (50 ms) and
+ * turns it back on.  The first calibration is aborted before it completes;
+ * the second one is the calibration the chip keeps.  A warm-boot chip
+ * without the toggle reports edge ghosts and 43 05 30 a few seconds after
+ * the first scan starts.
+ */
+static int
+fts_sense_cycle(void)
+{
+	int err = fts_sense_set(FTS_SENSE_ON);
+	fts_wait(2);
+	int off = fts_sense_set(0);
+	if (off && !err) {
+		err = off;
+	}
+	fts_wait(50);
+	int on = fts_sense_set(FTS_SENSE_ON);
+	if (on && !err) {
+		err = on;
+	}
+	return err;
+}
