 /*
- * boot-arg sweetbl: when to publish the fake AppleARMBacklight.
+ * sweetbl=3 variant: match backlight-control=true without conforming to
+ * AppleARMBacklight. CBDisplayContaineriOS then takes its non-ARM path, which
+ * leaves DisplaySyncBrightnessTransactions off and uses the registry write
+ * path in _SetIOMFBBrightness. Logged exactly like the ARM node.
+ */
+class SweetBacklight : public IOService {
+	OSDeclareDefaultStructors(SweetBacklight);
+
+public:
+	IOReturn setProperties(OSObject *properties) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(SweetBacklight, IOService);
+
+IOReturn
+SweetBacklight::setProperties(OSObject *properties)
+{
+	OSDictionary *dict = OSDynamicCast(OSDictionary, properties);
+
+	if (dict == NULL) {
+		IOLog("SWEET BL: setProperties non-dictionary %p\n", properties);
+		return kIOReturnSuccess;
+	}
+	sweet_log_properties("SWEET BL", this, dict);
+	return kIOReturnSuccess;
+}
+
+/*
+ * boot-arg sweetbl: when/what to publish as the fake backlight.
