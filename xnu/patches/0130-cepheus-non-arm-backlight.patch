- *   1 = at AppleCLCD::start (default, phase-1 behaviour)
- *   2 = on the first display-on requested by backboardd
+ *   1 = at AppleCLCD::start, AppleARMBacklight (default, phase-1 behaviour)
+ *   2 = AppleARMBacklight on the first display-on requested by backboardd
+ *   3 = at AppleCLCD::start, non-ARM service (no AppleARMBacklight conformance)
  */
 static int
 sweet_bl_mode(void)
