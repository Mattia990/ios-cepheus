 static uint64_t sweet_fb_logged;        /* selectors already logged (< 64) */
+static uint64_t sweet_fb_async_seen;    /* selectors whose async call was logged (< 64) */
+static uint64_t sweet_fb_async_done;    /* selectors whose async reply was logged (< 64) */
+
+/*
+ * MIG async calls (IOConnectCallAsyncScalarMethod / AsyncStructMethod) are
+ * completed by the user client itself. IOUserClient::callExternalMethod calls
+ * this override directly, so the base class never sends the completion and the
+ * caller waits on its wake port until its own timeout fires. Reply here; the
+ * reference array already carries the wake port and the kIOUCAsync64Flag.
+ */
+void
+IOMobileFramebufferUserClient::asyncReply(IOExternalMethodArguments *args, IOReturn ret)
+{
+	uint32_t count = args->scalarOutputCount;
+	char name[32];
+
+	if (ret != kIOReturnSuccess || args->asyncWakePort == MACH_PORT_NULL ||
+	    args->asyncReference == NULL || args->asyncReferenceCount == 0) {
+		return;
+	}
+	if (count > kMaxAsyncArgs) {
+		count = kMaxAsyncArgs;
+	}
+	if (sweet_fb_async_log || args->selector >= 64 ||
+	    !(sweet_fb_async_done & (1ULL << args->selector))) {
+		if (args->selector < 64) {
+			sweet_fb_async_done |= 1ULL << args->selector;
+		}
+		proc_selfname(name, sizeof(name));
+		IOLog("SWEET FB: %s sel %u async reply -> 0x%x (%u out)\n",
+		    name, args->selector, ret, count);
+	}
+	sendAsyncResult64(args->asyncReference, ret, args->scalarOutput, count);
+}
 
 IOReturn
 IOMobileFramebufferUserClient::externalMethod(uint32_t selector, IOExternalMethodArguments *args,
@@ -955,6 +993,19 @@
 	uint64_t out[2] = { 0, 0 };
