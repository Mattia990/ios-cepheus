+		IOLog("SWEET FB: %s sel %u async wake 0x%x refs %u\n", name, selector,
+		    args->asyncWakePort, args->asyncReferenceCount);
+	}
+
 	/* Brightness-related IOMFB selectors: log every call and its inputs. */
 	if (selector == 50 || selector == 51 || selector == 84) {
 		const uint8_t *data = (const uint8_t *)args->structureInput;
@@ -1074,6 +1125,7 @@
 			    args->scalarOutputCount, args->structureOutputSize, ret);
 		}
