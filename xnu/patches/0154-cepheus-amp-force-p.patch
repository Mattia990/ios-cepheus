 recommended_pset_type(thread_t thread)
 {
@@ -1677,6 +1681,23 @@ recommended_pset_type(thread_t thread)
 		}
 	}
 
+#if defined(SWEET)
+	/*
+	 * AMP's perfcontrol recommendation puts every daemon on E, including
+	 * backboardd, whose compositor is the frame-critical thread here. Let
+	 * interactive daemons and apps use P; the utility/background checks
+	 * above still keep their low-priority threads on E.
+	 */
+	if (sweet_amp_force_p) {
+		task_t force_task = get_threadtask(thread);
+		if (force_task != kernel_task &&
+		    (force_task->requested_policy.trp_apptype == TASK_APPTYPE_DAEMON_INTERACTIVE ||
+		     force_task->requested_policy.trp_apptype == TASK_APPTYPE_APP_DEFAULT)) {
+			return PSET_AMP_P;
+		}
+	}
+#endif
+
 	struct thread_group *tg = thread_group_get(thread);
 	cluster_type_t recommendation = thread_group_recommendation(tg);
 	switch (recommendation) {
