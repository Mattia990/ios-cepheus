@@ -137,6 +137,10 @@
 static inline void sched_clutch_hierarchy_locked_assert(sched_clutch_root_t);
 
 extern processor_set_t pset_array[MAX_PSETS];
+
+#if defined(SWEET)
+extern bool sweet_amp_force_p;
