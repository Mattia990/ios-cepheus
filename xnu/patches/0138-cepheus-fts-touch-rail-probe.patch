+
+/* Xiaomi's power-on order: VDDIO (bus) first, then AVDD (pwr). */
+static int
+fts_rails_on(void)
+{
+	fts_gpio(ft.gpio_n, FTS_PIN_VDDIO, 0, 0, 0, true, true);
+	fts_wait(4);
+	int err = sweet_rpmh_vreg_enable("ldoc1", 1800);
+	fts_wait(20);
+	return err;
+}
+
+/*
+ * Hold both rails off and prove with the sysinfo frame whether the controller
+ * actually lost power. fts_rails_off only starts the discharge: the PMIC and
+ * load-switch output capacitors decide how long the rails take to fall. Reset
+ * stays asserted and the CPU busy during the window: releasing reset or
+ * entering RPMh sleep would let a pin or the sleep vote power the chip again.
+ */
+static void
+fts_power_off(void)
+{
+	/* Positive control: this must answer while the rails are still up. */
+	fts_gpio(ft.gpio_n, FTS_PIN_RESET, 0, 3, 0, true, true);
+	fts_udelay(150u * 1000u);
+	bool before = fts_rail_probe();
+	fts_gpio(ft.gpio_n, FTS_PIN_RESET, 0, 3, 0, true, false);
+	printf("SWEET FTS: controller before rails-off: %s\n",
+	    before ? "alive" : "unpowered");
+
+	fts_rails_off();
+	fts_udelay(ft.off_ms * 1000u);
+	/* 2 mA drive limits phantom power through the reset ESD diode. */
+	fts_gpio(ft.gpio_n, FTS_PIN_RESET, 0, 3, 0, true, true);
+	fts_udelay(150u * 1000u);
+	bool alive = fts_rail_probe();
+	fts_gpio(ft.gpio_n, FTS_PIN_RESET, 0, 3, 0, true, false);
+	printf("SWEET FTS: rails off %u ms: controller %s\n", ft.off_ms,
+	    alive ? "alive" : "unpowered");
 }
 
