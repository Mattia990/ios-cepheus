+
+/*
+ * Prove whether the controller is powered. A bare address ACK is not enough:
+ * an unpowered chip clamps SDA through its ESD diode, which the bit-banged
+ * master reads as an ACK. The sysinfo frame has a fixed 0xa5/0x01 signature,
+ * so an unpowered chip returns zeros/ones instead and the probe is unambiguous.
+ */
+static bool
+fts_rail_probe(void)
+{
+	uint8_t si[FTS_SYSINFO_SIZE] = { 0 };
+	int err = fts_read_sysinfo(si);
+	bool alive = !err && si[0] == FTS_SYSINFO_SIG &&
+	    si[1] == FTS_SYSINFO_LOAD_ID;
+
+	printf("SWEET FTS: rails-off probe err=%d sig=%02x/%02x -> %s\n", err,
+	    si[0], si[1], alive ? "alive" : "unpowered");
+	return alive;
 }
 
