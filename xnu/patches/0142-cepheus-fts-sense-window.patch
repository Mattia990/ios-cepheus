 /*
- * TWRP's fts_init_sensing (fts_521, CONFIG_FTS_FOD_AREA_REPORT) turns the
- * scan on, off again immediately, waits WAIT_AFTER_SENSEOFF (50 ms) and
- * turns it back on.  The first calibration is aborted before it completes;
- * the second one is the calibration the chip keeps.  A warm-boot chip
- * without the toggle reports edge ghosts and 43 05 30 a few seconds after
- * the first scan starts.
+ * TWRP's first scan only runs for ~350 ms: sense-on at 1.231 s, DRM blank
+ * at 1.604 s (sense-off, low-power scan), panel power cycle, then a
+ * controller system reset and the second sense-on at 1.880 s. That second
+ * calibration never reports the warm-boot edge ghosts or 43 05 30, while a
+ * scan left running in XNU latches the bad mutual baseline after ~3.5 s and
+ * a later reset (0141's display reinit) does not clear it. Cut the first
+ * scan at the same point, reset, and keep the second calibration.
  */
 static int
 fts_sense_cycle(void)
 {
 	int err = fts_sense_set(FTS_SENSE_ON);
-	fts_wait(2);
+	fts_wait(ft.sense_ms);
 	int off = fts_sense_set(0);
 	if (off && !err) {
 		err = off;
 	}
 	fts_wait(50);
-	int on = fts_sense_set(FTS_SENSE_ON);
-	if (on && !err) {
-		err = on;
+	if (ft.cycle_reset) {
+		fts_release_all();
+		fts_reset();
+		if (!fts_bb_recover() && !err) {
+			err = EIO;
+		}
+		int rerr = fts_wait_ready(500);
+		if (rerr && !err) {
+			err = rerr;
+		}
 	}
-	return err;
+	int on = fts_sense_set(FTS_SENSE_ON);
+	if (!on) {
+		/* The second scan is up; a slow reset handshake is not fatal. */
+		if (err) {
+			printf("SWEET FTS: sense cycle err=%d, scan on\n", err);
+		}
+		return 0;
+	}
+	return err ? err : on;
 }
 
