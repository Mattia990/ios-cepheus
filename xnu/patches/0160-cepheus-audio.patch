+++ b/bsd/dev/cepheus_audio_glue.c
@@ -0,0 +1,76 @@
+/*
+ * Glue for the audio stack ported from not-exyy/ios-cepheus (HakiOS):
+ * the locks its drivers share, the loader hooks they expect, and the
+ * drivers this port does not build yet (haptics, torch, camera, virtio
+ * sound, and the small-image file server).
+ */
+#include <sys/param.h>
+#include <sys/types.h>
+#include <sys/systm.h>
+#include <kern/locks.h>
+#include <sys/hakios.audio.h>
+#include <sys/hakios.input.h>
+
+/*
+ * The ADSP driver and the sound driver both take these; the RPMh sequencer
+ * lock is also taken by bsd/dev/sweet_rpmh.c, and the SMMU lock will be
+ * shared with the GPU's SMMU setup once it is changed to take it.
+ */
+LCK_GRP_DECLARE(hakios_glue_lck_grp, "cepheus-audio");
+LCK_MTX_DECLARE(hakios_aop_mailbox_lock, &hakios_glue_lck_grp);
+LCK_MTX_DECLARE(hakios_smem_alloc_lock, &hakios_glue_lck_grp);
+LCK_MTX_DECLARE(hakios_rsc_lock, &hakios_glue_lck_grp);
+LCK_MTX_DECLARE(hakios_smmu_lock, &hakios_glue_lck_grp);
+
+/* The loader in this port has no recording hand-off; only used with rec_sound=N. */
+uint64_t loader_sound[3];
+
+void
+loader_log_putc(char c)
+{
+	(void)c;
+}
+
+void
+loader_return(void)
+{
+	panic("adsp_return is not supported in this port");
+}
+
+/* The small-image file server does not exist here: firmware is read from /fw. */
+const uint8_t *
+hakios_image_file(const char *dir, const char *name, uint64_t *size, int *disk_out)
+{
+	(void)dir;
+	(void)name;
+	(void)size;
+	(void)disk_out;
+	return NULL;
+}
+
