+static bool
+otp_unpack(void)
+{
+	const struct otp_element *map;
+	uint32_t id = 0, mem[32], bit_offset = 16, word = 2, written = 0;
+	unsigned count;
+
+	if (!cs_read(CS35L41_OTPID, &id)) {
+		give_up("the OTP's id cannot be read");
+		return false;
+	}
+	switch (id) {
+	case 0x01: case 0x08:
+		map = otp_map_1;
+		count = sizeof(otp_map_1) / sizeof(otp_map_1[0]);
+		break;
+	case 0x02: case 0x03: case 0x06:
+		map = otp_map_2;
+		count = sizeof(otp_map_2) / sizeof(otp_map_2[0]);
+		break;
+	default:
+		say("cs35l41: OTP id %#x: no map for it\n", id);
+		give_up("an OTP map this does not know");
+		return false;
+	}
+	for (unsigned i = 0; i < 32; i++) {
+		if (!cs_read(CS35L41_OTP_MEM0 + 4 * i, &mem[i])) {
+			give_up("the OTP cannot be read");
+			return false;
+		}
+	}
+	for (unsigned i = 0; i < count; i++) {
+		uint32_t size = map[i].size, value = 0;
+
+		if (bit_offset + size >= 33) {          /* (Linux: bit_offset + size - 1 >= 32) */
+			value = (mem[word] >> bit_offset);
+			if (word + 1 >= 32) {
+				give_up("the OTP map runs past the OTP");
+				return false;
+			}
+			word++;
+			value |= (mem[word] & (0xffffffffu >> (64 - bit_offset - size))) << (32 - bit_offset);
+			bit_offset += size - 32;
+		} else if (size != 0) {
+			value = (mem[word] >> bit_offset) & (0xffffffffu >> (32 - size));
+			bit_offset += size;
+		}
+		if (bit_offset == 32) {
+			bit_offset = 0;
+			word++;
+		}
+		if (map[i].reg != 0 && size != 0) {
+			uint32_t mask = (0xffffffffu >> (32 - size)) << map[i].shift;
+
+			/* (as Linux: regmap_update_bits, nothing read back) */
+			if (!modify(map[i].reg, mask, value << map[i].shift, true)) {
+				return false;
+			}
+			written++;
+		}
+	}
+	say("cs35l41: the trims unpacked from the OTP (id %#x, map %u): %u fields\n", id, map == otp_map_1 ? 1 : 2, written);
+	return true;
+}
+
+static void
+need_pins(void)
+{
+	if (tlmm_north == 0) {
+		/* kernel_map, not ml_io_map's 8 MB io_submap (2 MB of tiles; sweet_pmem.c does the same) */
+		tlmm_north = ml_io_map_unmappable(TLMM_NORTH_PHYS, TLMM_TILE_SIZE, VM_WIMG_IO);
+		tlmm_south = ml_io_map_unmappable(TLMM_SOUTH_PHYS, TLMM_TILE_SIZE, VM_WIMG_IO);
+	}
+}
+
+static uint32_t volume_now = VOL_LOWEST + 1;    /* eighths of a dB under 0 dB; VOL_LOWEST + 1: muted */
+
+static bool
+volume_put(uint32_t below)
+{
+	uint32_t field = below > VOL_LOWEST ? VOL_MUTE : (uint32_t)(-(int32_t)below) & 0x7ffu;
+
+	if (!update(CS35L41_AMP_DIG_VOL_CTRL, VOL_MASK, field << VOL_SHIFT)) {
+		return false;
+	}
+	volume_now = below > VOL_LOWEST ? VOL_LOWEST + 1 : below;
+	return true;
+}
+
+bool
+hakios_speaker_prepare(__unused const uint8_t *acf, __unused uint64_t size)
+{
+	static const uint32_t errata_b0[][2] = {
+		{ CS35L41_VIMON_SPKMON_RESYNC, 0 }, { 0x00004310, 0 }, { CS35L41_VPVBST_FS_SEL, 0 }, { CS35L41_BSTCVRT_DCM_CTRL, 0x51 },
+		{ CS35L41_DSP1_YM_ACCEL_PL0_PRI, 0 }, { CS35L41_DSP1_XM_ACCEL_PL0_PRI, 0 }, { CS35L41_PWR_CTRL2, 0 },
+		{ CS35L41_AMP_GAIN_CTRL, 0 }, { CS35L41_ASP_TX3_SRC, 0 }, { CS35L41_ASP_TX4_SRC, 0 },
+	};
+	uint32_t status = 0, errors = 0, id = 0, rev = 0;
+
+	if (broken) {
+		return false;
+	}
+	if (prepared) {
+		return true;
+	}
+	need_pins();
+	say("cs35l41: prepared as Linux prepares one whose DSP is not used: the reset released\n");
+	wr(GPIO_IO(PIN_RESET), 0);
+	wr(GPIO_CFG(PIN_RESET), (rd(GPIO_CFG(PIN_RESET)) & ~(3u | 15u << 2)) | CFG_OUTPUT);
+	wait_ms(2);
+	wr(GPIO_IO(PIN_RESET), 2);
+	wait_ms(2);
+	for (unsigned ms = 0; ms < 100 && !(cs_read(CS35L41_IRQ1_STATUS4, &status) && (status & CS35L41_OTP_BOOT_DONE)); ms++) {
+		wait_ms(1);
+	}
+	(void)cs_read(CS35L41_IRQ1_STATUS3, &errors);
+	if (!(status & CS35L41_OTP_BOOT_DONE) || (errors & CS35L41_OTP_BOOT_ERR) || !cs_read(CS35L41_DEVID, &id) ||
+	    !cs_read(CS35L41_REVID, &rev) || id != CS35L41_CHIP_ID || rev != 0xb0) {
+		say("cs35l41: its start-up: IRQ1_STATUS4 %#x, IRQ1_STATUS3 %#x, device id %#x, revision %#x\n", status, errors, id, rev);
+		give_up("not the chip this is for, or it did not start");
+		return false;
+	}
+	say("cs35l41: a CS35L41 B0, started; the test key open, the B0 errata, the trims from the OTP\n");
+	if (!put_blind(CS35L41_TEST_KEY_CTL, 0x55) || !put_blind(CS35L41_TEST_KEY_CTL, 0xaa)) {
+		return false;
+	}
+	for (unsigned i = 0; i < sizeof(errata_b0) / sizeof(errata_b0[0]); i++) {
+		if (!put_blind(errata_b0[i][0], errata_b0[i][1])) {
+			return false;
+		}
+	}
+	if (!put_blind(CS35L41_DSP1_CCM_CORE_CTRL, 0) || !otp_unpack() ||
+	    !put_blind(CS35L41_TEST_KEY_CTL, 0xcc) || !put_blind(CS35L41_TEST_KEY_CTL, 0x33)) {
+		return false;
+	}
+	say("cs35l41: the boost (1000 nH, 15 uF, 4000 mA), the ASP (I2S, 48 kHz, 32-bit slots of 24-bit words, RX1 slot 0), the "
+	    "PLL from the 3.072 MHz bit clock, gain 17, muted, ASPRX1 to the PCM, class H\n");
+	if (!put(CS35L41_IRQ1_MASK1, INT1_MASK_DEFAULT) ||
+	    /* cs35l41_boost_config(1000, 15, 4000): k1 0x24, k2 0x24, slope 0x75, lbst 0, ipk (4000 - 1600) / 50 + 0x10 */
+	    !update(CS35L41_BSTCVRT_COEFF, 0xffff, 0x24 | 0x24 << 8) ||
+	    !update(CS35L41_BSTCVRT_SLOPE_LBST, 0xff03, 0x75 << 8 | 0) ||
+	    !update(CS35L41_BSTCVRT_PEAK_CUR, 0x7f, (4000 - 1600) / 50 + 0x10) ||
+	    !update(CS35L41_PWR_CTRL2, 0x30, 2 << 4) ||
+	    /* cs35l41_set_dai_fmt(CBC_CFC | I2S | NB_NF): the format 2, nothing ours */
+	    !update(CS35L41_SP_FORMAT, 0x10 | 0x01 | 0x0700 | 0x04 | 0x40, 2 << 8) ||
+	    /* cs35l41_pcm_hw_params: 48 kHz (0x03); the RX slot 32 bits wide, the word 24 */
+	    !update(CS35L41_GLOBAL_CLK_CTRL, 0x1f, 0x03) ||
+	    !update(CS35L41_SP_FORMAT, 0xff000000u, 32u << 24) ||
+	    !update(CS35L41_SP_RX_WL, 0x3f, 24) ||
+	    !update(CS35L41_SP_FRAME_RX_SLOT, 0x3f, 0) ||
+	    /* cs35l41_component_set_sysclk(SCLK, 3072000): open loop, the reference 0x21, off, from SCLK, closed loop, on */
+	    !update(CS35L41_PLL_CLK_CTRL, 0x0800, 0x0800) ||
+	    !update(CS35L41_PLL_CLK_CTRL, 0x07e0, 0x21 << 5) ||
+	    !update(CS35L41_PLL_CLK_CTRL, 0x0010, 0) ||
+	    !update(CS35L41_PLL_CLK_CTRL, 0x0007, 0) ||
+	    !update(CS35L41_PLL_CLK_CTRL, 0x0800, 0) ||
+	    !update(CS35L41_PLL_CLK_CTRL, 0x0010, 0x0010) ||
+	    /* cs35l41_dai_set_sysclk(3072000) */
+	    !put(CS35L41_TST_FS_MON0, 28 | (44u << 12 & 0x00fff800u)) ||
+	    !update(CS35L41_AMP_GAIN_CTRL, 0x3e0, ANDROID_GAIN << 5) ||
+	    !volume_put(VOL_LOWEST + 1) ||
+	    !update(CS35L41_DAC_PCM1_SRC, 0xff, 0x08) ||
+	    !update(CS35L41_SP_ENABLES, 1u << 16, 1u << 16) ||
+	    !update(CS35L41_PWR_CTRL3, 1u << 4, 1u << 4)) {
+		return false;
+	}
+	prepared = true;
+	say("cs35l41: PREPARED: powered down, muted\n");
+	return true;
+}
+
+bool
+hakios_speaker_start(void)
+{
+	uint32_t status = 0;
+
+	if (broken || !prepared) {
+		return false;
+	}
+	if (started) {
+		return true;
+	}
+	/* cs35l41_main_amp_event(PRE_PMU): the power-up patch, then cs35l41_global_enable() for the internal boost */
+	if (!put_blind(CS35L41_TEST_KEY_CTL, 0x55) || !put_blind(CS35L41_TEST_KEY_CTL, 0xaa) ||
+	    !put_blind(0x00002084, 0x002f1aa0) || !put_blind(CS35L41_TEST_KEY_CTL, 0xcc) || !put_blind(CS35L41_TEST_KEY_CTL, 0x33) ||
+	    !update(CS35L41_PWR_CTRL1, 1, 1)) {
+		return false;
+	}
+	for (unsigned ms = 0; ms < 100 && !(cs_read(CS35L41_IRQ1_STATUS1, &status) && (status & PUP_DONE)); ms++) {
+		pause_ms(1);
+	}
+	if (!(status & PUP_DONE)) {
+		say("cs35l41: no \"power-up done\" within 100 ms (IRQ1_STATUS1 %#x): is the bit clock running?\n", status);
+		give_up("it did not power up");
+		return false;
+	}
+	if (!put_blind(CS35L41_IRQ1_STATUS1, PUP_DONE) || !update(CS35L41_PWR_CTRL2, 1, 1)) {
+		return false;
+	}
+	started = true;
+	say("cs35l41: STARTED (IRQ1_STATUS1 %#x): powered up, the amplifier on, muted\n", status);
+	return true;
+}
+
+bool
+hakios_speaker_volume(uint32_t below, uint32_t step_ms)
+{
+	uint32_t target = below > VOL_LOWEST ? VOL_LOWEST + 1 : below;
+
+	if (broken || !started) {
+		return false;
+	}
+	while (volume_now != target) {
+		uint32_t next;
+
+		if (volume_now > target) {
+			next = volume_now - target > 48 ? volume_now - 48 : target;
+			if (volume_now == VOL_LOWEST + 1) {
+				next = target + 48 * 4 < VOL_LOWEST ? target + 48 * 4 : target; /* from mute: 24 dB above the end at most */
+				next = next > VOL_LOWEST ? VOL_LOWEST : next;
+			}
+		} else {
+			next = target - volume_now > 48 ? volume_now + 48 : target;
+		}
+		if (!volume_put(next)) {
+			return false;
+		}
+		if (volume_now != target && step_ms != 0) {
+			pause_ms(step_ms);
+		}
+	}
+	return true;
+}
+
+static uint32_t warnings;
+
+bool
+hakios_speaker_healthy(void)
+{
+	uint32_t status = 0;
+
+	if (broken) {
+		return false;
+	}
+	if (!cs_read(CS35L41_IRQ1_STATUS1, &status)) {
+		give_up("its status cannot be read");
+		return false;
+	}
+	if (status & STATUS1_FAULTS) {
+		say("cs35l41: IRQ1_STATUS1 %#x: A FAULT (%s%s%s%s%s)\n", status, status & 0x80000000u ? "the amplifier's short circuit " : "",
+		    status & 0x00020000u ? "over-temperature " : "", status & 0x40u ? "the boost's over-voltage " : "",
+		    status & 0x80u ? "the boost's under-voltage " : "", status & 0x100u ? "the boost's short circuit" : "");
+		give_up("a fault");
+		return false;
+	}
+	warnings = status & STATUS1_TEMP_WARN;
+	return true;
+}
+
+uint32_t
+hakios_speaker_monitor(bool tell)
+{
+	if (warnings && tell) {
+		say("cs35l41: a temperature warning: 6 dB less\n");
+	}
+	return warnings ? 48 : 0;
+}
+
+void
+hakios_speaker_stop(void)
+{
+	uint32_t status = 0;
+
+	if (broken || !started) {
+		return;
+	}
+	(void)hakios_speaker_volume(VOL_LOWEST + 1, 1);
+	/* the amplifier off, then cs35l41_global_enable(0) and the power-down patch (POST_PMD) */
+	if (!update(CS35L41_PWR_CTRL2, 1, 0) || !update(CS35L41_PWR_CTRL1, 1, 0)) {
+		return;
+	}
+	for (unsigned ms = 0; ms < 100 && !(cs_read(CS35L41_IRQ1_STATUS1, &status) && (status & PDN_DONE)); ms++) {
+		pause_ms(1);
+	}
+	(void)put_blind(CS35L41_IRQ1_STATUS1, PDN_DONE);
+	(void)put_blind(CS35L41_TEST_KEY_CTL, 0x55);
+	(void)put_blind(CS35L41_TEST_KEY_CTL, 0xaa);
+	(void)put_blind(0x00002084, 0x002f1aa3);
+	(void)put_blind(CS35L41_TEST_KEY_CTL, 0xcc);
+	(void)put_blind(CS35L41_TEST_KEY_CTL, 0x33);
+	started = false;
+	say("cs35l41: stopped: muted, the amplifier off, powered down%s\n", (status & PDN_DONE) ? "" : " (no \"power-down done\")");
+}
+
+void
+hakios_speaker_quiesce(void)
+{
+	if (!prepared || tlmm_north == 0) {
+		return;
+	}
+	leaving = true;
+	(void)cs_write(CS35L41_PWR_CTRL1, 0);
+	wr(GPIO_IO(PIN_RESET), 0);
+	prepared = started = false;
+}
+
+static void
+probe_thread(__unused void *parameter, __unused wait_result_t result)
+{
+	uint32_t reset_cfg, reset_io;
+	bool was_released;
+
+	/* kernel_map, not ml_io_map's 8 MB io_submap (2 MB of tiles; sweet_pmem.c does the same) */
+	tlmm_north = ml_io_map_unmappable(TLMM_NORTH_PHYS, TLMM_TILE_SIZE, VM_WIMG_IO);
+	tlmm_south = ml_io_map_unmappable(TLMM_SOUTH_PHYS, TLMM_TILE_SIZE, VM_WIMG_IO);
+	say("cs35l41: level %u: %s\n", probe_level, probe_level == 1 ? "a look, reading only" :
+	    "the reset released, the chip's start-up waited for, its ids read; nothing written to it");
+	show_pins();
+	reset_cfg = rd(GPIO_CFG(PIN_RESET));
+	reset_io = rd(GPIO_IO(PIN_RESET));
+	was_released = (reset_cfg & CFG_OUTPUT) && (reset_io & 2);
+	say("cs35l41: the reset is %s\n", was_released ? "released (gpio89 drives high)" : "not released: the chip is held in reset");
+	(void)show_ids("as found");
+	if (probe_level >= 2) {
+		uint32_t status = 0, errors = 0;
+		uint64_t began;
+
+		say("cs35l41: the reset is released as Linux does it: gpio89 low for 2 ms, then high\n");
+		wr(GPIO_IO(PIN_RESET), 0);
+		wr(GPIO_CFG(PIN_RESET), (reset_cfg & ~(3u | 15u << 2)) | CFG_OUTPUT);   /* a GPIO, no pull, output, its drive kept */
+		wait_ms(2);
+		wr(GPIO_IO(PIN_RESET), 2);
+		wait_ms(2);
+		began = mach_absolute_time();
+		for (unsigned ms = 0; ms < 100; ms++) {
+			if (cs_read(CS35L41_IRQ1_STATUS4, &status) && (status & CS35L41_OTP_BOOT_DONE)) {
+				break;
+			}
+			wait_ms(1);
+		}
+		(void)cs_read(CS35L41_IRQ1_STATUS3, &errors);
+		{
+			uint64_t ns;
+
+			absolutetime_to_nanoseconds(mach_absolute_time() - began, &ns);
+			say("cs35l41: its start-up: IRQ1_STATUS4 %#x (%s) after %llu ms, IRQ1_STATUS3 %#x%s\n", status,
+			    (status & CS35L41_OTP_BOOT_DONE) ? "OTP boot done" : "OTP BOOT NOT DONE", ns / NSEC_PER_MSEC, errors,
+			    (errors & CS35L41_OTP_BOOT_ERR) ? " (OTP BOOT ERROR)" : "");
+		}
+		(void)show_ids("out of reset");
+		/* back as it was found */
+		wr(GPIO_IO(PIN_RESET), reset_io & 2);
+		wr(GPIO_CFG(PIN_RESET), reset_cfg);
+		say("cs35l41: the reset is put back as it was found (%s)\n", was_released ? "released" : "held");
+	}
+	say("cs35l41: done\n");
+	thread_terminate(current_thread());
+}
+
+void
+hakios_speaker_init(void)
+{
+	thread_t thread;
+
+	if (!PE_parse_boot_argn("speaker_probe", &probe_level, sizeof(probe_level)) || probe_level == 0) {
+		return;
+	}
+	probe_level = probe_level > 2 ? 2 : probe_level;
+	if (kernel_thread_start(probe_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
diff --git a/bsd/dev/hakios.guard.c b/bsd/dev/hakios.guard.c
new file mode 100644
index 0000000..4c91f0a
--- /dev/null
+++ b/bsd/dev/hakios.guard.c
@@ -0,0 +1,319 @@
+/* Ported from not-exyy/ios-cepheus (HakiOS) for this cepheus port; see HANDOFF.md. */
+/*
+ * The speakers' guard: what the samples go through on their way to the phone's two amplifiers
+ * (drivers/audio/hakios.sound.c's feeder), in place of the protection Android has in the audio DSP.
+ *
+ * Under Android the DSP runs Awinic's algorithm (SKTune, "aw882xx_rx_switch") with each
+ * speaker's calibration: it keeps the cone's excursion and the voice coil's temperature in
+ * bounds, measuring both through the amplifiers' current and voltage feedback. None of that runs
+ * here, and nothing here knows the speakers' parameters (Android's files that can be read have
+ * none: the amplifiers' register profile, the battery tables of its "monitor", and in the device
+ * tree a range of 4 to 9 ohms for the calibrated resistance). So the guard holds what reaches the
+ * speakers to levels that are safe for small phone speakers whatever they are exactly, measured
+ * the only way there is without feedback -- from the samples and the amplifiers' level -- and
+ * kept well under what the speakers can take at Android's level:
+ *
+ *   high-pass  a second-order Butterworth filter at 200 Hz: a phone's speaker gives out next to
+ *              nothing below its resonance (several hundred Hz), and what it is given there only
+ *              moves the cone further and heats the coil
+ *   power      the power that would reach a speaker, averaged three ways -- over 0.2 s (the
+ *              cone and coil at once), 3 s (the voice coil's warming) and 60 s (the magnet and
+ *              the frame) -- and the level turned down so that none of the three averages goes
+ *              over its limit: 3, 6 and 9 dB under the power of a full-scale sine at Android's
+ *              level. Sound of ordinary loudness never comes near them; a sustained full-scale
+ *              tone is turned down at once to the first, after seconds to the second and over a
+ *              minute to the third, and the level comes back up as the averages fall, as a
+ *              speaker cools. The averages go on falling while the amplifiers are off.
+ *   peaks      no sample above 3 dB under full scale at Android's level: a limiter that turns
+ *              the level down at the sample that would go over (so none does) and lets it come
+ *              back with a time constant of 43 ms
+ *   monitor    a further reduction that the amplifiers' watch asks for (hakios.speaker.c:
+ *              Android's table for a cold amplifier, and a low battery)
+ *
+ * Before all that, a gain (sound_gain, at most 12 dB): Darwin's own processing for the iPhone X's
+ * speaker keeps even a full-scale tone at its top volume 12.6 to 14.3 dB under full scale, so
+ * without it Darwin at the top would stay that much under Android at the top. What it lifts over
+ * full scale is held to full scale by the peak limiter (or to its lower limit), never clipped.
+ *
+ * All the limits are in terms of the speakers: a signal at full scale with the amplifiers at
+ * Android's level (the loudest they are ever set to) is 0 dB. With the amplifiers turned down
+ * (sound_below) the same samples are that much quieter at the speakers, and the guard holds them
+ * back only that much later. Everything is integer arithmetic (the kernel's threads do no
+ * floating point); fractions are in Q30 unless said otherwise.
+ *
+ * One caller at a time (the feeder); hakios_guard_attenuation() and hakios_guard_monitor() may
+ * be called from another thread.
+ */
+#include <stdbool.h>
+#include <stdint.h>
+#include <sys/hakios.audio.h>
+
+#define ONE                     (1ll << 30)
+#define FULL_SCALE              32768
+
+/* The limits, in eighths of a dB under full scale at Android's level (powers: under a full-scale square wave's) */
+#define PEAK_LIMIT              (3 * 8)
+#define RMS_LIMIT               (6 * 8)         /* a full-scale sine is 3 dB under a square wave: these are 3, 6, 9 dB under it */
+#define FAST_LIMIT              (9 * 8)
+#define SLOW_LIMIT              (12 * 8)
+/* ... and the averages' time constants, in frames (48 kHz) */
+#define RMS_FRAMES              9600            /* 0.2 s */
+#define FAST_FRAMES             144000          /* 3 s */
+#define SLOW_FRAMES             2880000         /* 60 s */
+#define RELEASE_SHIFT           11              /* the peak limiter lets go with a time constant of 2048 frames, 43 ms */
+#define MAX_FRAMES              1024            /* the most frames processed at once (the feeder's period: 960) */
+
+/* 10^(-n/160), n = 0..47, in Q30: an attenuation of n eighths of a dB, as a factor of amplitude */
+static const uint32_t eighths[48] = {
+	1073741824, 1058400094, 1043277569, 1028371116, 1013677647, 999194121, 984917536, 970844937, 956973408, 943300077,
+	929822112, 916536722, 903441154, 890532697, 877808678, 865266461, 852903448, 840717079, 828704830, 816864213,
+	805192776, 793688102, 782347808, 771169545, 760150998, 749289885, 738583957, 728030996, 717628817, 707375265,
+	697268218, 687305580, 677485290, 667805313, 658263644, 648858308, 639587356, 630448869, 621440953, 612561743,
+	603809400, 595182112, 586678091, 578295576, 570032831, 561888146, 553859832, 545946228,
+};
+#define SIX_DB                  538145694       /* 10^(-6/20) in Q30 */
+
+/* the high-pass filter, 200 Hz at 48 kHz, Q = 1/sqrt(2): b0, b1, b2, a1, a2 in Q30 (RBJ's cookbook) */
+static const int64_t hpf_b0 = 1054047540, hpf_b1 = -2108095079, hpf_b2 = 1054047540;
+static const int64_t hpf_a1 = -2107733822, hpf_a2 = 1034714513;
+
+static struct {
+	bool hpf;
+	uint64_t gain;                          /* the gain before everything, Q30 (1 to 4) */
+	volatile uint32_t attenuation;          /* the amplifiers' level under Android's, eighths of a dB; HAKIOS_GUARD_SILENT: off */
+	volatile uint32_t monitor;              /* the monitor's reduction, eighths of a dB */
+	int64_t x1[2], x2[2], y1[2], y2[2];     /* the filter's past, in 1/256 of a sample */
+	uint64_t rms[2], fast[2], slow[2];      /* average powers at each speaker, Q30 of a full-scale square wave at Android's level */
+	uint64_t level;                         /* the power guard's and the monitor's gain at the end of the last block */
+	uint64_t envelope;                      /* the peak limiter's, 1/65536 of a sample */
+	struct hakios_guard_report report;
+} guard = { .hpf = true, .attenuation = HAKIOS_GUARD_SILENT, .gain = ONE, .level = ONE, .report = { .least_gain = ONE, .least_peak_gain = 65536 } };
+
+static int32_t work[2 * MAX_FRAMES];
+
+/* 10^(-n/160) in Q30: n eighths of a dB under, as a factor of amplitude */
+static uint64_t
+amplitude(uint32_t n)
+{
+	uint64_t value = eighths[n % 48];
+
+	for (uint32_t i = 0; i < n / 48 && value != 0; i++) {
+		value = value * SIX_DB >> 30;
+	}
+	return value;
+}
+
+static uint64_t
+isqrt(uint64_t value)
+{
+	uint64_t root = 0, bit = 1ull << 62;
+
+	while (bit > value) {
+		bit >>= 2;
+	}
+	while (bit != 0) {
+		if (value >= root + bit) {
+			value -= root + bit;
+			root = (root >> 1) + bit;
+		} else {
+			root >>= 1;
+		}
+		bit >>= 2;
+	}
+	return root;
+}
+
+/* how much of `limit' a power is, as the square of the gain that would bring it down to it (Q30, at most 1) */
+static uint64_t
+headroom(uint64_t power, uint64_t limit)
+{
+	if (power <= limit) {
+		return ONE;
+	}
+	return (limit << 30) / power;
+}
+
+void
+hakios_guard_configure(bool hpf, uint32_t gain)
+{
+	guard.hpf = hpf;
+	/* 10^(gain/160): one over the attenuation by as much */
+	guard.gain = (1ull << 60) / amplitude(gain > HAKIOS_GUARD_MAX_GAIN ? HAKIOS_GUARD_MAX_GAIN : gain);
+}
+
+void
+hakios_guard_attenuation(uint32_t below)
+{
+	guard.attenuation = below;
+}
+
+void
+hakios_guard_monitor(uint32_t below)
+{
+	guard.monitor = below;
+}
+
+static void
+block(int16_t *frames, uint32_t count)
+{
+	uint32_t attenuation = guard.attenuation;
+	struct hakios_guard_report *r = &guard.report;
+	/* (2 * attenuation is kept from wrapping in 32 bits: a wrapped value says nothing about the level, and for some it is
+	   a huge one, which makes the power limits see no power at all while the amplifiers are not turned down) */
+	uint64_t to_speaker = attenuation == HAKIOS_GUARD_SILENT ? 0 :
+	    amplitude(attenuation > HAKIOS_GUARD_SILENT / 2 ? HAKIOS_GUARD_SILENT - 1 : 2 * attenuation);
+	uint64_t sum[2] = { 0, 0 }, g2 = ONE, g, start = guard.level, ceiling;
+	uint32_t binding = 0;
+
+	/* the high-pass filter, and what comes out of it: its power, per channel */
+	for (uint32_t i = 0; i < 2 * count; i++) {
+		unsigned c = i & 1;
+		int64_t x = (int64_t)frames[i] * (int64_t)guard.gain >> 22, y;    /* (the gain, and 1/256 of a sample) */
+		uint32_t level = frames[i] < 0 ? (uint32_t)-frames[i] : (uint32_t)frames[i];
+
+		if (level > r->peak_in) {
+			r->peak_in = level;
+		}
+		if (guard.hpf) {
+			y = (hpf_b0 * x + hpf_b1 * guard.x1[c] + hpf_b2 * guard.x2[c] - hpf_a1 * guard.y1[c] - hpf_a2 * guard.y2[c]) >> 30;
+			guard.x2[c] = guard.x1[c];
+			guard.x1[c] = x;
+			guard.y2[c] = guard.y1[c];
+			guard.y1[c] = y;
+		} else {
+			y = x;
+		}
+		work[i] = (int32_t)((y + 128) >> 8);
+		sum[c] += (uint64_t)((int64_t)work[i] * work[i]);
+	}
+
+	/* the averages at the speakers, and the gain that keeps all three under their limits */
+	for (unsigned c = 0; c < 2; c++) {
+		/* the block's power, Q30 of full scale (a square wave at 32768), then as it reaches the speaker */
+		uint64_t power = (uint64_t)((unsigned __int128)(sum[c] / count) * to_speaker >> 30), h;
+
+		guard.rms[c] = (uint64_t)((int64_t)guard.rms[c] + ((int64_t)power - (int64_t)guard.rms[c]) * count / RMS_FRAMES);
+		guard.fast[c] = (uint64_t)((int64_t)guard.fast[c] + ((int64_t)power - (int64_t)guard.fast[c]) * count / FAST_FRAMES);
+		guard.slow[c] = (uint64_t)((int64_t)guard.slow[c] + ((int64_t)power - (int64_t)guard.slow[c]) * count / SLOW_FRAMES);
+		if ((h = headroom(guard.rms[c], amplitude(2 * RMS_LIMIT))) < g2) {
+			g2 = h;
+			binding = 1;
+		}
+		if ((h = headroom(guard.fast[c], amplitude(2 * FAST_LIMIT))) < g2) {
+			g2 = h;
+			binding = 2;
+		}
+		if ((h = headroom(guard.slow[c], amplitude(2 * SLOW_LIMIT))) < g2) {
+			g2 = h;
+			binding = 3;
+		}
+	}
+	g = isqrt(g2 << 30) * amplitude(guard.monitor) >> 30;
+	if (g > ONE) {
+		g = ONE;
+	}
+	r->blocks++;
+	if (binding == 1) {
+		r->rms_blocks++;
+	} else if (binding == 2) {
+		r->fast_blocks++;
+	} else if (binding == 3) {
+		r->slow_blocks++;
+	}
+	if (g < r->least_gain) {
+		r->least_gain = g;
+	}
+
+	/* the peaks: no sample over the limit at the speaker (and none over full scale) */
+	ceiling = FULL_SCALE - 1;
+	if (attenuation != HAKIOS_GUARD_SILENT && attenuation < PEAK_LIMIT) {
+		ceiling = (uint64_t)FULL_SCALE * amplitude(PEAK_LIMIT - attenuation) >> 30;
+	}
+	for (uint32_t f = 0; f < count; f++) {
+		/* (the power guard's gain moves from the last block's to this one's across the block) */
+		uint64_t gain = (uint64_t)((int64_t)start + ((int64_t)g - (int64_t)start) * (int64_t)(f + 1) / (int64_t)count);
+		int64_t y[2];
+		uint64_t level, peak_gain = 65536;
+
+		for (unsigned c = 0; c < 2; c++) {
+			y[c] = (int64_t)work[2 * f + c] * (int64_t)gain >> 30;
+		}
+		level = (uint64_t)(y[0] < 0 ? -y[0] : y[0]);
+		if ((uint64_t)(y[1] < 0 ? -y[1] : y[1]) > level) {
+			level = (uint64_t)(y[1] < 0 ? -y[1] : y[1]);
+		}
+		guard.envelope -= guard.envelope >> RELEASE_SHIFT;
+		if (level << 16 > guard.envelope) {
+			guard.envelope = level << 16;
+		}
+		if (guard.envelope > ceiling << 16) {
+			peak_gain = (ceiling << 32) / guard.envelope;
+			r->limited_frames++;
+			if (peak_gain < r->least_peak_gain) {
+				r->least_peak_gain = (uint32_t)peak_gain;
+			}
+		}
+		for (unsigned c = 0; c < 2; c++) {
+			int64_t out = y[c] * (int64_t)peak_gain >> 16;
+			uint32_t magnitude;
+
+			out = out > FULL_SCALE - 1 ? FULL_SCALE - 1 : out < -FULL_SCALE ? -FULL_SCALE : out;
+			frames[2 * f + c] = (int16_t)out;
+			magnitude = (uint32_t)(out < 0 ? -out : out);
+			if (magnitude > r->peak_out) {
+				r->peak_out = magnitude;
+			}
+		}
+	}
+	guard.level = g;
+	r->gain = g;
+	r->rms = guard.rms[0] > guard.rms[1] ? guard.rms[0] : guard.rms[1];
+	r->fast = guard.fast[0] > guard.fast[1] ? guard.fast[0] : guard.fast[1];
+	r->slow = guard.slow[0] > guard.slow[1] ? guard.slow[0] : guard.slow[1];
+}
+
+void
+hakios_guard_process(int16_t *frames, uint32_t count)
+{
+	while (count > 0) {
+		uint32_t n = count < MAX_FRAMES ? count : MAX_FRAMES;
+
+		block(frames, n);
+		frames += 2 * n;
+		count -= n;
+	}
+}
+
+/* What has happened since the last call (and the averages and the gain as they are now). */
+void
+hakios_guard_take_report(struct hakios_guard_report *report)
+{
+	*report = guard.report;
+	guard.report = (struct hakios_guard_report){ .least_gain = ONE, .least_peak_gain = 65536 };
+}
+
+/* 10 log10 of a Q30 ratio, in tenths of a dB (for what is said) */
+int
+hakios_guard_decibels(uint64_t ratio)
+{
+	static const uint16_t fraction[17] = {
+		0, 5732, 11136, 16248, 21098, 25711, 30109, 34312, 38336, 42196, 45904, 49472, 52911, 56229, 59434, 62534, 65535,
+	};
+	int64_t log2;                           /* Q16 */
+	unsigned top = 63;
+
+	if (ratio == 0) {
+		return -999;
+	}
+	while (!(ratio >> top)) {
+		top--;
+	}
+	{
+		/* the 4 bits under the top one choose a segment, the next 12 where in it */
+		uint64_t mantissa = top >= 16 ? ratio >> (top - 16) : ratio << (16 - top);
+		unsigned index = (unsigned)(mantissa >> 12) & 15, within = (unsigned)mantissa & 4095;
+
+		log2 = ((int64_t)top - 30) * 65536 + fraction[index] + (int64_t)(fraction[index + 1] - fraction[index]) * within / 4096;
+	}
+	return (int)(log2 * 30103 / 65536 / 1000);
+}
diff --git a/bsd/dev/hakios.mic.c b/bsd/dev/hakios.mic.c
new file mode 100644
index 0000000..25a1122
--- /dev/null
+++ b/bsd/dev/hakios.mic.c
@@ -0,0 +1,902 @@
+/*
+ * The Xiaomi Mi 9's (cepheus, SM8150) microphone, through the audio DSP. Everything below is from Android on this
+ * phone: its device tree, its mixer paths (fw/etc/mixer_paths_tavil.xml, "main-mic" = "amic3") and LineageOS'
+ * android_kernel_xiaomi_sm8150 (techpack/audio: asoc/codecs/wcd934x/wcd934x.c, dsp/q6afe.c, dsp/q6adm.c,
+ * dsp/q6asm.c, asoc/sm8150.c). Nothing here happens unless boot-arg mic=N asks for it, with adsp=1
+ * (hakios.adsp.c), which calls hakios_mic_dsp_up() once the DSP's audio services are up.
+ *
+ * The main microphone is AMIC3 of the WCD9340 ("Tavil") codec: MIC BIAS3 feeds it, ADC3 digitizes it, decimator 5
+ * (DEC5) filters it, and its samples leave through the codec's SLIMbus TX port 5 on shared channel 133. The SLIMbus
+ * belongs to the audio DSP; the codec's side of it is brought up by hakios.slim.c (QMI, NGD, MCLK, reset, logical
+ * addresses, chip id, and the codec's TX port on the channel). This file has the codec's microphone registers, the
+ * AFE's SLIMbus port, and a stream the DSP fills with 16-bit linear PCM that /dev/hakios-mic gives to Darwin.
+ *
+ * The codec's path, in the order Android's DAPM powers it (tavil_codec_enable_dec(), tavil_codec_enable_adc(),
+ * tavil_tx_hpf_corner_freq_callback(), tavil_tx_mute_update_callback()):
+ *
+ *   MIC BIAS3   2.7 V (the cepheus overlay's micbias3-mv), then enabled; a millisecond for its charge pump
+ *   AMIC3       the analog hold (ANA_AMIC4 bit 6), the power level Android leaves (default, AMIC3 bits 5-6), the
+ *               ADC's gain 8 (2 dB; the initial mixer state), the ADC on (bit 7)
+ *   the muxes   AMIC MUX5 = ADC3, ADC MUX5 = AMIC, CDC_IF TX5 MUX = DEC5, IIR0 INP0 MUX = DEC5
+ *   DEC5        48 kHz (rate code 4), muted while it powers, the power level from AMIC3, AMIC input, a 150 Hz
+ *               high-pass while it settles, 0 dB
+ *   the DSP     the AFE's SLIMbus port 0x4001 (one channel, shared channel 133, 16 bits, 48 kHz), the ADM device
+ *               path and the ASM stream that is read
+ *
+ * Forty milliseconds after DEC5 comes up it is unmuted; three hundred milliseconds after, the analog hold is
+ * released and DEC5's high-pass is put back where it was, with the codec's one-clock "go" bit (SEC2 bit 1).
+ *
+ *   mic=1    the SLIMbus and the codec brought up (hakios_slim_up()), the microphone's registers looked at; nothing
+ *            written to any of them; then all given back
+ *   mic=2    ... and the microphone's registers written as the path writes them, read back, then put back
+ *   mic=3    ... and the main microphone listened to for mic_secs seconds (default 10, at most 600), each second's
+ *            level in the log, into the recording with rec_sound_mic=1; then all given back
+ *   mic=4    the microphone for Darwin: /dev/hakios-mic, 16-bit samples, one channel, 48 kHz. The path is up only
+ *            while the audio server has the device open; a read never waits, and the reader is kept about 40 ms
+ *            behind the DSP (it comes in 20 ms periods)
+ *
+ * What is asked for is given back at the end, and before the DSP is shut down (hakios_mic_dsp_down()).
+ */
+#include <kern/clock.h>
+#include <kern/locks.h>
+#include <kern/thread.h>
+#include <libkern/libkern.h>
+#include <libkern/OSAtomic.h>
+#include <kern/kalloc.h>
+#include <mach/mach_types.h>
+#include <miscfs/devfs/devfs.h>
+#include <pexpert/pexpert.h>
+#include <sys/conf.h>
+#include <sys/hakios.audio.h>
+#include <sys/systm.h>
+#include <sys/uio.h>
+
+extern kern_return_t thread_terminate(thread_t thread);
+extern void loader_log_putc(char c);
+
+static LCK_GRP_DECLARE(mic_lock_group, "hakios-mic");
+static LCK_MTX_DECLARE(mic_lock, &mic_lock_group);      /* what is asked for, and given back */
+
+static uint32_t level;
+static bool running;
+
+static int say(const char *format, ...) __printflike(1, 2);
+
+static int
+say(const char *format, ...)
+{
+	char line[400];
+	va_list list;
+	int length;
+
+	va_start(list, format);
+	length = vsnprintf(line, sizeof(line), format, list);
+	va_end(list);
+	for (const char *c = line; *c != 0; c++) {
+		loader_log_putc(*c);
+	}
+	printf("%s", line);
+	return length;
+}
+
+/* A line that says all went as it should: not said again in Darwin's later recordings (mic=4), where it is the same each time. */
+static bool quiet;
+#define note(...)       do { if (!quiet) { say(__VA_ARGS__); } } while (0)
+
+static void
+sleep_ms(uint32_t ms)
+{
+	delay_for_interval(ms, NSEC_PER_MSEC);
+}
+
+/* ---- the DSP: the AFE's SLIMbus port, a device path for recording, a stream that is read ------------------ */
+
+#define APR_SVC_AFE                             4
+#define APR_SVC_ASM                             7
+#define APR_SVC_ADM                             8
+#define APR_BASIC_RSP_RESULT                    0x000110e8u
+#define APR_WAIT_MS                             1000
+#define AFE_PORT_CMD_DEVICE_START               0x000100e5u
+#define AFE_PORT_CMD_DEVICE_STOP                0x000100e6u
+#define AFE_PORT_CMD_SET_PARAM_V2               0x000100efu
+#define AFE_MODULE_AUDIO_DEV_INTERFACE          0x0001020cu
+#define AFE_API_VERSION_SLIMBUS_CONFIG          1
+#define AFE_SLIMBUS_DEVICE_1                    0
+#define AFE_PARAM_ID_SLIMBUS_CONFIG             0x00010212u
+#define TX5_PORT                                5               /* the codec's SLIMbus TX port for DEC5 */
+#define TX5_CHANNEL                             133             /* 128 + 5, as msm-dai-q6 and sm8150.c have it */
+#define MIC_PORT                                0x4001          /* AFE_PORT_ID_SLIMBUS_MULTI_CHAN_0_TX (SLIMBUS_0_TX) */
+#define ADM_CMD_DEVICE_OPEN_V5                  0x00010326u
+#define ADM_CMDRSP_DEVICE_OPEN_V5               0x00010329u
+#define ADM_CMD_DEVICE_CLOSE_V5                 0x00010327u
+#define ADM_CMD_MATRIX_MAP_ROUTINGS_V5          0x00010325u
+#define ADM_PATH_LIVE_RECORDING                 2
+#define ADM_MATRIX_AUDIO_TX                     1
+#define ADM_TOPOLOGY_NONE                       0x00010312u
+#define ASM_CMD_SHARED_MEM_MAP_REGIONS          0x00010d92u
+#define ASM_CMDRSP_SHARED_MEM_MAP_REGIONS       0x00010d93u
+#define ASM_CMD_SHARED_MEM_UNMAP_REGIONS        0x00010d94u
+#define ASM_STREAM_CMD_OPEN_READ_V3             0x00010db4u
+#define ASM_STREAM_CMD_SET_ENCDEC_PARAM         0x00010c10u
+#define ASM_PARAM_ID_ENCDEC_ENC_CFG_BLK_V2      0x00010da3u
+#define ASM_SESSION_CMD_RUN_V2                  0x00010daau
+#define ASM_DATA_CMD_READ_V2                    0x00010dacu
+#define ASM_DATA_EVENT_READ_DONE_V2             0x00010d9au
+#define ASM_STREAM_CMD_CLOSE                    0x00010bcdu
+#define ASM_TOPOLOGY_NONE                       0x00010c68u
+#define ASM_MEDIA_FMT_MULTI_CHANNEL_PCM_V2      0x00010da5u
+#define ASM_SHMEM_4K_POOL                       3
+#define MIC_SESSION                             2               /* (the speakers' is 1) */
+#define MIC_STREAM_PORT                         (MIC_SESSION << 8 | 1)
+#define READ_TOKEN                              0x40000000u     /* | the period */
+#define PCM_CHANNEL_FC                          3               /* (the ADM stream's channel map, not the SLIMbus's) */
+#define MIC_RATE                                48000
+#define MIC_PERIODS                             8
+#define MIC_PERIOD_FRAMES                       960             /* 20 ms, one channel of 16 bits */
+#define MIC_PERIOD_BYTES                        (MIC_PERIOD_FRAMES * 2)
+
+static uintptr_t mic_memory;
+static uint64_t mic_address;
+static bool memory_taken, mic_mapped, mic_copp_open, mic_stream_open, mic_port_on;
+static uint32_t mic_map_handle, mic_copp;
+static volatile uint32_t read_ready, read_errors, reads_done;
+static volatile uint32_t read_sizes[MIC_PERIODS];
+
+static bool
+mic_events(uint8_t service, __unused uint16_t port, uint32_t opcode, uint32_t token, const uint32_t *payload, uint32_t length)
+{
+	if (service != APR_SVC_ASM || !(token & READ_TOKEN) || (token & 0x3fffffff) >= MIC_PERIODS) {
+		return false;
+	}
+	if (opcode == ASM_DATA_EVENT_READ_DONE_V2) {
+		if (length < 24 || payload[0] != 0) {
+			OSIncrementAtomic((volatile SInt32 *)&read_errors);
+		}
+		read_sizes[token & 0x3fffffff] = length >= 24 ? payload[4] : 0;
+		OSIncrementAtomic((volatile SInt32 *)&reads_done);
+		OSBitOrAtomic(1u << (token & 31), &read_ready);
+		return true;
+	}
+	if (opcode == APR_BASIC_RSP_RESULT) {
+		OSIncrementAtomic((volatile SInt32 *)&read_errors);
+		OSBitOrAtomic(1u << (token & 31), &read_ready);
+		read_sizes[token & 0x3fffffff] = 0;
+		return true;
+	}
+	return false;
+}
+
+static bool
+mic_read(unsigned period)
+{
+	uint32_t read[5] = { (uint32_t)(mic_address + 4096 * period), (uint32_t)((mic_address + 4096 * period) >> 32),
+		             mic_map_handle, MIC_PERIOD_BYTES, period };
+
+	return hakios_adsp_apr(APR_SVC_ASM, MIC_STREAM_PORT, READ_TOKEN | period, ASM_DATA_CMD_READ_V2, read, sizeof(read), 0, NULL);
+}
+
+struct afe_param {
+	uint32_t module, param;
+	uint16_t size, reserved;
+} __attribute__((packed));
+
+static const char *
+dsp_error(uint32_t status)
+{
+	static const char *const names[] = { "ok", "failed", "bad parameter", "unsupported", "version", "unexpected", "panic",
+		                             "no resource", "bad handle", "already", "not ready", "pending", "busy", "aborted",
+		                             "preempted", "continue", "immediate", "not implemented", "need more", "no memory",
+		                             "not there" };
+
+	return status < sizeof(names) / sizeof(names[0]) ? names[status] : "an error this does not know";
+}
+
+static bool
+command(const char *what, uint8_t service, uint32_t opcode, const void *payload, uint32_t length, uint32_t wanted,
+    struct hakios_apr_answer *answer)
+{
+	struct hakios_apr_answer local;
+
+	if (answer == NULL) {
+		answer = &local;
+	}
+	if (!hakios_adsp_apr(service, 0, 0, opcode, payload, length, APR_WAIT_MS, answer)) {
+		say("mic: %s (opcode %#x): NO ANSWER\n", what, opcode);
+		return false;
+	}
+	if (answer->opcode == APR_BASIC_RSP_RESULT && answer->words[0] == opcode) {
+		if (answer->words[1] == 0) {
+			note("mic: %s: done\n", what);
+		} else {
+			say("mic: %s: REFUSED: %s\n", what, dsp_error(answer->words[1]));
+		}
+		return answer->words[1] == 0 && wanted == 0;
+	}
+	if (wanted != 0 && answer->opcode == wanted) {
+		return true;
+	}
+	say("mic: %s: an answer not expected: opcode %#x, %u bytes: %#x %#x\n", what, answer->opcode, answer->length,
+	    answer->words[0], answer->words[1]);
+	return false;
+}
+
+static bool
+afe_port_param(uint32_t module, uint32_t param, const void *data, uint16_t size, const char *what)
+{
+	uint8_t packet[16 + sizeof(struct afe_param) + 64];
+	struct afe_param *p = (struct afe_param *)(packet + 16);
+
+	bzero(packet, sizeof(packet));
+	*(uint16_t *)packet = MIC_PORT;
+	*(uint16_t *)(packet + 2) = (uint16_t)(sizeof(*p) + size);
+	p->module = module;
+	p->param = param;
+	p->size = size;
+	memcpy(packet + 16 + sizeof(*p), data, size);
+	return command(what, APR_SVC_AFE, AFE_PORT_CMD_SET_PARAM_V2, packet, 16 + (uint32_t)sizeof(*p) + size, 0, NULL);
+}
+
+/* the stream and the path, opened, mapped and routed (msm-pcm-q6 and q6adm/q6asm at a recording's open and prepare) */
+static bool
+dsp_path_on(void)
+{
+	struct {
+		uint16_t pool, regions;
+		uint32_t property, low, high, size;
+	} __attribute__((packed)) map = { ASM_SHMEM_4K_POOL, 1, 0, 0, 0, 0 };
+	struct {
+		uint16_t flags, mode, endpoint1, endpoint2;
+		uint32_t topology;
+		uint16_t channels, bits;
+		uint32_t rate;
+		uint8_t map[8];
+	} __attribute__((packed)) open = { 0, ADM_PATH_LIVE_RECORDING, MIC_PORT, 0xffff, ADM_TOPOLOGY_NONE, 1, 16, MIC_RATE,
+		                           { PCM_CHANNEL_FC } };
+	struct {
+		uint32_t mode, endpoint, topology, format;
+		uint16_t bits, reserved;
+	} __attribute__((packed)) reading = { 0, 0, ASM_TOPOLOGY_NONE, ASM_MEDIA_FMT_MULTI_CHANNEL_PCM_V2, 16, 0 };
+	struct {
+		uint32_t param, size, frames_per_buffer, block_size;
+		uint16_t channels, bits;
+		uint32_t rate;
+		uint16_t is_signed, reserved;
+		uint8_t map[8];
+	} __attribute__((packed)) encoder = { ASM_PARAM_ID_ENCDEC_ENC_CFG_BLK_V2, 28, 0, 20, 1, 16, MIC_RATE, 1, 0, { PCM_CHANNEL_FC } };
+	struct {
+		uint32_t matrix, sessions;
+		uint16_t session, copps;
+		uint16_t copp[2];
+	} __attribute__((packed)) route = { ADM_MATRIX_AUDIO_TX, 1, MIC_SESSION, 1, { 0, 0 } };
+	struct hakios_apr_answer answer;
+	uint32_t bytes = 0;
+
+	if (!hakios_audio_dsp_memory(&mic_memory, &mic_address, &bytes) || bytes < MIC_PERIODS * 4096) {
+		say("mic: no memory the DSP can see\n");
+		return false;
+	}
+	memory_taken = true;
+	map.low = (uint32_t)mic_address;
+	map.high = (uint32_t)(mic_address >> 32);
+	map.size = MIC_PERIODS * 4096;
+	hakios_adsp_apr_events_second(mic_events);
+	if (!command("our periods for the microphone, mapped for the DSP", APR_SVC_ASM, ASM_CMD_SHARED_MEM_MAP_REGIONS, &map,
+	    sizeof(map), ASM_CMDRSP_SHARED_MEM_MAP_REGIONS, &answer)) {
+		return false;
+	}
+	mic_mapped = true;
+	mic_map_handle = answer.words[0];
+	say("mic: our %u KB at %#llx are the DSP's handle %#x\n", MIC_PERIODS * 4, mic_address, mic_map_handle);
+	if (!hakios_adsp_apr(APR_SVC_ASM, MIC_STREAM_PORT, 0, ASM_STREAM_CMD_OPEN_READ_V3, &reading, sizeof(reading), APR_WAIT_MS,
+	    &answer) || answer.opcode != APR_BASIC_RSP_RESULT || answer.words[1] != 0) {
+		say("mic: the stream, opened for reading: %s (%#x %#x)\n", "REFUSED OR NO ANSWER", answer.opcode, answer.words[1]);
+		return false;
+	}
+	mic_stream_open = true;
+	say("mic: the stream (session 2), opened for reading 16-bit linear PCM, no processing: done\n");
+	if (!hakios_adsp_apr(APR_SVC_ASM, MIC_STREAM_PORT, 0, ASM_STREAM_CMD_SET_ENCDEC_PARAM, &encoder, sizeof(encoder), APR_WAIT_MS,
+	    &answer) || answer.opcode != APR_BASIC_RSP_RESULT || answer.words[1] != 0) {
+		say("mic: the stream's format: REFUSED OR NO ANSWER (%#x %#x)\n", answer.opcode, answer.words[1]);
+		return false;
+	}
+	say("mic: the stream's format: 1 channel of 16 bits at 48 kHz: done\n");
+	if (!hakios_adsp_apr(APR_SVC_ADM, MIC_PORT, 0, ADM_CMD_DEVICE_OPEN_V5, &open, sizeof(open), APR_WAIT_MS, &answer) ||
+	    answer.opcode != ADM_CMDRSP_DEVICE_OPEN_V5 || answer.words[0] != 0) {
+		say("mic: a device path from the port: REFUSED OR NO ANSWER (%#x %#x)\n", answer.opcode, answer.words[0]);
+		return false;
+	}
+	mic_copp_open = true;
+	mic_copp = answer.words[1] & 0xffff;
+	route.copp[0] = (uint16_t)mic_copp;
+	say("mic: the device path from port %#x is open: COPP %u (live recording, no processing, 1 channel, 16 bits, 48 kHz)\n",
+	    MIC_PORT, mic_copp);
+	return command("the device path routed to session 2", APR_SVC_ADM, ADM_CMD_MATRIX_MAP_ROUTINGS_V5, &route, sizeof(route), 0,
+	           NULL);
+}
+
+/* the AFE's SLIMbus port: SLIM_0_TX, one channel of 16 bits at 48 kHz, on shared channel 133 (TX5's) */
+static bool
+dsp_port_on(void)
+{
+	struct {
+		uint32_t version;
+		uint16_t device, bits, format, channels;
+		uint8_t map[8];
+		uint32_t rate;
+	} __attribute__((packed)) config = { AFE_API_VERSION_SLIMBUS_CONFIG, AFE_SLIMBUS_DEVICE_1, 16, 0, 1, { 0 }, MIC_RATE };
+	uint16_t start[2] = { MIC_PORT, 0 };
+
+	config.map[0] = TX5_CHANNEL;
+	if (!afe_port_param(AFE_MODULE_AUDIO_DEV_INTERFACE, AFE_PARAM_ID_SLIMBUS_CONFIG, &config, sizeof(config),
+	    "the port SLIM_0_TX (0x4001): 1 channel (133) of 16 bits at 48 kHz")) {
+		return false;
+	}
+	mic_port_on = command("the port 0x4001, started", APR_SVC_AFE, AFE_PORT_CMD_DEVICE_START, start, sizeof(start), 0, NULL);
+	return mic_port_on;
+}
+
+static void
+dsp_off(void)
+{
+	uint16_t stop[2] = { MIC_PORT, 0 };
+
+	if (mic_stream_open) {
+		(void)hakios_adsp_apr(APR_SVC_ASM, MIC_STREAM_PORT, 0, ASM_STREAM_CMD_CLOSE, NULL, 0, APR_WAIT_MS, NULL);
+		say("mic: the stream, closed\n");
+		mic_stream_open = false;
+	}
+	if (mic_copp_open) {
+		(void)hakios_adsp_apr(APR_SVC_ADM, (uint16_t)mic_copp, 0, ADM_CMD_DEVICE_CLOSE_V5, NULL, 0, APR_WAIT_MS, NULL);
+		say("mic: the device path, closed\n");
+		mic_copp_open = false;
+	}
+	if (mic_port_on) {
+		(void)command("the port 0x4001, stopped", APR_SVC_AFE, AFE_PORT_CMD_DEVICE_STOP, stop, sizeof(stop), 0, NULL);
+		mic_port_on = false;
+	}
+	if (mic_mapped) {
+		(void)command("our periods, unmapped", APR_SVC_ASM, ASM_CMD_SHARED_MEM_UNMAP_REGIONS, &mic_map_handle,
+		    sizeof(mic_map_handle), 0, NULL);
+		mic_mapped = false;
+	}
+	hakios_adsp_apr_events_second(NULL);
+	if (memory_taken) {
+		hakios_audio_dsp_memory_put();
+		memory_taken = false;
+	}
+}
+
+/* ---- the codec: MIC BIAS3 -> AMIC3 -> ADC3 -> DEC5 -> TX5 (hakios.slim.c has the bus and the port) ---------- */
+
+#define ANA_AMIC3                               0x0610          /* bits 7 ADC on, 5-6 power level, 0-4 gain */
+#define ANA_AMIC4                               0x0611          /* bit 6: the analog hold */
+#define ANA_MICB3                               0x0625          /* bits 6-7 on, 0-5 vout */
+#define TX5_PATH_CTL                            0x0a81          /* bits 0-3 rate, 4 mute */
+#define TX5_PATH_CFG0                           0x0a82          /* bits 1-2 power level, 5-6 high-pass, 7 AMIC */
+#define TX5_VOL_CTL                             0x0a84
+#define TX5_PATH_SEC2                           0x0a89          /* bit 1: the high-pass' go bit */
+#define AMIC_MUX5                               0x0d27          /* bits 0-2: ADC3 */
+#define ADC_MUX5                                0x0d20          /* bits 2-3: AMIC */
+#define IIR0_INP0_MUX                           0x0d31          /* bits 0-4: DEC5 */
+#define CDC_IF_TX5_MUX                          0x0d3b          /* bits 2-3: DEC5 */
+#define MICB_2700MV                             0x22            /* (2700 - 1000) / 50: the cepheus overlay's micbias3 */
+#define AMIC3_GAIN                              0x08            /* "ADC3 Volume 8" (2 dB) of the initial mixer state */
+#define TX_UNMUTE_MS                            40              /* WCD934X_TX_UNMUTE_DELAY_MS */
+#define TX_SETTLE_MS                            300             /* the high-pass work of tavil_tx_hpf_corner_freq_callback() */
+
+static bool mic_ready;
+static uint8_t dec5_hpf;                        /* CFG0 bits 5-6 as the path found them */
+
+static bool
+codec_update(const char *what, uint16_t reg, uint8_t mask, uint8_t value)
+{
+	if (!hakios_slim_codec_update(reg, mask, value)) {
+		say("mic: %s: the codec's %#06x was not written\n", what, reg);
+		return false;
+	}
+	note("mic: %s (%#06x, mask %#04x): done\n", what, reg, mask);
+	return true;
+}
+
+/*
+ * The codec's microphone path, as tavil_codec_enable_dec()/adc() power it for Android's "main-mic": MIC BIAS3 at
+ * 2.7 V, AMIC3 into ADC3, DEC5 from AMIC, TX5 from DEC5. It comes up muted and with a 150 Hz high-pass; forty
+ * milliseconds later it is unmuted, and three hundred milliseconds later the hold is released and the high-pass put
+ * back. False if a register was not written (nothing more is attempted).
+ */
+static bool
+mic_on(void)
+{
+	uint8_t cfg0 = 0;
+
+	if (mic_ready) {
+		return true;
+	}
+	if (!hakios_slim_codec_read(TX5_PATH_CFG0, &cfg0)) {
+		say("mic: DEC5's configuration cannot be read\n");
+		return false;
+	}
+	dec5_hpf = (uint8_t)((cfg0 >> 5) & 0x03);
+	/*
+	 * (from here on the path has to be given back even if a write fails: mic_off() turns off whatever was turned on, so
+	 * the bias and the ADC are not left running)
+	 */
+	mic_ready = true;
+
+	/* MIC BIAS3 2.7 V, then its charge pump; a millisecond, as __tavil_codec_enable_micbias() waits */
+	if (!codec_update("MIC BIAS3, 2.7 V", ANA_MICB3, 0x3f, MICB_2700MV) ||
+	    !codec_update("MIC BIAS3, on", ANA_MICB3, 0xc0, 0x40)) {
+		return false;
+	}
+	sleep_ms(1);
+
+	/* ADC3 on AMIC3: the analog hold, the default power level, the gain Android's initial state has, the ADC on */
+	if (!codec_update("AMIC3, the analog hold", ANA_AMIC4, 0x40, 0x40) ||
+	    !codec_update("AMIC3, the default power level", ANA_AMIC3, 0x60, 0x20) ||
+	    !codec_update("AMIC3, gain 8", ANA_AMIC3, 0x1f, AMIC3_GAIN) ||
+	    !codec_update("ADC3, on", ANA_AMIC3, 0x80, 0x80)) {
+		return false;
+	}
+
+	/* the routes of Android's "main-mic" (and its IIR, which sees DEC5) */
+	if (!codec_update("AMIC MUX5 = ADC3", AMIC_MUX5, 0x07, 0x03) ||
+	    !codec_update("ADC MUX5 = AMIC", ADC_MUX5, 0x0c, 0x04) ||
+	    !codec_update("CDC_IF TX5 = DEC5", CDC_IF_TX5_MUX, 0x0c, 0x08) ||
+	    !codec_update("IIR0 INP0 = DEC5", IIR0_INP0_MUX, 0x1f, 0x06)) {
+		return false;
+	}
+
+	/* DEC5: 48 kHz, the default power level, AMIC input, a 150 Hz high-pass, 0 dB, muted, then its supply */
+	if (!codec_update("DEC5, 48 kHz", TX5_PATH_CTL, 0x0f, 0x04) ||
+	    !codec_update("DEC5, the default power level", TX5_PATH_CFG0, 0x06, 0x00) ||
+	    !codec_update("DEC5, the AMIC input", TX5_PATH_CFG0, 0x80, 0x00) ||
+	    !codec_update("DEC5, a 150 Hz high-pass", TX5_PATH_CFG0, 0x60, 0x40) ||
+	    !codec_update("DEC5, 0 dB", TX5_VOL_CTL, 0xff, 0x00) ||
+	    !codec_update("DEC5, muted", TX5_PATH_CTL, 0x10, 0x10) ||
+	    !codec_update("DEC5, the ADC MUX5 supply", TX5_PATH_CTL, 0x20, 0x20)) {
+		return false;
+	}
+
+	/* the decimator unmuted after forty milliseconds, its gain applied as POST_PMU does */
+	sleep_ms(TX_UNMUTE_MS);
+	if (!codec_update("DEC5, unmuted", TX5_PATH_CTL, 0x10, 0x00) ||
+	    !codec_update("DEC5, its gain applied", TX5_VOL_CTL, 0xff, 0x00)) {
+		return false;
+	}
+
+	/* and at three hundred milliseconds the analog hold released and the high-pass put back, with the go bit */
+	sleep_ms(TX_SETTLE_MS - TX_UNMUTE_MS);
+	if (!codec_update("AMIC3, the hold released", ANA_AMIC4, 0x40, 0x00) ||
+	    !codec_update("DEC5, the high-pass it had", TX5_PATH_CFG0, 0x60, (uint8_t)(dec5_hpf << 5)) ||
+	    !codec_update("DEC5, the high-pass applied", TX5_PATH_SEC2, 0x02, 0x02)) {
+		return false;
+	}
+	sleep_ms(1);
+	return codec_update("DEC5, the high-pass' go bit cleared", TX5_PATH_SEC2, 0x02, 0x00);
+}
+
+/* The path powered down: muted first, then the routes, the ADC and its bias. Nothing is waited for. */
+static void
+mic_off(void)
+{
+	if (!mic_ready) {
+		return;
+	}
+	mic_ready = false;
+	(void)codec_update("DEC5, muted", TX5_PATH_CTL, 0x10, 0x10);
+	(void)codec_update("DEC5, the ADC MUX5 supply off", TX5_PATH_CTL, 0x20, 0x00);
+	(void)codec_update("DEC5, the default power level", TX5_PATH_CFG0, 0x06, 0x00);
+	(void)codec_update("CDC_IF TX5 = ZERO", CDC_IF_TX5_MUX, 0x0c, 0x00);
+	(void)codec_update("AMIC MUX5 = ZERO", AMIC_MUX5, 0x07, 0x00);
+	(void)codec_update("ADC MUX5 = DMIC", ADC_MUX5, 0x0c, 0x00);
+	(void)codec_update("IIR0 INP0 = ZERO", IIR0_INP0_MUX, 0x1f, 0x00);
+	(void)codec_update("AMIC3, the hold released", ANA_AMIC4, 0x40, 0x00);
+	(void)codec_update("ADC3, off", ANA_AMIC3, 0x80, 0x00);
+	(void)codec_update("MIC BIAS3, off", ANA_MICB3, 0xc0, 0x00);
+}
+
+/* mic=1/2: what the codec's registers hold (and, at 2, what the path's writes leave) */
+static void
+mic_look(void)
+{
+	static const struct {
+		uint16_t reg;
+		const char *name;
+	} regs[] = {
+		{ ANA_AMIC3, "ANA_AMIC3" }, { ANA_AMIC4, "ANA_AMIC4" }, { ANA_MICB3, "ANA_MICB3" },
+		{ TX5_PATH_CTL, "TX5_PATH_CTL" }, { TX5_PATH_CFG0, "TX5_PATH_CFG0" }, { TX5_VOL_CTL, "TX5_VOL_CTL" },
+		{ TX5_PATH_SEC2, "TX5_PATH_SEC2" }, { ADC_MUX5, "ADC MUX5" }, { AMIC_MUX5, "AMIC MUX5" },
+		{ IIR0_INP0_MUX, "IIR0 INP0 MUX" }, { CDC_IF_TX5_MUX, "CDC_IF TX5 MUX" },
+	};
+
+	for (unsigned i = 0; i < sizeof(regs) / sizeof(regs[0]); i++) {
+		uint8_t value = 0;
+
+		if (hakios_slim_codec_read(regs[i].reg, &value)) {
+			say("mic: %-16s %#06x = %#04x\n", regs[i].name, regs[i].reg, value);
+		}
+	}
+	say("mic: the codec's generic device %#x, its interface device %#x; TX%d is SLIMbus channel %u\n",
+	    hakios_slim_generic_la(), hakios_slim_interface_la(), TX5_PORT, TX5_CHANNEL);
+}
+
+static bool tx_on;
+
+/* Everything up to the stream's run, in a recording's order; false if any of it fails. */
+static bool
+path_up(void)
+{
+	if (!hakios_slim_up()) {
+		say("mic: the SLIMbus and the codec could not be brought up\n");
+		return false;
+	}
+	/* (the DSP's side first, as Android's is: the port is started before the codec's TX port joins its channel) */
+	if (!dsp_path_on() || !dsp_port_on()) {
+		return false;
+	}
+	if (!mic_on()) {
+		return false;
+	}
+	if (!hakios_slim_tx_on(TX5_PORT, TX5_CHANNEL)) {
+		return false;
+	}
+	tx_on = true;
+	return true;
+}
+
+static void
+undo(void)
+{
+	dsp_off();
+	if (tx_on) {
+		hakios_slim_tx_off(TX5_PORT, TX5_CHANNEL);
+		tx_on = false;
+	}
+	mic_off();
+	hakios_slim_down();
+}
+
+/* ---- mic=4: the microphone for Darwin ------------------------------------------------------------------- */
+
+/*
+ * What the microphone hears goes into a ring, and /dev/hakios-mic gives it to Darwin's audio server
+ * (HakiosAudio.driver's device "Codec", userland/src/audio_plugin.c): 16-bit samples, one channel,
+ * 48 kHz. The path is up only while the device is open (the audio server opens it when its input
+ * starts and closes it when it stops), and a read never waits: it gives what has come, keeping the
+ * reader about 40 ms behind the DSP (it comes in 20 ms periods), and nothing until that much is
+ * there; the audio server makes up the rest with silence.
+ */
+#define RING_FRAMES             16384           /* 341 ms; a power of two */
+#define RING_KEEP               1920            /* 40 ms: how far behind the DSP a reader is kept */
+#define RING_MOST               4800            /* 100 ms: more than this waiting, and the oldest is skipped */
+
+static int16_t *ring;
+static volatile uint64_t ring_written;          /* frames put into the ring since the device was made */
+static uint64_t ring_read;                      /* frames taken from it (one reader: the audio server) */
+static bool ring_primed;                        /* the reader is RING_KEEP behind; false after it ran dry */
+static uint64_t ring_skipped, ring_dry;         /* frames skipped, reads that found too little: said when Darwin stops */
+static volatile uint32_t darwin_wants;             /* the device is open */
+static volatile bool stopping;                  /* the run ends (hakios_mic_dsp_down()) */
+
+static void
+ring_put(const int16_t *samples, uint32_t count)
+{
+	uint64_t at = ring_written;
+
+	for (uint32_t i = 0; i < count; i++) {
+		ring[(at + i) % RING_FRAMES] = samples[i];
+	}
+	__atomic_store_n(&ring_written, at + count, __ATOMIC_RELEASE);
+}
+
+static int
+mic_dev_read(__unused dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	uint64_t written = __atomic_load_n(&ring_written, __ATOMIC_ACQUIRE), avail, want;
+	int error = 0;
+
+	if (ring == NULL || uio_resid(uio) < 2) {
+		return 0;
+	}
+	want = (uint64_t)uio_resid(uio) / 2;
+	avail = written - ring_read;
+	if (avail > RING_MOST) {
+		ring_skipped += avail - RING_KEEP;
+		ring_read = written - RING_KEEP;
+		avail = RING_KEEP;
+	}
+	if (!ring_primed) {
+		if (avail < RING_KEEP) {
+			return 0;
+		}
+		ring_primed = true;
+	}
+	if (avail < want) {
+		ring_dry++;
+		ring_primed = false;
+	}
+	while (want > 0 && avail > 0 && error == 0) {
+		uint64_t at = ring_read % RING_FRAMES, n = want < avail ? want : avail;
+
+		n = n < RING_FRAMES - at ? n : RING_FRAMES - at;
+		error = uiomove((caddr_t)&ring[at], (int)(n * 2), uio);
+		ring_read += n;
+		want -= n;
+		avail -= n;
+	}
+	return error;
+}
+
+static int
+mic_dev_open(__unused dev_t dev, __unused int flags, __unused int type, __unused struct proc *p)
+{
+	darwin_wants = 1;
+	return 0;
+}
+
+/* (on the last close) */
+static int
+mic_dev_close(__unused dev_t dev, __unused int flags, __unused int type, __unused struct proc *p)
+{
+	darwin_wants = 0;
+	return 0;
+}
+
+static const struct cdevsw mic_cdevsw = {
+	.d_open = mic_dev_open, .d_close = mic_dev_close, .d_read = mic_dev_read, .d_write = eno_rdwrt,
+	.d_ioctl = eno_ioctl, .d_stop = eno_stop, .d_reset = eno_reset, .d_select = eno_select,
+	.d_mmap = eno_mmap, .d_strategy = eno_strat, .d_type = 0
+};
+
+/* ---- listening ---------------------------------------------------------------------------------------------- */
+
+static uint32_t mic_secs = 10;
+
+/*
+ * The stream run, read for mic_secs (for_darwin: while Darwin has the device open): how loud it is, every
+ * second (for Darwin: the first three, then every 30th); into the recording with rec_sound_mic=1; for
+ * Darwin into the ring. False if it could not get going (the run refused, a read not sent, no read ever came
+ * back); for_darwin() counts that as a recording that broke off.
+ */
+static bool
+listen(bool for_darwin)
+{
+	uint32_t run[3] = { 0, 0, 0 }, frames = 0, seconds = 0, peak = 0, periods = 0, empty = 0;
+	int64_t sum = 0;
+	uint64_t squares = 0;
+	unsigned next = 0;
+	uint64_t began = mach_absolute_time(), now, elapsed_ms;
+
+	struct hakios_apr_answer answer;
+
+	read_ready = 0;
+	reads_done = read_errors = 0;
+	if (!hakios_adsp_apr(APR_SVC_ASM, MIC_STREAM_PORT, 0, ASM_SESSION_CMD_RUN_V2, run, sizeof(run), APR_WAIT_MS, &answer) ||
+	    answer.opcode != APR_BASIC_RSP_RESULT || answer.words[1] != 0) {
+		say("mic: the session, run: REFUSED OR NO ANSWER (%#x %#x)\n", answer.opcode, answer.words[1]);
+		return false;
+	}
+	say("mic: the session 2, run: done\n");
+	for (unsigned p = 0; p < MIC_PERIODS; p++) {
+		if (!mic_read(p)) {
+			say("mic: a read could not be sent\n");
+			return false;
+		}
+	}
+	if (for_darwin) {
+		say("mic: LISTENING for Darwin: %u reads of 20 ms given to the DSP\n", MIC_PERIODS);
+	} else {
+		say("mic: LISTENING: %u reads of 20 ms given to the DSP; for %u s\n", MIC_PERIODS, mic_secs);
+	}
+	for (;;) {
+		absolutetime_to_nanoseconds(mach_absolute_time() - began, &now);
+		elapsed_ms = now / NSEC_PER_MSEC;
+		/* (`stopping' ends every kind of run: hakios_mic_dsp_down() waits for mic_lock, which is held until this returns) */
+		if ((for_darwin ? !darwin_wants : elapsed_ms >= mic_secs * 1000ull) || stopping) {
+			break;
+		}
+		if (!(read_ready & (1u << next))) {
+			if (elapsed_ms > 1500 && reads_done == 0) {
+				say("mic: NO READ HAS COME BACK in 1.5 s\n");
+				return false;
+			}
+			sleep_ms(2);
+			continue;
+		}
+		OSBitAndAtomic(~(1u << next), &read_ready);
+		{
+			int16_t *samples = (int16_t *)(mic_memory + 4096 * next);
+			uint32_t got = read_sizes[next] / 2;
+			int16_t stereo[2 * 240];
+
+			for (vm_offset_t line = (vm_offset_t)samples; line < (vm_offset_t)samples + MIC_PERIOD_BYTES; line += 64) {
+				__asm__ volatile ("dc ivac, %0" : : "r" (line));
+			}
+			__asm__ volatile ("dsb sy");
+			got = got > MIC_PERIOD_FRAMES ? MIC_PERIOD_FRAMES : got;
+			empty += got == 0;
+			for (uint32_t i = 0; i < got; i++) {
+				int32_t v = samples[i];
+				uint32_t a = (uint32_t)(v < 0 ? -v : v);
+
+				sum += v;
+				squares += (uint64_t)((int64_t)v * v);
+				peak = a > peak ? a : peak;
+			}
+			frames += got;
+			if (for_darwin) {
+				ring_put(samples, got);
+			}
+			if (hakios_audio_recording_mic()) {
+				for (uint32_t i = 0; i < got; i += 240) {
+					uint32_t n = got - i < 240 ? got - i : 240;
+
+					for (uint32_t j = 0; j < n; j++) {
+						stereo[2 * j] = stereo[2 * j + 1] = samples[i + j];
+					}
+					hakios_audio_record_fed(stereo, n);
+				}
+			}
+		}
+		periods++;
+		(void)mic_read(next);
+		next = (next + 1) % MIC_PERIODS;
+		if (frames >= MIC_RATE) {
+			uint64_t mean_square = squares / frames;
+			uint32_t rms = 0;
+			int db10 = -999;
+
+			while ((uint64_t)(rms + 1) * (rms + 1) <= mean_square) {
+				rms++;
+			}
+			if (rms > 0) {
+				/* 20 log10(rms / 32768), in tenths, by a table of halvings: good enough to tell loud from quiet */
+				uint32_t r = rms;
+				int tenths = 0;
+
+				while (r < 16384) {
+					r *= 2;
+					tenths -= 60;   /* 6.02 dB a halving, near enough */
+				}
+				db10 = tenths - (int)((32768 - r) * 60 / 16384);
+			}
+			seconds++;
+			if (!for_darwin || seconds <= 3 || seconds % 30 == 0) {
+				say("mic: second %u: %u frames (%u periods, %u empty), level %d.%d dBFS (rms %u), peak %u, mean %lld; "
+				    "reads %u, errors %u\n", seconds, frames, periods, empty, db10 / 10, db10 < 0 ? -db10 % 10 : db10 % 10,
+				    rms, peak, sum / (int64_t)frames, reads_done, read_errors);
+			}
+			frames = periods = empty = peak = 0;
+			sum = 0;
+			squares = 0;
+		}
+	}
+	return true;
+}
+
+/*
+ * mic=4: the path up whenever Darwin opens /dev/hakios-mic, down when it closes it; after three
+ * recordings that broke off, no more until the run ends.
+ */
+static void
+for_darwin(void)
+{
+	int major = cdevsw_add(-1, &mic_cdevsw);
+	unsigned recordings = 0, failures = 0;
+
+	ring = kalloc_data(RING_FRAMES * sizeof(int16_t), Z_WAITOK | Z_ZERO);
+	if (ring == NULL || major < 0 ||
+	    devfs_make_node(makedev(major, 0), DEVFS_CHAR, UID_ROOT, GID_WHEEL, 0666, "hakios-mic") == NULL) {
+		say("mic: /dev/hakios-mic cannot be made\n");
+		return;
+	}
+	say("mic: THE MICROPHONE IS DARWIN'S (/dev/hakios-mic) from here on, until the run ends: it listens only while Darwin records\n");
+	while (!stopping) {
+		uint64_t began, ns;
+		bool failed, up;
+
+		if (!darwin_wants) {
+			sleep_ms(20);
+			continue;
+		}
+		lck_mtx_lock(&mic_lock);
+		if (stopping) {
+			lck_mtx_unlock(&mic_lock);
+			break;
+		}
+		recordings++;
+		quiet = recordings > 1;
+		ring_primed = false;
+		ring_skipped = ring_dry = 0;
+		ring_read = __atomic_load_n(&ring_written, __ATOMIC_ACQUIRE);
+		began = mach_absolute_time();
+		say("mic: Darwin records (%u): the path up%s\n", recordings, quiet ? " (the lines that say all went well are not said again)" :
+		    "");
+		/*
+		 * (a bring-up or a start that fails counts as a failure too: otherwise the three-recordings limit below never
+		 * applies and, while Darwin keeps the device open, the path is brought up and undone for ever)
+		 */
+		up = path_up() && listen(true);
+		failed = !up;
+		absolutetime_to_nanoseconds(mach_absolute_time() - began, &ns);
+		say("mic: Darwin's recording %u %s after %llu.%llu s; %llu frames skipped as too late, %llu reads found too little\n",
+		    recordings, failed ? "BROKE OFF" : "ended", ns / NSEC_PER_SEC, ns % NSEC_PER_SEC / (NSEC_PER_SEC / 10),
+		    ring_skipped, ring_dry);
+		undo();
+		lck_mtx_unlock(&mic_lock);
+		if (failed) {
+			if (++failures >= 3) {
+				say("mic: three recordings broke off: the microphone stays off until the run ends\n");
+				break;
+			}
+			/* (not again until Darwin has closed the device and opened it again) */
+			while (darwin_wants && !stopping) {
+				sleep_ms(20);
+			}
+		}
+	}
+}
+
+static void
+mic_thread(__unused void *parameter, __unused wait_result_t result)
+{
+	say("mic: level %u: %s\n", level, level == 1 ? "a look, after the SLIMbus and the codec are up; nothing written to the microphone" :
+	    level == 2 ? "the microphone's registers written as Android's path writes them, read back; then all undone" :
+	    level == 3 ? "the main microphone, as Android records from it, listened to; then all undone" :
+	    "the main microphone for Darwin (/dev/hakios-mic), up while Darwin records");
+	if (level == 4) {
+		for_darwin();
+	} else {
+		lck_mtx_lock(&mic_lock);
+		if (level <= 2) {
+			if (hakios_slim_up()) {
+				if (level >= 2 && !mic_on()) {
+					say("mic: the microphone's registers were not all written\n");
+				}
+				sleep_ms(10);
+				mic_look();
+				mic_off();
+			}
+			hakios_slim_down();
+		} else {
+			if (path_up()) {
+				listen(false);
+			}
+			undo();
+		}
+		lck_mtx_unlock(&mic_lock);
+	}
+	running = false;
+	say("mic: done\n");
+	thread_terminate(current_thread());
+}
+
+void
+hakios_mic_dsp_up(void)
+{
+	thread_t thread;
+
+	if (!PE_parse_boot_argn("mic", &level, sizeof(level)) || level == 0) {
+		return;
+	}
+	level = level > 4 ? 4 : level;
+	PE_parse_boot_argn("mic_secs", &mic_secs, sizeof(mic_secs));
+	mic_secs = mic_secs < 1 ? 1 : mic_secs > 600 ? 600 : mic_secs;
+	running = true;
+	if (kernel_thread_start(mic_thread, NULL, &thread) != KERN_SUCCESS) {
+		running = false;
+		return;
+	}
+	thread_deallocate(thread);
+}
+
+void
+hakios_mic_dsp_down(void)
+{
+	stopping = true;
+	if (running) {
+		lck_mtx_lock(&mic_lock);
+		undo();
+		lck_mtx_unlock(&mic_lock);
+	}
+}
diff --git a/bsd/dev/hakios.slim.c b/bsd/dev/hakios.slim.c
new file mode 100644
index 0000000..1064d15
--- /dev/null
+++ b/bsd/dev/hakios.slim.c
@@ -0,0 +1,1480 @@
+/*
+ * The SLIMbus of the Xiaomi Mi 9 (cepheus, SM8150), and the codec behind it: the WCD9340 ("Tavil") the microphones
+ * (hakios.mic.c) and the earpiece are on. The earpiece (the receiver at the top) is driven by the codec's EAR output;
+ * its registers and samples go over the SoC's SLIMbus. The bus belongs to the audio DSP (it is its "master"), and the
+ * application processor has a "non-ported generic device" on it (NGD), through which it sends and receives messages.
+ * Before the NGD's registers may be touched, the DSP is asked over QMI to power the bus (Linux: drivers/slimbus/
+ * slim-msm.c msm_slim_qmi_init() and msm_slim_qmi_power_request(), slim-msm-ngd.c ngd_slim_power_up(); Xiaomi's
+ * kernel, LineageOS android_kernel_xiaomi_sm8150).
+ *
+ *   the NGD    slim@171c0000 (qcom,slim-ngd, cell-index 1: its registers at 0x171c0000 + 0x1000, NGD_BASE_V2(1)), SPI 163
+ *   the DSP's  QMI service 0x301 (SLIMBUS_QMI_SVC_ID), version 1, instance 0: the DSP tells of it over QRTR (node 5, port
+ *   service    12 on this phone); "select instance" (0x20): instance 0 (cell-index >> 1), mode MASTER (the DSP's role);
+ *              "power" (0x21): ACTIVE (2), INACTIVE (1)
+ *   the codec  tavil_codec: elemental addresses 00 01 50 02 17 02 (its generic device) and 00 00 50 02 17 02 (its
+ *              interface device); reset GPIO 143 (south; msm_cdc_pinctrl@143, active high), its MCLK 9.6 MHz from the
+ *              PMIC's LN_BB_CLK2 (audio_ext_clk_lnbb), supplies pm8150_s4 (1.8 V) and pm8150l_bob
+ *   Android    the earpiece ("handset"): SLIM_0_RX, one channel -> RX0 -> RX INT0 -> class H -> EAR PA, +6 dB
+ *              (mixer_paths_overlay_static.xml); the main microphone: AMIC3 -> ADC3 -> DEC5 -> TX5, MIC BIAS3
+ *
+ * Two ways in:
+ *
+ *   the microphones' way (hakios_slim_up() / hakios_slim_down(), below): persistent and reference-counted. The first
+ *   call powers the bus (QMI), enables the NGD, exchanges the manager's capability, waits for the NGD's logical address,
+ *   switches the codec's MCLK on (RPMh "lnbca2"), releases its reset, asks the manager for its two logical addresses,
+ *   reads its chip id and brings it up (wcd934x_bring_up() and the analog bias and internal MCLK, codec_power_on()).
+ *   The bus, the NGD and the codec's MCLK then stay up until the DSP is shut down (hakios_slim_dsp_down()); only the
+ *   codec's own biased clocks are put back when the last user leaves. The microphones' driver then has the codec's
+ *   registers (hakios_slim_codec_read/write/update), the interface device's (hakios_slim_interface_write), the two
+ *   logical addresses, and the codec's TX port on a SLIMbus channel (hakios_slim_tx_on/off: the interface device's
+ *   port registers, CONNECT_SRC, DEF_ACT_CHAN and RECONFIG_NOW, as wcd9xxx_cfg_slim_sch_tx() and slim_control_ch() send
+ *   them), and the earpiece's own power-up (hakios_slim_codec_power()).
+ *
+ *   the diagnostic way (boot-arg slim=1..4, hakios_slim_dsp_up()): what this file first did, each level with everything
+ *   done and undone in one run:
+ *
+ *     slim=1   the DSP asked for the bus (select instance, power ACTIVE); the NGD's version and state read (nothing
+ *              written to it); the codec's reset pin looked at; then the power given back (INACTIVE)
+ *     slim=2   ... and the NGD enabled as ngd_slim_power_up() enables it, without the BAM message queues (messages
+ *              through its registers: NGD_TX_MSG, NGD_RX_MSG), its interrupts unmasked (they are only read: polled);
+ *              the manager's "master capability" waited for and answered with "report satellite"
+ *              (ngd_slim_rx_msgq_thread(): the magic D9 C5, version 1, protocol 1), every message that comes for two
+ *              seconds more said; then the NGD disabled again and the power given back
+ *     slim=3   ... and, with the NGD up, the codec: its MCLK on, its reset released as wcd9xxx_reset() releases it,
+ *              the logical addresses of its generic and interface devices asked of the manager, and its chip id read
+ *              (Tavil's major id 0x108). Nothing else is written to the codec; at the end it is put back into reset and
+ *              its MCLK switched off.
+ *     slim=4   ... and the codec brought up and its earpiece path powered, with no samples yet (silence): Linux's
+ *              wcd934x_bring_up(), then the path DAPM powers for the "handset" of Android's mixer paths
+ *              (RX0 -> RX INT0 -> class H -> EAR PA); held for two seconds, the EAR's status looked at; then all of it
+ *              powered down in the reverse order (the PA first), the codec back into reset. Every write read back.
+ *
+ * Checked on the phone (2026-11-04, logs/160631-run.log, adsp=1 slim=1; 161154: slim=2; 162043: slim=3; 162759:
+ * slim=4): the DSP tells of its service at node 5 port 12; "select instance" and "power: ACTIVE" answered with success
+ * in 1 and 10 ms; "power: INACTIVE" too. The codec enumerates 51 ms after the reset: interface 0xce, generic 0xcf; chip
+ * id 01 00 08 01 (Tavil 1.1). slim=4: 48 registers changed, every one read back as written; ANA_EAR 0x80 (the PA on),
+ * the RX supplies 0xc1, INT0's path 0x24, EAR_STATUS 0x08.
+ */
+#include <kern/clock.h>
+#include <kern/locks.h>
+#include <kern/thread.h>
+#include <libkern/libkern.h>
+#include <mach/mach_types.h>
+#include <pexpert/pexpert.h>
+#include <sys/systm.h>
+#include <sys/hakios.audio.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+extern vm_offset_t ml_io_map_wcomb(vm_offset_t phys_addr, vm_size_t size);
+extern kern_return_t thread_terminate(thread_t thread);
+extern void loader_log_putc(char c);
+extern lck_mtx_t hakios_rsc_lock;               /* RPMh's sequencer, shared with the other drivers that ask it */
+
+static LCK_GRP_DECLARE(slim_lock_group, "hakios-slim");
+static LCK_MTX_DECLARE(slim_lock, &slim_lock_group);
+
+static uint32_t level;
+
+static int say(const char *format, ...) __printflike(1, 2);
+
+static int
+say(const char *format, ...)
+{
+	char line[300];
+	va_list list;
+	int length;
+
+	va_start(list, format);
+	length = vsnprintf(line, sizeof(line), format, list);
+	va_end(list);
+	for (const char *c = line; *c != 0; c++) {
+		loader_log_putc(*c);
+	}
+	printf("%s", line);
+	return length;
+}
+
+static inline uint32_t
+rd(vm_offset_t address)
+{
+	return *(volatile uint32_t *)address;
+}
+
+static uint64_t
+now_us(void)
+{
+	uint64_t ns;
+
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	return ns / NSEC_PER_USEC;
+}
+
+/* ---- QMI over QRTR (Linux's qmi_interface.c, as far as two requests need it) --------------------------------------- */
+
+#define SLIM_QMI_SERVICE        0x301
+#define SLIM_QMI_VERSION        1
+#define SLIM_QMI_INSTANCE       0
+#define QMI_SELECT_INSTANCE     0x0020
+#define QMI_POWER               0x0021
+#define SLIM_MODE_MASTER        2               /* the DSP's role: Linux's msm_slim_qmi_init(dev, false) */
+#define SLIM_PM_INACTIVE        1
+#define SLIM_PM_ACTIVE          2
+
+static uint32_t our_port, dsp_node, dsp_port;
+static volatile bool answered;
+static volatile uint16_t answer_txn, answer_msg, answer_result, answer_error;
+static uint16_t next_txn = 1;
+
+/* On the link's thread: a response (type 2) with its result TLV (0x02: result, error) */
+static void
+qmi_receive(__unused uint32_t from_node, __unused uint32_t from_port, const uint8_t *data, uint32_t length)
+{
+	uint32_t at = 7, size;
+
+	if (length < 7 || data[0] != 2) {
+		return;
+	}
+	size = (uint32_t)(data[5] | data[6] << 8);
+	answer_result = answer_error = 0xffff;
+	while (at + 3 <= length && at + 3 <= 7 + size) {
+		uint8_t type = data[at];
+		uint32_t tlv = (uint32_t)(data[at + 1] | data[at + 2] << 8);
+
+		if (at + 3 + tlv > length) {
+			break;
+		}
+		if (type == 0x02 && tlv >= 4) {
+			answer_result = (uint16_t)(data[at + 3] | data[at + 4] << 8);
+			answer_error = (uint16_t)(data[at + 5] | data[at + 6] << 8);
+		}
+		at += 3 + tlv;
+	}
+	answer_txn = (uint16_t)(data[1] | data[2] << 8);
+	answer_msg = (uint16_t)(data[3] | data[4] << 8);
+	__asm__ volatile ("dmb ish" ::: "memory");
+	answered = true;
+}
+
+/* A request of 32-bit TLVs (type, value), its response waited for: true if the result is "success". */
+static bool
+qmi_request(const char *what, uint16_t msg, const uint8_t *types, const uint32_t *values, unsigned count)
+{
+	uint8_t packet[64];
+	uint32_t length = 7;
+	uint16_t txn = next_txn++;
+	uint64_t began;
+
+	packet[0] = 0;                          /* a request */
+	packet[1] = (uint8_t)txn;
+	packet[2] = (uint8_t)(txn >> 8);
+	packet[3] = (uint8_t)msg;
+	packet[4] = (uint8_t)(msg >> 8);
+	for (unsigned i = 0; i < count; i++) {
+		packet[length++] = types[i];
+		packet[length++] = 4;
+		packet[length++] = 0;
+		for (unsigned b = 0; b < 4; b++) {
+			packet[length++] = (uint8_t)(values[i] >> (8 * b));
+		}
+	}
+	packet[5] = (uint8_t)(length - 7);
+	packet[6] = (uint8_t)((length - 7) >> 8);
+	answered = false;
+	say("slim: QMI: %s (message %#x, transaction %u) to node %u port %u\n", what, msg, txn, dsp_node, dsp_port);
+	if (!hakios_adsp_qrtr_send(our_port, dsp_node, dsp_port, packet, length)) {
+		say("slim: QMI: it cannot be sent (the link is not up?)\n");
+		return false;
+	}
+	began = now_us();
+	while (!answered && now_us() - began < 2000000) {
+		delay_for_interval(1, NSEC_PER_MSEC);
+	}
+	if (!answered) {
+		say("slim: QMI: %s: NO ANSWER within 2 s\n", what);
+		return false;
+	}
+	say("slim: QMI: %s: answer to transaction %u (message %#x) after %llu ms: result %u, error %u%s\n", what, answer_txn,
+	    answer_msg, (now_us() - began) / 1000, answer_result, answer_error, answer_result == 0 ? "" : " -- REFUSED");
+	return answer_txn == txn && answer_msg == msg && answer_result == 0;
+}
+
+static bool powered;
+
+static bool
+bus_power(bool on)
+{
+	const uint8_t type[1] = { 0x01 };
+	const uint32_t value[1] = { on ? SLIM_PM_ACTIVE : SLIM_PM_INACTIVE };
+
+	if (!qmi_request(on ? "power: ACTIVE" : "power: INACTIVE", QMI_POWER, type, value, 1)) {
+		return false;
+	}
+	powered = on;
+	return true;
+}
+
+/* ---- the NGD's registers (slim-msm-ngd.c) ----------------------------------------------------------------------- */
+
+#define SLIM_PHYS               0x171c0000UL
+#define SLIM_SIZE               0x2c000UL
+#define NGD_OFFSET              0x1000UL        /* NGD_BASE_V2(cell-index 1) */
+#define NGD_CFG                 0x00
+#define NGD_STATUS              0x04            /* [1] a logical address is ours */
+#define NGD_RX_MSGQ_CFG         0x08
+#define NGD_INT_EN              0x10
+#define NGD_INT_STAT            0x14
+#define NGD_INT_CLR             0x18
+#define NGD_TX_MSG              0x30
+#define NGD_RX_MSG              0x70
+#define NGD_CFG_ENABLE          1u
+#define INT_TX_NACKED_2         (1u << 25)
+#define INT_MSG_BUF_CONTE       (1u << 26)
+#define INT_MSG_TX_INVAL        (1u << 27)
+#define INT_IE_VE_CHG           (1u << 28)
+#define INT_DEV_ERR             (1u << 29)
+#define INT_RX_MSG_RCVD         (1u << 30)
+#define INT_TX_MSG_SENT         (1u << 31)
+#define INT_RECFG_DONE          (1u << 24)
+#define RX_MSGQ_TIMEOUT         0x10000u
+
+/* the messages (include/linux/slimbus/slimbus.h, slim-msm.h) */
+#define MT_CORE                 0x0
+#define MT_DEST_REFERRED_USER   0x2
+#define MT_SRC_REFERRED_USER    0x6
+#define MC_MASTER_CAPABILITY    0x00            /* (user) */
+#define MC_REPORT_SATELLITE     0x01            /* (user) */
+#define MC_GENERIC_ACK          0x25            /* (user) */
+#define MC_REPORT_PRESENT       0x01            /* (core) */
+#define MC_ADDR_QUERY           0x0d            /* (user) */
+#define MC_ADDR_REPLY           0x0e            /* (user) */
+#define MC_REQUEST_VALUE        0x60            /* (core) */
+#define MC_REPLY_VALUE          0x64
+#define MC_CHANGE_VALUE         0x68
+#define MC_CONNECT_SRC          0x2c            /* (user) */
+#define MC_DEF_ACT_CHAN         0x21            /* (user) */
+#define MC_CHAN_CTRL            0x23            /* (user) */
+#define MC_RECONFIG_NOW         0x24            /* (user) */
+#define MC_DISCONNECT_PORT      0x2e            /* (user) */
+#define LA_MANAGER              0xff
+#define WCD_REGISTERS           0x800           /* WCD9XXX_REGISTER_START_OFFSET */
+#define TAVIL_MAJOR             0x0108
+#define FIRST_WORD(length, mt, mc, dt, la) ((length) | (mt) << 5 | (mc) << 8 | (dt) << 15 | (uint32_t)(la) << 16)
+
+#define TLMM_SOUTH_PHYS         0x03d00000UL
+#define PIN_CODEC_RESET         143
+
+static vm_offset_t slim_regs, ngd;
+static bool ngd_enabled;
+
+static inline void
+wr(vm_offset_t address, uint32_t value)
+{
+	*(volatile uint32_t *)address = value;
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+/* A message the NGD has received, if one waits: its words (the length in the low five bits of the first byte). */
+static bool
+ngd_receive(uint8_t *bytes, uint32_t *length)
+{
+	uint32_t stat = rd(ngd + NGD_INT_STAT), words[10];
+
+	if (!(stat & INT_RX_MSG_RCVD)) {
+		return false;
+	}
+	words[0] = rd(ngd + NGD_RX_MSG);
+	*length = words[0] & 0x1f;
+	for (uint32_t i = 1; i < ((*length + 3) >> 2) && i < 10; i++) {
+		words[i] = rd(ngd + NGD_RX_MSG + 4 * i);
+	}
+	wr(ngd + NGD_INT_CLR, INT_RX_MSG_RCVD);
+	memcpy(bytes, words, *length > 40 ? 40 : *length);
+	return true;
+}
+
+static void
+say_message(const char *when, const uint8_t *m, uint32_t length)
+{
+	char hex[3 * 40 + 1];
+	int at = 0;
+
+	for (uint32_t i = 0; i < length && i < 40; i++) {
+		at += snprintf(hex + at, sizeof(hex) - (size_t)at, " %02x", m[i]);
+	}
+	hex[at] = 0;
+	say("slim: %s: a message of %u bytes, type %u, code %#x:%s\n", when, length, (m[0] >> 5) & 7, m[1], hex);
+}
+
+/* A message sent through the NGD's registers; "sent" (or a NACK, an error) waited for. */
+static bool
+ngd_send(const char *what, const uint8_t *bytes, uint32_t length)
+{
+	uint32_t words[10] = { 0 }, stat = 0;
+	uint64_t began;
+
+	memcpy(words, bytes, length);
+	wr(ngd + NGD_INT_CLR, INT_TX_MSG_SENT | INT_TX_NACKED_2 | INT_MSG_TX_INVAL | INT_DEV_ERR | INT_MSG_BUF_CONTE);
+	for (uint32_t i = 0; i < ((length + 3) >> 2); i++) {
+		wr(ngd + NGD_TX_MSG + 4 * i, words[i]);
+	}
+	began = now_us();
+	while (now_us() - began < 1000000) {
+		stat = rd(ngd + NGD_INT_STAT);
+		if (stat & (INT_TX_MSG_SENT | INT_TX_NACKED_2 | INT_MSG_TX_INVAL | INT_DEV_ERR | INT_MSG_BUF_CONTE)) {
+			break;
+		}
+		delay_for_interval(100, NSEC_PER_USEC);
+	}
+	wr(ngd + NGD_INT_CLR, stat & (INT_TX_MSG_SENT | INT_TX_NACKED_2 | INT_MSG_TX_INVAL | INT_DEV_ERR | INT_MSG_BUF_CONTE));
+	if ((stat & INT_TX_MSG_SENT) && !(stat & (INT_TX_NACKED_2 | INT_MSG_TX_INVAL | INT_DEV_ERR | INT_MSG_BUF_CONTE)) &&
+	    strncmp(what, "report", 6) != 0) {
+		return true;            /* (only what is not sent, and the capability's answer, is said: the codec's are hundreds) */
+	}
+	say("slim: %s: %s after %llu us (int stat %#x)\n", what, (stat & INT_TX_MSG_SENT) && !(stat & ~INT_TX_MSG_SENT &
+	    (INT_TX_NACKED_2 | INT_MSG_TX_INVAL | INT_DEV_ERR | INT_MSG_BUF_CONTE)) ? "SENT" : (stat & INT_TX_NACKED_2) ? "NACKED" :
+	    (stat & INT_MSG_TX_INVAL) ? "INVALID" : (stat & INT_DEV_ERR) ? "a device error" : (stat & INT_MSG_BUF_CONTE) ?
+	    "a buffer contention" : "NOT SENT", now_us() - began, stat);
+	return (stat & INT_TX_MSG_SENT) && !(stat & (INT_TX_NACKED_2 | INT_MSG_TX_INVAL | INT_DEV_ERR | INT_MSG_BUF_CONTE));
+}
+
+/* A user message to the manager, its generic ACK waited for (ngd_xferandwait_ack()) */
+static bool
+wait_ack(const char *what, uint8_t tid, uint32_t ms)
+{
+	uint8_t m[40];
+	uint32_t length = 0;
+	uint64_t began = now_us();
+
+	while (now_us() - began < ms * 1000ull) {
+		if (ngd_receive(m, &length)) {
+			if (((m[0] >> 5) & 7) == MT_SRC_REFERRED_USER && m[1] == MC_GENERIC_ACK && length > 4 && m[3] == tid) {
+				if ((m[4] & 0x20) != 0) {
+					return true;
+				}
+				say("slim: %s: NACKED (status %#x)\n", what, m[4]);
+				return false;
+			}
+			say_message("meanwhile", m, length);
+			continue;
+		}
+		delay_for_interval(200, NSEC_PER_USEC);
+	}
+	say("slim: %s: NO ACK within %u ms\n", what, ms);
+	return false;
+}
+
+static bool
+ngd_send_ack(const char *what, uint8_t mc, uint8_t tid, const uint8_t *payload, uint32_t length)
+{
+	uint8_t message[16];
+	uint32_t first = FIRST_WORD(length + 3, MT_DEST_REFERRED_USER, mc, 0, LA_MANAGER);
+
+	if (length + 3 > sizeof(message)) {
+		return false;
+	}
+	memcpy(message, &first, 3);
+	memcpy(message + 3, payload, length);
+	return ngd_send(what, message, length + 3) && wait_ack(what, tid, 1000);
+}
+
+/* ngd_slim_power_up() without the BAM, and the capability exchange; false if the NGD has no address of ours. */
+static bool
+ngd_enable(bool observe)
+{
+	uint8_t m[40];
+	uint32_t length = 0;
+	uint64_t began;
+	bool capable = false, ours;
+
+	say("slim: the NGD is enabled (interrupts unmasked, read by polling; messages through its registers)\n");
+	wr(ngd + NGD_INT_EN, INT_TX_NACKED_2 | INT_MSG_BUF_CONTE | INT_MSG_TX_INVAL | INT_IE_VE_CHG | INT_DEV_ERR | INT_TX_MSG_SENT |
+	    INT_RX_MSG_RCVD | INT_RECFG_DONE);
+	wr(ngd + NGD_RX_MSGQ_CFG, rd(ngd + NGD_RX_MSGQ_CFG) | RX_MSGQ_TIMEOUT);
+	wr(ngd + NGD_CFG, NGD_CFG_ENABLE);
+	ngd_enabled = true;
+	say("slim: the NGD now: cfg %#x, status %#x, int stat %#x\n", rd(ngd + NGD_CFG), rd(ngd + NGD_STATUS), rd(ngd + NGD_INT_STAT));
+	began = now_us();
+	while (now_us() - began < 3000000 && !capable) {
+		if (ngd_receive(m, &length)) {
+			say_message("from the bus", m, length);
+			if (((m[0] >> 5) & 7) == MT_SRC_REFERRED_USER && m[1] == MC_MASTER_CAPABILITY) {
+				/* "report satellite" to the manager: length 7, D9 C5, version 1, protocol 1 (ngd_slim_rx_msgq_thread) */
+				uint8_t reply[7];
+				uint32_t first = FIRST_WORD(7, MT_SRC_REFERRED_USER, MC_REPORT_SATELLITE, 0, LA_MANAGER);
+
+				say("slim: THE MANAGER TELLS ITS CAPABILITY after %llu ms: answered with \"report satellite\"\n",
+				    (now_us() - began) / 1000);
+				memcpy(reply, &first, 3);
+				reply[3] = 0xd9;
+				reply[4] = 0xc5;
+				reply[5] = 1;
+				reply[6] = 1;
+				capable = ngd_send("report satellite", reply, sizeof(reply));
+			}
+			continue;
+		}
+		delay_for_interval(1, NSEC_PER_MSEC);
+	}
+	if (!capable) {
+		say("slim: NO CAPABILITY EXCHANGE within 3 s (status %#x, int stat %#x)\n", rd(ngd + NGD_STATUS), rd(ngd + NGD_INT_STAT));
+		return false;
+	}
+	if (observe) {
+		began = now_us();
+		while (now_us() - began < 2000000) {
+			if (ngd_receive(m, &length)) {
+				say_message("then", m, length);
+				continue;
+			}
+			delay_for_interval(1, NSEC_PER_MSEC);
+		}
+	}
+	began = now_us();
+	while (now_us() - began < 2000000 && !(rd(ngd + NGD_STATUS) & 2)) {
+		if (ngd_receive(m, &length)) {
+			say_message("meanwhile", m, length);
+			continue;
+		}
+		delay_for_interval(1, NSEC_PER_MSEC);
+	}
+	ours = (rd(ngd + NGD_STATUS) & 2) != 0;
+	say("slim: after it: the NGD's status %#x%s, int stat %#x\n", rd(ngd + NGD_STATUS), ours ? " (A LOGICAL ADDRESS IS OURS)" : "",
+	    rd(ngd + NGD_INT_STAT));
+	return ours;
+}
+
+static void
+ngd_down(void)
+{
+	if (!ngd_enabled) {
+		return;
+	}
+	wr(ngd + NGD_CFG, 0);
+	wr(ngd + NGD_INT_EN, 0);
+	ngd_enabled = false;
+	say("slim: the NGD disabled again (cfg %#x)\n", rd(ngd + NGD_CFG));
+}
+
+/* ---- the codec's clocks (RPMh) and its reset (TLMM) ------------------------------------------------------------ */
+
+#define CMD_DB_POINTER_PHYS     0x0c3f0000UL    /* AOP's message RAM: at 0xc, where the command database is */
+#define CMD_DB_SIZE             0x20000UL
+#define RSC_PHYS                0x18220000UL    /* the application processor's "DRV 2"; command slot set 0, active */
+#define TCS(reg)                (rsc + 0xd00 + (reg))
+#define TCS_IRQ_ENABLE          0x00
+#define TCS_IRQ_STATUS          0x04
+#define TCS_IRQ_CLEAR           0x08
+#define TCS_WAIT_FOR_COMPLETION 0x10
+#define TCS_CONTROL             0x14
+#define TCS_CONTROL_ENABLE      (1u << 16)
+#define TCS_CONTROL_TRIGGER     (1u << 24)
+#define TCS_STATUS              0x18
+#define TCS_CMD_ENABLE          0x1c
+#define TCS_CMD_MSGID(n)        (0x30 + 20 * (n))
+#define TCS_CMD_ADDR(n)         (0x34 + 20 * (n))
+#define TCS_CMD_DATA(n)         (0x38 + 20 * (n))
+#define MSGID_WRITE_WAITED      (0x10008u | 0x100u)
+#define VRM_ENABLE              4
+
+struct cmd_db_slave {
+	uint16_t id, header_offset, data_offset, count, version, reserved[3];
+};
+struct cmd_db_header {
+	uint32_t version;
+	uint8_t magic[4];
+	struct cmd_db_slave slave[8];
+	uint32_t checksum, reserved;
+	uint8_t data[];
+};
+struct cmd_db_entry {
+	char id[8];
+	uint32_t priority[2];
+	uint32_t address;
+	uint16_t length, offset;
+};
+
+static vm_offset_t rsc;
+
+static uint32_t
+rpmh_address(const char *name)
+{
+	vm_offset_t pointer = ml_io_map(CMD_DB_POINTER_PHYS, 0x1000);
+	uint32_t at = rd(pointer + 0xc);
+	const struct cmd_db_header *db;
+	char id[8] = { 0 };
+
+	if (at == 0) {
+		return 0;
+	}
+	db = (const struct cmd_db_header *)ml_io_map_wcomb(at, CMD_DB_SIZE);
+	if (db->magic[0] != 0xdb || db->magic[1] != 0x30 || db->magic[2] != 0x03 || db->magic[3] != 0x0c) {
+		say("slim: RPMh: no command database at %#x (magic %02x %02x %02x %02x)\n", at, db->magic[0], db->magic[1], db->magic[2],
+		    db->magic[3]);
+		return 0;
+	}
+	memcpy(id, name, strnlen(name, sizeof(id)));      /* (8 letters, no terminating zero: "lnbclka2" fills it) */
+	for (unsigned sl = 0; sl < 8; sl++) {
+		const struct cmd_db_slave *slave = &db->slave[sl];
+		const struct cmd_db_entry *entry = (const struct cmd_db_entry *)(db->data + slave->header_offset);
+
+		if (slave->id == 0 || slave->header_offset >= CMD_DB_SIZE - 0x1000 || slave->count > 512) {
+			continue;
+		}
+		for (unsigned i = 0; i < slave->count; i++) {
+			if (memcmp(entry[i].id, id, sizeof(id)) == 0) {
+				return entry[i].address;
+			}
+		}
+	}
+	return 0;
+}
+
+/* One write to RPMh through the active command slot set, waited for (hakios.stfts.c's rpmh_write) */
+static bool
+rpmh_write(uint32_t address, uint32_t data)
+{
+	uint32_t irq_enable;
+	bool done = false;
+
+	if (rsc == 0) {
+		rsc = ml_io_map(RSC_PHYS, 0x10000);
+	}
+	lck_mtx_lock(&hakios_rsc_lock);
+	irq_enable = rd(TCS(TCS_IRQ_ENABLE));
+	for (int i = 0; rd(TCS(TCS_STATUS)) == 0; i++) {
+		if (i > 2000) {
+			lck_mtx_unlock(&hakios_rsc_lock);
+			say("slim: RPMh: the command slots stay busy\n");
+			return false;
+		}
+		delay_for_interval(100, NSEC_PER_USEC);
+	}
+	wr(TCS(TCS_CONTROL), rd(TCS(TCS_CONTROL)) & ~TCS_CONTROL_TRIGGER);
+	wr(TCS(TCS_CONTROL), rd(TCS(TCS_CONTROL)) & ~TCS_CONTROL_ENABLE);
+	wr(TCS(TCS_IRQ_CLEAR), 1);
+	wr(TCS(TCS_CMD_MSGID(0)), MSGID_WRITE_WAITED);
+	wr(TCS(TCS_CMD_ADDR(0)), address);
+	wr(TCS(TCS_CMD_DATA(0)), data);
+	wr(TCS(TCS_WAIT_FOR_COMPLETION), 1);
+	wr(TCS(TCS_CMD_ENABLE), 1);
+	wr(TCS(TCS_IRQ_ENABLE), irq_enable | 1);
+	wr(TCS(TCS_CONTROL), TCS_CONTROL_ENABLE);
+	wr(TCS(TCS_CONTROL), TCS_CONTROL_ENABLE | TCS_CONTROL_TRIGGER);
+	for (int i = 0; i < 2000 && !done; i++) {
+		done = (rd(TCS(TCS_IRQ_STATUS)) & 1) != 0;
+		if (!done) {
+			delay_for_interval(100, NSEC_PER_USEC);
+		}
+	}
+	wr(TCS(TCS_CONTROL), rd(TCS(TCS_CONTROL)) & ~TCS_CONTROL_TRIGGER);
+	wr(TCS(TCS_CONTROL), rd(TCS(TCS_CONTROL)) & ~TCS_CONTROL_ENABLE);
+	wr(TCS(TCS_CMD_ENABLE), 0);
+	wr(TCS(TCS_WAIT_FOR_COMPLETION), 0);
+	wr(TCS(TCS_IRQ_CLEAR), 1);
+	wr(TCS(TCS_IRQ_ENABLE), irq_enable);
+	lck_mtx_unlock(&hakios_rsc_lock);
+	return done;
+}
+
+static uint32_t mclk_address;
+static vm_offset_t tlmm_south;
+static uint32_t reset_cfg, reset_io;
+static bool mclk_on, reset_released;
+static uint8_t next_tid = 1;
+
+static const uint8_t ea_generic[6] = { 0x00, 0x01, 0x50, 0x02, 0x17, 0x02 };    /* dt elemental-addr of tavil_codec */
+static const uint8_t ea_interface[6] = { 0x00, 0x00, 0x50, 0x02, 0x17, 0x02 };  /* qcom,cdc-slim-ifd-elemental-addr */
+
+static bool
+mclk(bool on)
+{
+	if (mclk_address == 0) {
+		mclk_address = rpmh_address("lnbclka2");
+		say("slim: RPMh has \"lnbclka2\" (LN_BB_CLK2, the codec's MCLK) at %#x\n", mclk_address);
+		if (mclk_address == 0) {
+			return false;
+		}
+	}
+	if (!rpmh_write(mclk_address + VRM_ENABLE, on ? 1 : 0)) {
+		say("slim: RPMh has not said done to the MCLK %s\n", on ? "on" : "off");
+		return false;
+	}
+	mclk_on = on;
+	say("slim: the codec's MCLK %s (RPMh %#x = %u)\n", on ? "ON" : "off", mclk_address + VRM_ENABLE, on ? 1 : 0);
+	return true;
+}
+
+#define PIN_CFG_8MA_PULL_DOWN_OUT       (1u | 3u << 6 | 1u << 9)        /* pull-down, 8 mA, output; function 0 (gpio) */
+#define PIN_CFG_2MA_OUT                 (0u | 0u << 6 | 1u << 9)        /* no pull, 2 mA, output */
+
+/* wcd9xxx_reset(): low 20 ms, then high, 8 mA, pull-down (msm_cdc_pinctrl's active state) */
+static bool
+codec_reset_release(void)
+{
+	tlmm_south = ml_io_map(TLMM_SOUTH_PHYS, 0x100000);
+	reset_cfg = rd(tlmm_south + 0x1000UL * PIN_CODEC_RESET);
+	reset_io = rd(tlmm_south + 0x1000UL * PIN_CODEC_RESET + 4);
+	say("slim: the codec's reset released as wcd9xxx_reset() does it: gpio143 low (2 mA) for 20 ms, then high (8 mA)\n");
+	wr(tlmm_south + 0x1000UL * PIN_CODEC_RESET + 4, 0);
+	wr(tlmm_south + 0x1000UL * PIN_CODEC_RESET, PIN_CFG_2MA_OUT);
+	reset_released = true;
+	delay_for_interval(20, NSEC_PER_MSEC);
+	wr(tlmm_south + 0x1000UL * PIN_CODEC_RESET, PIN_CFG_8MA_PULL_DOWN_OUT);
+	wr(tlmm_south + 0x1000UL * PIN_CODEC_RESET + 4, 2);
+	return true;
+}
+
+static void
+codec_reset_restore(void)
+{
+	if (!reset_released) {
+		return;
+	}
+	wr(tlmm_south + 0x1000UL * PIN_CODEC_RESET + 4, reset_io & 2);
+	wr(tlmm_south + 0x1000UL * PIN_CODEC_RESET, reset_cfg);
+	reset_released = false;
+	say("slim: the codec back into reset (gpio143 as it was found)\n");
+}
+
+/* A message for this transaction (a reply that carries its tid in byte 3) waited for, other messages said. */
+static bool
+wait_reply(uint8_t mt, uint8_t mc, uint8_t tid, uint8_t *m, uint32_t *length, uint32_t ms)
+{
+	uint64_t began = now_us();
+
+	while (now_us() - began < ms * 1000ull) {
+		if (ngd_receive(m, length)) {
+			if (((m[0] >> 5) & 7) == mt && m[1] == mc && *length > 3 && m[3] == tid) {
+				return true;
+			}
+			say_message("meanwhile", m, *length);
+			continue;
+		}
+		delay_for_interval(200, NSEC_PER_USEC);
+	}
+	return false;
+}
+
+/* The manager's logical address for an elemental address; 0xff: none (yet). */
+static uint8_t
+address_query(const uint8_t ea[6])
+{
+	uint8_t q[10], m[40];
+	uint32_t first = FIRST_WORD(10, MT_DEST_REFERRED_USER, MC_ADDR_QUERY, 0, LA_MANAGER), length = 0;
+	uint8_t tid = next_tid++;
+
+	memcpy(q, &first, 3);
+	q[3] = tid;
+	memcpy(q + 4, ea, 6);
+	if (!ngd_send("address query", q, sizeof(q))) {
+		return 0xff;
+	}
+	if (!wait_reply(MT_SRC_REFERRED_USER, MC_ADDR_REPLY, tid, m, &length, 500)) {
+		say("slim: no address reply within 500 ms\n");
+		return 0xff;
+	}
+	{
+		static const uint8_t none[6] = { 0, 0, 0, 0, 0, 0 };
+
+		/* (Linux's ngd_slim_rx: an elemental address of zeroes in the reply is "nobody of that address", not address 0) */
+		if (length < 11 || memcmp(m + 4, none, 6) == 0) {
+			return 0xff;
+		}
+	}
+	return m[10];
+}
+
+static bool
+codec_write(uint8_t la, uint16_t offset, uint8_t value)
+{
+	uint8_t w[6];
+	uint16_t ec = (uint16_t)(0 | 1u << 3 | (offset & 0xfff) << 4);        /* one byte: slice code 0 */
+	uint32_t first = FIRST_WORD(6, MT_CORE, MC_CHANGE_VALUE, 0, la);
+
+	memcpy(w, &first, 3);
+	w[3] = (uint8_t)ec;
+	w[4] = (uint8_t)(ec >> 8);
+	w[5] = value;
+	return ngd_send("a codec register written", w, sizeof(w));
+}
+
+/* `count' (1..4) bytes from `offset' of the device at `la' */
+static bool
+codec_read(uint8_t la, uint16_t offset, uint8_t *bytes, uint32_t count)
+{
+	static const uint8_t code[5] = { 0, 0, 1, 2, 3 };
+	uint8_t r[6], m[40];
+	uint8_t tid = next_tid++;
+	uint16_t ec = (uint16_t)(code[count] | 1u << 3 | (offset & 0xfff) << 4);
+	uint32_t first = FIRST_WORD(6, MT_CORE, MC_REQUEST_VALUE, 0, la), length = 0;
+
+	memcpy(r, &first, 3);
+	r[3] = tid;
+	r[4] = (uint8_t)ec;
+	r[5] = (uint8_t)(ec >> 8);
+	if (!ngd_send("a codec register asked for", r, sizeof(r))) {
+		return false;
+	}
+	if (!wait_reply(MT_CORE, MC_REPLY_VALUE, tid, m, &length, 500)) {
+		say("slim: no reply value within 500 ms\n");
+		return false;
+	}
+	if (length < 4 + count) {
+		say_message("a short reply", m, length);
+		return false;
+	}
+	memcpy(bytes, m + 4, count);
+	return true;
+}
+
+/* ---- the codec's registers --------------------------------------------------------------------------------------- */
+
+/* Tavil's registers (include/linux/mfd/wcd934x/registers.h): page in the high byte, written to the page register (0) */
+#define R_CODEC_RPM_CLK_GATE            0x0002
+#define R_CODEC_RPM_CLK_MCLK_CFG        0x0003
+#define R_CODEC_RPM_RST_CTL             0x0009
+#define R_CODEC_RPM_PWR_CDC_DIG_HM_CTL  0x0011
+#define R_ANA_BIAS                      0x0601
+#define R_ANA_RCO                       0x0603
+#define R_ANA_RX_SUPPLIES               0x0608
+#define R_ANA_EAR                       0x060a
+#define R_RX_BIAS_FLYB_BUFF             0x06c7
+#define R_EAR_STATUS_REG                0x06e6
+#define R_CLK_SYS_MCLK_PRG              0x0711
+#define R_SIDO_NEW_VOUT_A_STARTUP       0x071b
+#define R_SIDO_NEW_VOUT_D_STARTUP       0x071c
+#define R_HPH_NEW_INT_HPH_TIMER1        0x073a
+#define R_CDC_RX0_RX_PATH_CTL           0x0b41
+#define R_CDC_RX0_RX_PATH_CFG0          0x0b42
+#define R_CDC_RX0_RX_VOL_CTL            0x0b45
+#define R_CDC_RX0_RX_PATH_MIX_CTL       0x0b46
+#define R_CDC_RX0_RX_PATH_SEC0          0x0b49
+#define R_CDC_RX0_RX_PATH_DSMDEM_CTL    0x0b53
+#define R_CDC_CLSH_CRC                  0x0c01
+#define R_CDC_RX_INP_MUX_RX_INT0_CFG0   0x0d01
+#define R_CDC_CLK_RST_CTRL_MCLK_CONTROL 0x0d41
+#define R_CDC_CLK_RST_CTRL_FS_CNT_CONTROL 0x0d42
+
+static uint8_t codec_la = 0xff, interface_la = 0xff;
+static int codec_page = -1;
+static unsigned codec_writes, codec_mismatches;
+static bool codec_failed;
+
+static bool
+codec_page_for(uint16_t reg)
+{
+	uint8_t page = (uint8_t)(reg >> 8);
+
+	if (codec_page == page) {
+		return true;
+	}
+	if (!codec_write(codec_la, WCD_REGISTERS + 0x00, page)) {
+		codec_failed = true;
+		return false;
+	}
+	codec_page = page;
+	return true;
+}
+
+static bool
+reg_read(uint16_t reg, uint8_t *value)
+{
+	if (codec_failed || !codec_page_for(reg) || !codec_read(codec_la, WCD_REGISTERS + (reg & 0xff), value, 1)) {
+		codec_failed = true;
+		say("slim: codec register %#06x cannot be read\n", reg);
+		return false;
+	}
+	return true;
+}
+
+/* the bits of `mask' to `value', read back (bits that the codec clears by itself may not) */
+static bool
+reg_update(uint16_t reg, uint8_t mask, uint8_t value)
+{
+	uint8_t now = 0, want, back = 0;
+
+	if (!reg_read(reg, &now)) {
+		return false;
+	}
+	want = (uint8_t)((now & ~mask) | (value & mask));
+	if (want != now) {
+		if (!codec_write(codec_la, WCD_REGISTERS + (reg & 0xff), want)) {
+			codec_failed = true;
+			return false;
+		}
+		codec_writes++;
+	}
+	if (!reg_read(reg, &back)) {
+		return false;
+	}
+	if (((back ^ want) & mask) != 0) {
+		codec_mismatches++;
+		say("slim: codec register %#06x: %#04x written (mask %#04x), %#04x read back\n", reg, want, mask, back);
+	}
+	return true;
+}
+
+static bool
+reg_put(uint16_t reg, uint8_t value)
+{
+	return reg_update(reg, 0xff, value);
+}
+
+static void
+pause_us(uint32_t us)
+{
+	delay_for_interval(us, NSEC_PER_USEC);
+}
+
+/* wcd934x_bring_up() and the MCLK inside the codec (wcd934x_enable_ana_bias_and_sysclk()) */
+static bool
+codec_power_on(void)
+{
+	say("slim: the codec brought up (wcd934x_bring_up) and its MCLK enabled inside it\n");
+	reg_put(R_CODEC_RPM_RST_CTL, 0x01);
+	reg_put(R_SIDO_NEW_VOUT_A_STARTUP, 0x19);
+	reg_put(R_SIDO_NEW_VOUT_D_STARTUP, 0x15);
+	pause_us(1000);
+	reg_put(R_CODEC_RPM_PWR_CDC_DIG_HM_CTL, 0x5);
+	reg_put(R_CODEC_RPM_PWR_CDC_DIG_HM_CTL, 0x7);
+	reg_put(R_CODEC_RPM_RST_CTL, 0x3);
+	reg_put(R_CODEC_RPM_RST_CTL, 0x7);
+	reg_put(R_CODEC_RPM_PWR_CDC_DIG_HM_CTL, 0x3);
+	reg_update(R_CODEC_RPM_CLK_MCLK_CFG, 0x03, 0x01);               /* 9.6 MHz (wcd934x_comp_set_sysclk) */
+	reg_update(R_ANA_BIAS, 0x80, 0x80);
+	reg_update(R_ANA_BIAS, 0x40, 0x40);                             /* pre-charge */
+	pause_us(1000);
+	reg_update(R_ANA_BIAS, 0x40, 0x00);
+	reg_update(R_ANA_BIAS, 0x20, 0x00);
+	reg_update(R_CLK_SYS_MCLK_PRG, 0x80, 0x80);                     /* the external clock's buffer */
+	reg_update(R_CLK_SYS_MCLK_PRG, 0x30, 0x10);                     /* divided by 2 */
+	reg_update(R_CLK_SYS_MCLK_PRG, 0x02, 0x00);                     /* the MCLK from the external clock */
+	reg_update(R_CLK_SYS_MCLK_PRG, 0x01, 0x01);
+	reg_update(R_CDC_CLK_RST_CTRL_FS_CNT_CONTROL, 0x01, 0x01);
+	reg_update(R_CDC_CLK_RST_CTRL_MCLK_CONTROL, 0x01, 0x01);
+	reg_update(R_CODEC_RPM_CLK_GATE, 0x03, 0x00);
+	pause_us(15);
+	reg_update(R_ANA_RCO, 0x80, 0x80);                              /* SIDO from the RCO and the band gap */
+	pause_us(110);
+	return !codec_failed;
+}
+
+static void
+codec_power_off(void)
+{
+	codec_failed = false;
+	reg_update(R_CLK_SYS_MCLK_PRG, 0x81, 0x00);
+	reg_update(R_ANA_BIAS, 0x80, 0x00);
+	reg_update(R_ANA_BIAS, 0x40, 0x00);
+}
+
+/* ---- slim=4: the earpiece path ----------------------------------------------------------------------------------- */
+
+static bool ear_on;
+
+/* The "handset" path powered as DAPM powers it, without samples (the head) */
+static bool
+ear_path_on(void)
+{
+	say("slim: the earpiece path powered (RX0 -> RX INT0 -> class H -> EAR PA), with no samples: silence\n");
+	reg_update(R_ANA_RX_SUPPLIES, 0x01, 0x01);                      /* RX_BIAS */
+	reg_update(R_CDC_RX0_RX_PATH_CTL, 0x20, 0x20);                  /* INT0_CLK */
+	reg_update(R_CDC_RX0_RX_PATH_DSMDEM_CTL, 0x01, 0x01);           /* DSMDEM0_CLK */
+	reg_update(R_CDC_RX_INP_MUX_RX_INT0_CFG0, 0x0f, 5);             /* RX INT0_1 MIX1 INP0: RX0 */
+	reg_update(R_CDC_RX0_RX_PATH_CFG0, 0x08, 0x08);                 /* the DEM's look-ahead delay */
+	reg_update(R_CDC_RX0_RX_PATH_SEC0, 0x01, 0x01);                 /* RX INT0 DEM MUX: CLSH_DSM_OUT */
+	reg_update(R_CDC_RX0_RX_VOL_CTL, 0xff, (uint8_t)-20);           /* -20 dB, for a start */
+	/* EAR DAC, PRE_PMU: the autochop timer off; class H for the EAR (CLS_H_NORMAL) */
+	reg_update(R_HPH_NEW_INT_HPH_TIMER1, 0x02, 0x00);
+	reg_update(R_CDC_CLSH_CRC, 0x01, 0x01);
+	reg_update(R_CDC_RX0_RX_PATH_CFG0, 0x40, 0x40);
+	reg_update(R_ANA_RX_SUPPLIES, 0x08, 0x00);                      /* buck: default level */
+	reg_update(R_ANA_RX_SUPPLIES, 0x04, 0x00);                      /* flyback: default level */
+	reg_update(R_ANA_RX_SUPPLIES, 0x40, 0x40);                      /* flyback on */
+	pause_us(610);
+	reg_update(R_RX_BIAS_FLYB_BUFF, 0x0f, 0x0a);
+	reg_update(R_RX_BIAS_FLYB_BUFF, 0xf0, 0xa0);
+	pause_us(110);
+	reg_update(R_ANA_RX_SUPPLIES, 0x80, 0x80);                      /* buck on */
+	pause_us(510);
+	/* EAR PA */
+	reg_update(R_ANA_EAR, 0x80, 0x80);
+	ear_on = true;
+	pause_us(5500);
+	reg_update(R_CDC_RX0_RX_PATH_CTL, 0x10, 0x00);                  /* unmuted */
+	reg_update(R_CDC_RX0_RX_PATH_MIX_CTL, 0x10, 0x00);
+	return !codec_failed;
+}
+
+static void
+ear_path_off(void)
+{
+	codec_failed = false;
+	if (ear_on) {
+		reg_update(R_CDC_RX0_RX_PATH_CTL, 0x10, 0x10);          /* muted */
+		reg_update(R_ANA_EAR, 0x80, 0x00);
+		pause_us(5500);
+		ear_on = false;
+	}
+	reg_update(R_CDC_RX0_RX_PATH_CFG0, 0x40, 0x00);
+	reg_update(R_CDC_CLSH_CRC, 0x01, 0x00);
+	reg_update(R_ANA_RX_SUPPLIES, 0x80, 0x00);                      /* buck off */
+	pause_us(510);
+	reg_update(R_ANA_RX_SUPPLIES, 0x40, 0x00);                      /* flyback off */
+	pause_us(610);
+	reg_update(R_CDC_RX0_RX_PATH_SEC0, 0x01, 0x00);
+	reg_update(R_CDC_RX0_RX_PATH_CFG0, 0x08, 0x00);
+	reg_update(R_CDC_RX_INP_MUX_RX_INT0_CFG0, 0x0f, 0);
+	reg_update(R_CDC_RX0_RX_PATH_DSMDEM_CTL, 0x01, 0x00);
+	reg_update(R_CDC_RX0_RX_PATH_CTL, 0x20, 0x00);                  /* INT0's clock off, then its reset */
+	reg_update(R_CDC_RX0_RX_PATH_CTL, 0x40, 0x40);
+	reg_update(R_CDC_RX0_RX_PATH_CTL, 0x40, 0x00);
+	reg_update(R_ANA_RX_SUPPLIES, 0x01, 0x00);
+}
+
+static void
+ear_look(const char *when)
+{
+	uint8_t ear = 0, status = 0, supplies = 0, ctl = 0;
+
+	codec_failed = false;
+	reg_read(R_ANA_EAR, &ear);
+	reg_read(R_EAR_STATUS_REG, &status);
+	reg_read(R_ANA_RX_SUPPLIES, &supplies);
+	reg_read(R_CDC_RX0_RX_PATH_CTL, &ctl);
+	say("slim: %s: ANA_EAR %#04x, EAR_STATUS %#04x, RX supplies %#04x, RX0 path ctl %#04x\n", when, ear, status, supplies, ctl);
+}
+
+/* ---- the TX port and its SLIMbus channel (wcd9xxx_cfg_slim_sch_tx, slim_control_ch) ------------------------------- */
+
+#define SLIM_CH_ACTIVATE        1
+#define SLIM_CH_REMOVE          0
+#define WCD_IF_TX_OR_UR_CFG(port)    (0x1f0 + (port))
+#define WCD_IF_TX_MULTI_0(port)      (0x100 + 4 * (port))
+#define WCD_IF_TX_MULTI_1(port)      (0x101 + 4 * (port))
+#define WCD_IF_PORT_CFG(port)        (0x050 + (port))       /* TAIKO: sh_ch.port_tx_cfg_reg_base */
+#define WCD_IF_WATER_MARK            0x05                   /* 12 bytes | enable (SLAVE_PORT_WATER_MARK_12BYTES << 1 | 1) */
+#define WCD_TX_AUTO_RECOVERY         0x02
+
+/* Connect the codec's generic-device TX port to its channel (slim_connect_src(): no ACK waited for, as Linux does not) */
+static bool
+tx_connect_src(uint8_t la, uint8_t port, uint8_t channel)
+{
+	uint8_t payload[4] = { la, port, channel, next_tid++ };
+	uint32_t first = FIRST_WORD(sizeof(payload) + 3, MT_DEST_REFERRED_USER, MC_CONNECT_SRC, 0, LA_MANAGER);
+	uint8_t message[8];
+
+	memcpy(message, &first, 3);
+	memcpy(message + 3, payload, sizeof(payload));
+	return ngd_send("connect source port", message, sizeof(message));
+}
+
+/* Define and activate the channel (ngd_allocbw(): DEF_ACT_CHAN then RECONFIG_NOW, both acknowledged) */
+static bool
+tx_define_activate(uint8_t la, uint8_t channel)
+{
+	uint8_t tid = next_tid++;
+	/* dataf 0, la & 0x1f; 16 bits and coeff 3; rootexp 2 and hard ISO; 48 kHz prrate 0x83 (slim_nextdefine_ch()) */
+	uint8_t payload[6] = { (uint8_t)(la & 0x1f), 0x24, 0x20, 0x83, tid, channel };
+	uint8_t now[2] = { tid, la };
+
+	return ngd_send_ack("define and activate the channel", MC_DEF_ACT_CHAN, tid, payload, sizeof(payload)) &&
+	       ngd_send_ack("reconfigure now", MC_RECONFIG_NOW, tid, now, sizeof(now));
+}
+
+/* Remove the channel, then disconnect its port (slim_control_ch(REMOVE) and slim_disconnect_ports()) */
+static bool
+tx_remove(uint8_t la, uint8_t port, uint8_t channel)
+{
+	uint8_t tid = next_tid++;
+	uint8_t control[3] = { (uint8_t)((SLIM_CH_REMOVE << 6) | (la & 0x1f)), tid, channel };
+	uint8_t now[2] = { tid, la };
+	uint8_t disconnect[3] = { la, port, next_tid++ };
+	uint32_t first = FIRST_WORD(sizeof(disconnect) + 3, MT_DEST_REFERRED_USER, MC_DISCONNECT_PORT, 0, LA_MANAGER);
+	uint8_t message[6];
+
+	(void)ngd_send_ack("remove the channel", MC_CHAN_CTRL, tid, control, sizeof(control));
+	(void)ngd_send_ack("reconfigure now", MC_RECONFIG_NOW, tid, now, sizeof(now));
+	memcpy(message, &first, 3);
+	memcpy(message + 3, disconnect, sizeof(disconnect));
+	return ngd_send("disconnect the source port", message, sizeof(message));
+}
+
+/* ---- the persistent way in: the bus, the codec, its ports -------------------------------------------------------- */
+
+static bool bus_ready;                  /* QMI + NGD + MCLK + reset + logical addresses + chip id */
+static bool codec_on;                   /* codec_power_on() has run and not been undone */
+static unsigned slim_users;
+
+/* The QMI side: the DSP's service, our port, instance 0 as master, the bus powered. */
+static bool
+bus_power_up(void)
+{
+	const uint8_t types[2] = { 0x01, 0x10 };
+	const uint32_t values[2] = { SLIM_QMI_INSTANCE, SLIM_MODE_MASTER };
+	uint64_t began = now_us();
+
+	if (our_port != 0) {
+		return powered;
+	}
+	while (!hakios_adsp_qrtr_find(SLIM_QMI_SERVICE, SLIM_QMI_VERSION, SLIM_QMI_INSTANCE, &dsp_node, &dsp_port)) {
+		if (now_us() - began > 5000000) {
+			say("slim: the DSP has not told of its SLIMbus service (0x301) within 5 s: nothing is done\n");
+			return false;
+		}
+		delay_for_interval(10, NSEC_PER_MSEC);
+	}
+	our_port = hakios_adsp_qrtr_open(qmi_receive);
+	if (our_port == 0) {
+		say("slim: no QRTR port of ours left\n");
+		return false;
+	}
+	say("slim: the DSP's SLIMbus service is at node %u port %u; ours is port %#x\n", dsp_node, dsp_port, our_port);
+	if (!qmi_request("select instance 0, the DSP the master", QMI_SELECT_INSTANCE, types, values, 2) || !bus_power(true)) {
+		return false;
+	}
+	return true;
+}
+
+static void
+bus_power_down(void)
+{
+	if (our_port != 0) {
+		if (powered) {
+			(void)bus_power(false);
+		}
+		hakios_adsp_qrtr_close(our_port);
+		our_port = 0;
+	}
+}
+
+/* Everything the microphones' path needs above the codec: bus, NGD, MCLK, reset, the two logical addresses, chip id. */
+static bool
+bus_up(void)
+{
+	uint8_t generic = 0xff, interface = 0xff, id[4] = { 0 };
+	uint64_t began;
+
+	codec_failed = false;
+	codec_page = -1;
+	codec_la = interface_la = 0xff;
+	if (!bus_power_up()) {
+		return false;
+	}
+	slim_regs = ml_io_map(SLIM_PHYS, SLIM_SIZE);
+	ngd = slim_regs + NGD_OFFSET;
+	if (!ngd_enable(false)) {
+		return false;
+	}
+	if (!mclk(true)) {
+		return false;
+	}
+	codec_reset_release();
+	began = now_us();
+	while (now_us() - began < 2000000 && (generic == 0xff || interface == 0xff)) {
+		if (interface == 0xff) {
+			interface = address_query(ea_interface);
+		}
+		if (generic == 0xff) {
+			generic = address_query(ea_generic);
+		}
+		if (generic == 0xff || interface == 0xff) {
+			delay_for_interval(50, NSEC_PER_MSEC);
+		}
+	}
+	say("slim: %llu ms after the reset: the codec's interface device %s%#x, its generic device %s%#x\n",
+	    (now_us() - began) / 1000, interface == 0xff ? "has NO logical address " : "is ", interface,
+	    generic == 0xff ? "has NO logical address " : "is ", generic);
+	if (generic == 0xff || interface == 0xff) {
+		return false;
+	}
+	if (!codec_write(generic, WCD_REGISTERS + 0x00, 0) || !codec_read(generic, WCD_REGISTERS + 0x21, id, 4)) {
+		return false;
+	}
+	{
+		uint16_t minor = (uint16_t)(id[0] | id[1] << 8), major = (uint16_t)(id[2] | id[3] << 8);
+
+		say("slim: THE CODEC'S CHIP ID: %02x %02x %02x %02x: major %#x%s, minor %#x%s\n", id[0], id[1], id[2], id[3], major,
+		    major == TAVIL_MAJOR ? " (Tavil, a WCD9340/9341)" : " (NOT Tavil's 0x108)", minor,
+		    minor == 0 ? " (1.0)" : minor == 1 ? " (1.1)" : "");
+		if (major != TAVIL_MAJOR) {
+			return false;
+		}
+	}
+	codec_la = generic;
+	interface_la = interface;
+	codec_page = 0;                 /* (the page register was just written to 0) */
+	return true;
+}
+
+static void
+bus_down(void)
+{
+	if (codec_on) {
+		codec_power_off();
+		codec_on = false;
+	}
+	codec_reset_restore();
+	if (mclk_on) {
+		(void)mclk(false);
+	}
+	ngd_down();
+	bus_power_down();
+	codec_la = interface_la = 0xff;
+	codec_page = -1;
+}
+
+/* The codec's own bring-up, called with slim_lock held. */
+static bool
+codec_power_locked(bool on)
+{
+	bool ok = true;
+
+	if (on) {
+		if (!codec_on) {
+			if (!bus_ready) {
+				ok = false;
+			} else {
+				codec_failed = false;
+				ok = codec_power_on();
+				codec_on = ok;
+			}
+		}
+	} else if (codec_on) {
+		codec_power_off();
+		codec_on = false;
+	}
+	return ok;
+}
+
+/*
+ * hakios_slim_up: the bus, the NGD and the codec up (once), for the microphones' driver. The first user powers the
+ * bus, brings the codec out of reset, verifies it and brings it up; later users just count. False if it could not be
+ * had (nothing is left half up).
+ */
+bool
+hakios_slim_up(void)
+{
+	bool ok = true;
+
+	lck_mtx_lock(&slim_lock);
+	if (bus_ready) {
+		if (!codec_on && !codec_power_locked(true)) {
+			lck_mtx_unlock(&slim_lock);
+			return false;
+		}
+		slim_users++;
+		say("slim: up again (%u %s)\n", slim_users, slim_users == 1 ? "user" : "users");
+		lck_mtx_unlock(&slim_lock);
+		return true;
+	}
+	say("slim: the SLIMbus and the codec, for the microphones: up\n");
+	if (!bus_up()) {
+		say("slim: the SLIMbus and the codec could not be brought up\n");
+		bus_down();
+		ok = false;
+	} else {
+		/* (the codec is brought up with bus_ready already set: codec_power_on() reads its registers) */
+		bus_ready = true;
+		if (!codec_power_locked(true)) {
+			say("slim: the codec could not be brought up\n");
+			bus_ready = false;
+			bus_down();
+			ok = false;
+		} else {
+			slim_users = 1;
+		}
+	}
+	lck_mtx_unlock(&slim_lock);
+	return ok;
+}
+
+/* hakios_slim_down: one user fewer; the last turns the codec's own clocks off (the bus stays up for the next user). */
+void
+hakios_slim_down(void)
+{
+	lck_mtx_lock(&slim_lock);
+	if (slim_users == 0) {
+		lck_mtx_unlock(&slim_lock);
+		return;
+	}
+	if (--slim_users == 0) {
+		(void)codec_power_locked(false);
+		say("slim: the last user: the codec's clocks off (the bus stays up)\n");
+	}
+	lck_mtx_unlock(&slim_lock);
+}
+
+/* The codec's own bring-up (its analog bias and internal MCLK); false if it could not be had. */
+bool
+hakios_slim_codec_power(bool on)
+{
+	bool ok;
+
+	lck_mtx_lock(&slim_lock);
+	ok = codec_power_locked(on);
+	lck_mtx_unlock(&slim_lock);
+	return ok;
+}
+
+bool
+hakios_slim_codec_read(uint16_t reg, uint8_t *value)
+{
+	bool ok;
+
+	lck_mtx_lock(&slim_lock);
+	ok = bus_ready && codec_on && reg_read(reg, value);
+	lck_mtx_unlock(&slim_lock);
+	return ok;
+}
+
+bool
+hakios_slim_codec_write(uint16_t reg, uint8_t value)
+{
+	bool ok;
+
+	lck_mtx_lock(&slim_lock);
+	ok = bus_ready && codec_on && !codec_failed && codec_page_for(reg) &&
+	    codec_write(codec_la, WCD_REGISTERS + (reg & 0xff), value);
+	if (!ok) {
+		codec_failed = true;
+	}
+	lck_mtx_unlock(&slim_lock);
+	return ok;
+}
+
+bool
+hakios_slim_codec_update(uint16_t reg, uint8_t mask, uint8_t value)
+{
+	bool ok;
+
+	lck_mtx_lock(&slim_lock);
+	ok = bus_ready && codec_on && reg_update(reg, mask, value);
+	lck_mtx_unlock(&slim_lock);
+	return ok;
+}
+
+bool
+hakios_slim_interface_write(uint16_t reg, uint8_t value)
+{
+	bool ok;
+
+	lck_mtx_lock(&slim_lock);
+	ok = bus_ready && interface_la != 0xff && codec_write(interface_la, WCD_REGISTERS + reg, value);
+	lck_mtx_unlock(&slim_lock);
+	return ok;
+}
+
+uint8_t
+hakios_slim_generic_la(void)
+{
+	return codec_la;
+}
+
+uint8_t
+hakios_slim_interface_la(void)
+{
+	return interface_la;
+}
+
+/*
+ * The codec's TX port on a SLIMbus channel, as Android's wcd9xxx_cfg_slim_sch_tx() brings it up: the interface device's
+ * port registers, the source connected, then the channel defined and activated with the manager.
+ */
+bool
+hakios_slim_tx_on(uint8_t port, uint8_t channel)
+{
+	bool ok = false;
+	uint16_t payload = (uint16_t)(1u << (port & 0x0f));
+
+	lck_mtx_lock(&slim_lock);
+	if (!bus_ready || !codec_on || interface_la == 0xff || codec_la == 0xff) {
+		goto out;
+	}
+	say("slim: the codec's TX port %u on channel %u: up\n", port, channel);
+	ok = codec_write(interface_la, WCD_REGISTERS + WCD_IF_TX_OR_UR_CFG(port), WCD_TX_AUTO_RECOVERY) &&
+	     codec_write(interface_la, WCD_REGISTERS + WCD_IF_TX_MULTI_0(port), (uint8_t)(payload & 0xff)) &&
+	     codec_write(interface_la, WCD_REGISTERS + WCD_IF_TX_MULTI_1(port), (uint8_t)(payload >> 8)) &&
+	     codec_write(interface_la, WCD_REGISTERS + WCD_IF_PORT_CFG(port), WCD_IF_WATER_MARK) &&
+	     tx_connect_src(codec_la, port, channel) &&
+	     tx_define_activate(codec_la, channel);
+	if (ok) {
+		say("slim: the codec's TX port %u on channel %u: UP\n", port, channel);
+	} else {
+		say("slim: the codec's TX port %u on channel %u: NOT UP\n", port, channel);
+	}
+out:
+	lck_mtx_unlock(&slim_lock);
+	return ok;
+}
+
+void
+hakios_slim_tx_off(uint8_t port, uint8_t channel)
+{
+	lck_mtx_lock(&slim_lock);
+	if (bus_ready && interface_la != 0xff && codec_la != 0xff) {
+		say("slim: the codec's TX port %u on channel %u: down\n", port, channel);
+		(void)tx_remove(codec_la, port, channel);
+	}
+	lck_mtx_unlock(&slim_lock);
+}
+
+/* ---- the diagnostic way in: slim=1..4 ---------------------------------------------------------------------------- */
+
+static void
+codec_up_diagnostic(void)
+{
+	uint8_t generic = 0xff, interface = 0xff, id[4] = { 0 };
+	uint64_t began;
+
+	if (!mclk(true)) {
+		return;
+	}
+	codec_reset_release();
+	began = now_us();
+	while (now_us() - began < 2000000 && (generic == 0xff || interface == 0xff)) {
+		if (interface == 0xff) {
+			interface = address_query(ea_interface);
+		}
+		if (generic == 0xff) {
+			generic = address_query(ea_generic);
+		}
+		if (generic == 0xff || interface == 0xff) {
+			delay_for_interval(50, NSEC_PER_MSEC);
+		}
+	}
+	say("slim: %llu ms after the reset: the codec's interface device %s%#x, its generic device %s%#x\n",
+	    (now_us() - began) / 1000, interface == 0xff ? "has NO logical address " : "is ", interface,
+	    generic == 0xff ? "has NO logical address " : "is ", generic);
+	if (generic == 0xff) {
+		return;
+	}
+	codec_la = generic;
+	interface_la = interface;
+	codec_page = 0;
+	codec_failed = false;
+	if (codec_write(generic, WCD_REGISTERS + 0x00, 0) && codec_read(generic, WCD_REGISTERS + 0x21, id, 4)) {
+		uint16_t minor = (uint16_t)(id[0] | id[1] << 8), major = (uint16_t)(id[2] | id[3] << 8);
+
+		say("slim: THE CODEC'S CHIP ID: %02x %02x %02x %02x: major %#x%s, minor %#x%s\n", id[0], id[1], id[2], id[3], major,
+		    major == TAVIL_MAJOR ? " (Tavil, a WCD9340/9341)" : " (NOT Tavil's 0x108)", minor,
+		    minor == 0 ? " (1.0)" : minor == 1 ? " (1.1)" : "");
+		if (level >= 4 && major == TAVIL_MAJOR) {
+			if (codec_power_on()) {
+				codec_on = true;
+				ear_look("before the path");
+				if (ear_path_on()) {
+					ear_look("the path on");
+					delay_for_interval(2000, NSEC_PER_MSEC);
+					ear_look("two seconds later");
+				}
+				ear_path_off();
+				ear_look("the path off");
+				codec_power_off();
+				codec_on = false;
+			}
+			say("slim: the codec: %u registers changed, %u did not read back as written\n", codec_writes, codec_mismatches);
+		}
+	}
+}
+
+static void
+codec_down_diagnostic(void)
+{
+	codec_reset_restore();
+	if (mclk_on) {
+		(void)mclk(false);
+	}
+	codec_la = interface_la = 0xff;
+	codec_page = -1;
+}
+
+static void
+look(void)
+{
+	vm_offset_t slim = slim_regs;
+	vm_offset_t tlmm = ml_io_map(TLMM_SOUTH_PHYS, 0x100000);
+	uint32_t version = rd(slim), cfg = rd(tlmm + 0x1000UL * PIN_CODEC_RESET), io = rd(tlmm + 0x1000UL * PIN_CODEC_RESET + 4);
+
+	say("slim: the controller's version word %#x (version %#x)\n", version, version >> 16);
+	say("slim: the NGD (%#lx): cfg %#x, status %#x%s, rx msgq cfg %#x, int en %#x, int stat %#x\n", SLIM_PHYS + NGD_OFFSET,
+	    rd(ngd + NGD_CFG), rd(ngd + NGD_STATUS), (rd(ngd + NGD_STATUS) & 2) ? " (a logical address is ours)" : "",
+	    rd(ngd + NGD_RX_MSGQ_CFG), rd(ngd + NGD_INT_EN), rd(ngd + NGD_INT_STAT));
+	say("slim: the codec's reset, gpio%u: function %u, pull %u, %u mA, %s, reads %u\n", PIN_CODEC_RESET, (cfg >> 2) & 15, cfg & 3,
+	    (((cfg >> 6) & 7) + 1) * 2, (cfg & (1u << 9)) ? ((io & 2) ? "drives high: the codec out of reset" :
+	    "drives low: the codec in reset") : "input", io & 1);
+}
+
+static void
+slim_thread(__unused void *parameter, __unused wait_result_t result)
+{
+	uint64_t began = now_us();
+	bool had_lock = false;
+
+	lck_mtx_lock(&slim_lock);
+	had_lock = true;
+	if (bus_ready || slim_users > 0) {
+		say("slim: the microphones' path has the SLIMbus: the diagnostic is skipped\n");
+		goto done;
+	}
+	say("slim: level %u: the DSP asked for the SLIMbus, the NGD looked at%s, the power given back\n", level,
+	    level >= 2 ? ", enabled and the capabilities exchanged" : "");
+	if (!bus_power_up()) {
+		bus_power_down();
+		goto done;
+	}
+	slim_regs = ml_io_map(SLIM_PHYS, SLIM_SIZE);
+	ngd = slim_regs + NGD_OFFSET;
+	look();
+	if (level >= 2) {
+		if (ngd_enable(true)) {
+			if (level >= 3 && (rd(ngd + NGD_STATUS) & 2)) {
+				codec_up_diagnostic();
+				codec_down_diagnostic();
+			}
+		}
+		ngd_down();
+	}
+	bus_power_down();
+done:
+	if (had_lock) {
+		lck_mtx_unlock(&slim_lock);
+	}
+	say("slim: done\n");
+	thread_terminate(current_thread());
+}
+
+void
+hakios_slim_dsp_up(void)
+{
+	thread_t thread;
+
+	if (!PE_parse_boot_argn("slim", &level, sizeof(level)) || level == 0) {
+		return;
+	}
+	level = level > 4 ? 4 : level;
+	if (kernel_thread_start(slim_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+
+/*
+ * Before the DSP is shut down: the microphones' driver has let go of its users already (hakios_mic_dsp_down()); what
+ * is left is put back here, in the reverse order. A diagnostic run gives its power back at its level's end; if one is
+ * still running, the lock waits for it.
+ */
+void
+hakios_slim_dsp_down(void)
+{
+	lck_mtx_lock(&slim_lock);
+	if (slim_users > 0) {
+		say("slim: the DSP is going down with %u user%s of the bus: all of it put back\n", slim_users,
+		    slim_users == 1 ? "" : "s");
+		slim_users = 0;
+	}
+	if (bus_ready) {
+		bus_down();
+		bus_ready = false;
+	}
+	lck_mtx_unlock(&slim_lock);
+}
diff --git a/bsd/dev/hakios.sound.c b/bsd/dev/hakios.sound.c
new file mode 100644
index 0000000..571c890
--- /dev/null
+++ b/bsd/dev/hakios.sound.c
@@ -0,0 +1,1671 @@
+/* Ported from not-exyy/ios-cepheus (HakiOS) for this cepheus port; see HANDOFF.md. */
+/*
+ * The phone's sound, step 3: what the audio DSP's services are told so that the speakers play.
+ * Every address and number below belongs to the SM7325 phone, and nothing here happens
+ * unless boot-arg sound=N asks for it, with adsp=1 (hakios.adsp.c), which starts the DSP and
+ * calls hakios_sound_dsp_up() once its audio services are up.
+ *
+ * Under Android the speakers' sound goes from the audio server through three of the DSP's
+ * services: ASM, a stream the samples are written into; ADM, the matrix that routes a stream to
+ * a device path ("COPP"); and AFE, the port at the SoC's interface. The two amplifiers
+ * (hakios.speaker.c) sit on the primary TDM interface, which the DSP runs: Android's
+ * PRI_TDM_RX_0, AFE port 0x9000 in group 0x9100 (with 0x9002, unused). The samples themselves
+ * lie in memory of ours that the DSP reads through the application processors' SMMU, as
+ * stream 0x1801 (Android: qcom,msm-audio-ion, iommus <&apps_smmu 0x1801 0>, its addresses from
+ * 0x10000000, and the stream's low four bits in bits 32 to 35 of every address the DSP is given:
+ * qcom,smmu-sid-mask 0xf, msm_audio_ion.c).
+ *
+ *   sound=1  the port: the TDM pins to the interface, the interface's bit clock, the group, the
+ *            port, started; whether the bit clock and the frame sync then toggle at the pins is
+ *            looked at; held for sound_secs (default 3), then everything stopped and put back
+ *   sound=2  ... and a stream: our memory shown to the DSP through the SMMU, a device path
+ *            (ADM) to the port, an ASM stream routed to it, and a test tone -- 1 kHz at -20 dBFS,
+ *            both channels -- written into it for sound_secs (at most 3); the DSP's "written"
+ *            events say whether it takes the samples at 48 kHz. The amplifiers stay off.
+ *   sound=3  ... and the amplifiers, with the tone playing: set up as Android's driver sets them
+ *            up, started once the clock runs, faded in to sound_below eighths of a dB under
+ *            Android's own level (default 160: 20 dB under, the least it may be is 0), faded
+ *            out and powered down at the end. Audible.
+ *   sound=4  what Darwin plays (/dev/hakios-audio, hakios.audio.c), until the run ends: the port
+ *            and the stream as above, kept running (silence when Darwin writes nothing); the
+ *            amplifiers set up once and powered down, started and faded in (the driver's quick
+ *            fade) whenever a write is not silence, stopped after three seconds of silence; their
+ *            level is what is set on the plug-in's volume control (ioctl HAKIOS_AUDIO_SET_VOLUME):
+ *            so far under sound_below, which stays the loudest, and at 0 they stay off. (Darwin sets
+ *            that control only once, to the top, and applies its volume to the samples itself --
+ *            see userland/src/audio_plugin.c --; at its volume 0 it writes silence, and the
+ *            amplifiers stay off for that too.) On their way the samples go through the speakers'
+ *            guard (hakios.guard.c), in place of the DSP's speaker protection that Android has:
+ *            sound_gain eighths of a dB of gain (default and most 96, 12 dB: Darwin's own processing
+ *            keeps its top that far under full scale), a high-pass filter, three averages of the
+ *            power at the speakers and a peak limiter. sound_guard_as=N, for a test: the guard
+ *            reckons the amplifiers N eighths of a dB under Android's level (louder than they are)
+ *            and holds back as it would there -- with sound_below=720 (the amplifiers at -90 dB)
+ *            what it does at the loudest can be seen in the log and the recording without a sound.
+ *
+ * The numbers are Android's own, from the phone's live device tree (qcom,msm-dai-tdm-pri-rx and
+ * its port, the pins pri_tdm_*_active), its mixer paths (the speaker: PRI_TDM_RX_0 at 48 kHz,
+ * two channels, S32_LE) and its kernel (Xiaomi's hakios-s-oss, techpack/audio: asoc/lahaina.c,
+ * asoc/msm-dai-q6-v2.c, dsp/q6afe.c, dsp/q6adm.c, dsp/q6asm.c):
+ *   - the bit clock: the interface's internal one (clock 0x200, "PRI_TDM_IBIT"), attribute 4
+ *     ("invert, couple no", msm-dai-q6-v2.c's default; the tree names none), at 48000 x 32 bits x
+ *     2 slots = 3.072 MHz -- the machine driver sets that rate itself (lahaina.c, which on sm7325
+ *     halves its four slots to two: "Using default tdm max slot: 4" in Android's log), not the
+ *     tree's 1.536 MHz
+ *   - the group: ports 0x9000 and 0x9002, two 32-bit slots, mask 3, 48 kHz
+ *   - the port: two channels of 32 bits at 48 kHz, linear PCM; sync mode 0, sync source 1, data
+ *     out 0, inverted sync 1, data delay 1; slot mapping: channels at byte offsets 0 and 4 (slot
+ *     0, the amplifier at 0x35; slot 1, the one at 0x34), MSB-aligned
+ *   - the pins: GPIO 97 (bit clock) and 100 (frame sync) function mi2s0, 8 mA, no pull, output
+ *     high; 98 and 99 (data in and out) function mi2s0, 8 mA, no pull (pinctrl-yupik.c: function
+ *     1 for all four)
+ *   - the path: ADM's device open (version 5) for playback to port 0x9000 with no processing
+ *     (topology 0x10312), two channels, 24 bits, 48 kHz; the stream: ASM session 1, stream 1,
+ *     opened for writing linear PCM of 16 bits, no processing (0x10c68), routed to that path
+ *
+ * The Xiaomi Mi 9 (cepheus, SM8150) has one speaker at the bottom, its amplifier a Cirrus CS35L41
+ * (hakios.cs35l41.c), fed by the quaternary MI2S interface: Android's QUAT_MI2S_RX, AFE port 0x1006,
+ * one channel of S24_LE at 48 kHz (its mixer_paths_overlay_static.xml and audio_platform_info.xml:
+ * SND_DEVICE_OUT_SPEAKER on QUAT_MI2S_RX); the DSP the master of the clocks; data on SD0 (dt:
+ * qcom,msm-dai-q6-mi2s-quat, qcom,msm-mi2s-rx-lines 1); the bit clock the interface's internal one,
+ * QUAD_MI2S_IBIT (0x106), at 48000 x 2 x 32 = 3.072 MHz, attribute "couple no" (Xiaomi's sm8150.c:
+ * mi2s_clk, update_mi2s_clk_val()); the I2S configuration as msm-dai-q6-v2.c makes it for that (24
+ * bits, SD0, mono, word select from the DSP); pins GPIO 137 (bit clock) and 138 (word select)
+ * function qua_mi2s, 8 mA, no pull, output high, 139 and 140 (data 0 and 1) function qua_mi2s, 8 mA
+ * (dt quat_mi2s_active, quat_mi2s_sd0_active; pinctrl-sm8150.c: function 1, the south tile at
+ * 0x3d00000); the DSP sees our memory as stream 0x1b21 (dt qcom,msm-audio-ion iommus <&apps_smmu
+ * 0x1b21 0>, qcom,smmu-sid-mask 0xf: the same low bits, 1, as sm7325's). The ADM path has one
+ * channel, front centre; the stream stays stereo, its two channels mixed to one here first ((L + R) / 2 in
+ * both, period_fill_darwin()), so the DSP's matrix has nothing left to mix down. Which phone it
+ * is: /arm-io's device_type, "cepheus" or "sm7325" (the default), as the loader writes it.
+ * On that phone (2026-11-04): sound=1 the clocks at the pins (word select 48 kHz), sound=2 the tone taken
+ * at 48380 frames a second with no underflow and nothing refused by the SMMU, sound=3 the tone heard
+ * (logs/154204, 154318, 154438); sound=4 Darwin's sound heard (155005..155650), the amplifier started and
+ * stopped 8 times in a run; with the board's defaults (no gain, 3 dB under Android's level) nothing limited
+ * and, the user says, no rasp and a good loudness.
+ *
+ * What is started is stopped, and what is written is put back, when the time is over -- or, if
+ * the DSP is to be shut down earlier (the run's end), before that (hakios_sound_dsp_down()).
+ * The amplifiers are powered down on a panic's way out (hakios_sound_quiesce()).
+ *
+ * Message layouts: the files above, and Linux's sound/soc/qcom/qdsp6/ (q6afe.c, q6adm.c,
+ * q6asm.c); the SMMU: hakios.wifi.c, which does the same for the Wi-Fi's stream.
+ */
+#include <kern/clock.h>
+#include <kern/locks.h>
+#include <kern/thread.h>
+#include <libkern/libkern.h>
+#include <libkern/OSAtomic.h>
+#include <mach/mach_types.h>
+#include <mach/vm_param.h>
+#include <vm/memory_types.h>
+#include <pexpert/device_tree.h>
+#include <pexpert/pexpert.h>
+#include <sys/systm.h>
+#include <sys/hakios.audio.h>
+#include <vm/vm_kern.h>
+
+extern vm_offset_t ml_io_map_unmappable(vm_offset_t phys_addr, vm_size_t size, unsigned int flags);
+extern uint64_t kvtophys(vm_offset_t va);
+extern kern_return_t thread_terminate(thread_t thread);
+extern void loader_log_putc(char c);
+
+/* The SMMU's match registers and contexts are found free and taken by the Wi-Fi's start as well (hakios.wifi.c). */
+extern lck_mtx_t hakios_smmu_lock;
+
+static LCK_GRP_DECLARE(sound_lock_group, "hakios-sound");
+static LCK_MTX_DECLARE(sound_lock, &sound_lock_group);  /* the path being set up or taken down */
+
+static uint32_t level, seconds = 3, below = 240, pause_ms = 1000, gain = HAKIOS_GUARD_MAX_GAIN;
+static uint32_t guard_as = UINT32_MAX;  /* boot-arg sound_guard_as=N: the guard reckons the amplifiers at most N under (a test) */
+static char last_write[96] = "nothing written";
+
+/* ---- what is said: to the loader's log as well, as it happens ---------------------------------------- */
+
+static int say(const char *format, ...) __printflike(1, 2);
+
+static int
+say(const char *format, ...)
+{
+	char line[400];
+	va_list list;
+	int length;
+
+	va_start(list, format);
+	length = vsnprintf(line, sizeof(line), format, list);
+	va_end(list);
+	for (const char *c = line; *c != 0; c++) {
+		loader_log_putc(*c);
+	}
+	printf("%s", line);
+	return length;
+}
+
+static void
+sleep_ms(uint32_t ms)
+{
+	delay_for_interval(ms, NSEC_PER_MSEC);
+}
+
+static uint64_t
+now_us(void)
+{
+	uint64_t nanoseconds;
+
+	absolutetime_to_nanoseconds(mach_absolute_time(), &nanoseconds);
+	return nanoseconds / 1000;
+}
+
+/* The time of day (UTC, as the host gave it: boot-arg epoch) and since the kernel began, for whoever listens. */
+static void
+say_when(const char *what)
+{
+	clock_sec_t secs;
+	clock_usec_t usecs;
+	uint64_t up = now_us();
+
+	clock_get_calendar_microtime(&secs, &usecs);
+	say("sound: %s at %02lu:%02lu:%02lu.%01u UTC (%llu.%01llu s after the kernel began)\n", what, (unsigned long)(secs / 3600 % 24),
+	    (unsigned long)(secs / 60 % 60), (unsigned long)(secs % 60), (unsigned)(usecs / 100000), up / 1000000, up / 100000 % 10);
+}
+
+/* Time for the loader to note what has just been said, before something not yet seen to be harmless. */
+static void
+announce(const char *what)
+{
+	say("sound: %s\n", what);
+	if (pause_ms) {
+		sleep_ms(pause_ms);
+	}
+}
+
+static uint32_t __attribute__((noinline))
+rd(vm_offset_t address)
+{
+	uint32_t value;
+
+	__asm__ volatile ("ldr %w0, [%1]" : "=r" (value) : "r" (address) : "memory");
+	return value;
+}
+
+static void __attribute__((noinline))
+wr(vm_offset_t address, uint32_t value)
+{
+	__asm__ volatile ("str %w0, [%1]" : : "r" (value), "r" (address) : "memory");
+}
+
+struct block {
+	const char *name;
+	uint32_t phys, size;
+	vm_offset_t base;
+};
+
+static uint32_t
+get(struct block *b, const char *name, uint32_t offset)
+{
+	uint32_t value;
+
+	if (b->base == 0) {
+		/* kernel_map, not ml_io_map's 8 MB io_submap: this port's other drivers have nearly filled it */
+		b->base = ml_io_map_unmappable(b->phys, b->size, VM_WIMG_IO);
+	}
+	value = rd(b->base + offset);
+	say("sound: %s %s (%#x) = %#x\n", b->name, name, b->phys + offset, value);
+	return value;
+}
+
+static void
+put(struct block *b, const char *name, uint32_t offset, uint32_t value)
+{
+	if (b->base == 0) {
+		/* kernel_map, not ml_io_map's 8 MB io_submap: this port's other drivers have nearly filled it */
+		b->base = ml_io_map_unmappable(b->phys, b->size, VM_WIMG_IO);
+	}
+	say("sound: about to write %s %s at %#x: %#x\n", b->name, name, b->phys + offset, value);
+	snprintf(last_write, sizeof(last_write), "wrote %#x to %s %s at %#x", value, b->name, name, b->phys + offset);
+	wr(b->base + offset, value);
+}
+
+/* ---- the TDM pins ------------------------------------------------------------------------------------- */
+
+static struct block tlmm = { "pin controller", 0x0f100000, 0x100000 };     /* (the board's: choose_board()) */
+#define GPIO_CFG(n)             (0x1000u * (n))         /* [1:0] pull, [5:2] function, [8:6] drive (mA / 2 - 1), [9] output */
+#define GPIO_IO(n)              (0x1000u * (n) + 4)     /* bit 0 in, bit 1 out */
+#define CFG_MI2S0               (1u << 2)
+#define CFG_8MA                 (3u << 6)
+#define CFG_OUTPUT              (1u << 9)
+
+struct sound_pin {
+	unsigned pin;
+	const char *name;
+	uint32_t cfg, io;               /* Android's active state */
+};
+static const struct sound_pin sm7325_pins[] = {
+	{ 97, "gpio97 (bit clock)", CFG_MI2S0 | CFG_8MA | CFG_OUTPUT, 2 },
+	{ 100, "gpio100 (frame sync)", CFG_MI2S0 | CFG_8MA | CFG_OUTPUT, 2 },
+	{ 98, "gpio98 (data in)", CFG_MI2S0 | CFG_8MA, 0 },
+	{ 99, "gpio99 (data out)", CFG_MI2S0 | CFG_8MA, 0 },
+};
+static const struct sound_pin cepheus_pins[] = {
+	{ 137, "gpio137 (bit clock)", CFG_MI2S0 | CFG_8MA | CFG_OUTPUT, 2 },  /* (qua_mi2s is function 1 of these four too) */
+	{ 138, "gpio138 (word select)", CFG_MI2S0 | CFG_8MA | CFG_OUTPUT, 2 },
+	{ 139, "gpio139 (data 0, to the amplifier)", CFG_MI2S0 | CFG_8MA, 0 },
+	{ 140, "gpio140 (data 1)", CFG_MI2S0 | CFG_8MA, 0 },
+};
+#define TDM_PINS                4
+
+/* What differs between the two phones (the head of this file) */
+static const struct sound_board {
+	const char *            name;           /* /arm-io's device_type */
+	uint32_t                tlmm;           /* the pins' tile of the pin controller */
+	const struct sound_pin *pins;           /* TDM_PINS of them */
+	unsigned                clock_pin, sync_pin;
+	bool                    i2s;            /* an MI2S port (else a port of a TDM group) */
+	uint16_t                port;           /* the AFE port */
+	uint32_t                clock_id, clock_hz;
+	uint16_t                clock_attribute;
+	uint16_t                port_channels, port_bits;
+	uint16_t                adm_channels;
+	uint32_t                stream;         /* the DSP's stream in the application processors' SMMU */
+	const char *            acf;            /* the amplifiers' configuration file in /fw, NULL: none */
+	const char *            what;
+	uint32_t                below, gain;    /* the defaults of sound_below and sound_gain (eighths of a dB) */
+} sound_boards[] = {
+	{ "sm7325", 0x0f100000, sm7325_pins, 97, 100, false, 0x9000, 0x200, 3072000, 4, 2, 32, 2, 0x1801, "aw882xx_acf.bin",
+	  "the speakers' TDM port (PRI_TDM_RX_0, 0x9000)", 240, HAKIOS_GUARD_MAX_GAIN },
+	{ "cepheus", 0x03d00000, cepheus_pins, 137, 138, true, 0x1006, 0x106, 3072000, 1, 1, 24, 1, 0x1b21, NULL,
+	  /*
+	   * No gain before the guard: Darwin's waveforms come here with their peaks at -8.7 dBFS (12018) and its loudest at
+	   * full scale, and sm7325's 12 dB had the peak limiter cutting 4 dB off them, heard as a rasp at high volumes
+	   * (logs/155005, 155411); the amplifier 3 dB under Android's level instead.
+	   */
+	  "the speaker's I2S port (QUAT_MI2S_RX, 0x1006)", 24, 0 },
+};
+static const struct sound_board *board = &sound_boards[0];
+
+static void
+choose_board(void)
+{
+	DTEntry entry;
+	void const *prop;
+	unsigned int size;
+
+	if (SecureDTLookupEntry(NULL, "/arm-io", &entry) == kSuccess &&
+	    SecureDTGetProperty(entry, "device_type", &prop, &size) == kSuccess) {
+		for (unsigned i = 0; i < sizeof(sound_boards) / sizeof(sound_boards[0]); i++) {
+			if (strncmp((const char *)prop, sound_boards[i].name, size) == 0 ||
+			    (strcmp(sound_boards[i].name, "cepheus") == 0 && size >= 8 &&
+			    strncmp((const char *)prop, "sweet-io", 8) == 0)) {
+				board = &sound_boards[i];
+			}
+		}
+	}
+	tlmm.phys = board->tlmm;
+}
+#define tdm_pins                (board->pins)
+static uint32_t found_cfg[TDM_PINS], found_io[TDM_PINS];
+static bool pins_taken;
+
+static void
+pins_on(void)
+{
+	for (unsigned i = 0; i < TDM_PINS; i++) {
+		found_cfg[i] = get(&tlmm, tdm_pins[i].name, GPIO_CFG(tdm_pins[i].pin));
+		found_io[i] = get(&tlmm, tdm_pins[i].name, GPIO_IO(tdm_pins[i].pin));
+	}
+	pins_taken = true;
+	for (unsigned i = 0; i < TDM_PINS; i++) {
+		put(&tlmm, tdm_pins[i].name, GPIO_IO(tdm_pins[i].pin), tdm_pins[i].io);
+		put(&tlmm, tdm_pins[i].name, GPIO_CFG(tdm_pins[i].pin), tdm_pins[i].cfg);
+	}
+}
+
+static void
+pins_off(void)
+{
+	if (!pins_taken) {
+		return;
+	}
+	for (unsigned i = 0; i < TDM_PINS; i++) {
+		put(&tlmm, tdm_pins[i].name, GPIO_CFG(tdm_pins[i].pin), found_cfg[i]);
+		put(&tlmm, tdm_pins[i].name, GPIO_IO(tdm_pins[i].pin), found_io[i] & 2);
+		get(&tlmm, tdm_pins[i].name, GPIO_CFG(tdm_pins[i].pin));
+	}
+	pins_taken = false;
+}
+
+/* Whether a pin toggles: read many times as fast as it goes. */
+static void
+pin_activity(unsigned pin, const char *name, uint32_t *changes, uint32_t *ones)
+{
+	uint32_t last = rd(tlmm.base + GPIO_IO(pin)) & 1, reads = 20000;
+	uint64_t began = now_us();
+
+	*changes = *ones = 0;
+	for (uint32_t i = 0; i < reads; i++) {
+		uint32_t now = rd(tlmm.base + GPIO_IO(pin)) & 1;
+
+		*changes += now != last;
+		*ones += now;
+		last = now;
+	}
+	say("sound: %s: %u changes and %u ones in %u reads (%llu us)\n", name, *changes, *ones, reads, now_us() - began);
+}
+
+/* ---- APR ------------------------------------------------------------------------------------------- */
+
+#define APR_SVC_AFE             4
+#define APR_SVC_ASM             7
+#define APR_SVC_ADM             8
+#define APR_BASIC_RSP_RESULT    0x000110e8u
+#define APR_WAIT_MS             1000
+
+static const char *
+dsp_error(uint32_t status)
+{
+	static const char *const names[] = { "ok", "failed", "bad parameter", "unsupported", "version", "unexpected", "panic",
+		                             "no resource", "bad handle", "already", "not ready", "pending", "busy", "aborted",
+		                             "preempted", "continue", "immediate", "not implemented", "need more", "no memory",
+		                             "not there" };
+
+	return status < sizeof(names) / sizeof(names[0]) ? names[status] : "an error this does not know";
+}
+
+/*
+ * One command, its answer waited for: true if the answer is the basic one with status 0, or the
+ * opcode `wanted' (then in *answer).
+ */
+static bool
+command(const char *what, uint8_t service, uint16_t port, uint32_t opcode, const void *payload, uint32_t length, uint32_t wanted,
+    struct hakios_apr_answer *answer)
+{
+	struct hakios_apr_answer local;
+
+	if (answer == NULL) {
+		answer = &local;
+	}
+	snprintf(last_write, sizeof(last_write), "sent %s (opcode %#x)", what, opcode);
+	if (!hakios_adsp_apr(service, port, 0, opcode, payload, length, APR_WAIT_MS, answer)) {
+		say("sound: %s (opcode %#x to service %u, port %#x): NO ANSWER\n", what, opcode, service, port);
+		return false;
+	}
+	if (answer->opcode == APR_BASIC_RSP_RESULT && answer->words[0] == opcode) {
+		say("sound: %s: %s%s\n", what, answer->words[1] == 0 ? "done" : "REFUSED: ", answer->words[1] == 0 ? "" :
+		    dsp_error(answer->words[1]));
+		return answer->words[1] == 0 && wanted == 0;
+	}
+	if (wanted != 0 && answer->opcode == wanted) {
+		return true;
+	}
+	say("sound: %s: an answer not expected: opcode %#x, %u bytes: %#x %#x\n", what, answer->opcode, answer->length,
+	    answer->words[0], answer->words[1]);
+	return false;
+}
+
+/* ---- AFE: the port ---------------------------------------------------------------------------------- */
+
+#define AFE_PORT_CMD_DEVICE_START               0x000100e5u
+#define AFE_PORT_CMD_DEVICE_STOP                0x000100e6u
+#define AFE_PORT_CMD_SET_PARAM_V2               0x000100efu
+#define AFE_SVC_CMD_SET_PARAM                   0x000100f3u
+#define AFE_MODULE_AUDIO_DEV_INTERFACE          0x0001020cu
+#define AFE_PARAM_ID_TDM_CONFIG                 0x0001029du
+#define AFE_MODULE_TDM                          0x0001028au
+#define AFE_PARAM_ID_PORT_SLOT_MAPPING_CONFIG   0x00010297u
+#define AFE_MODULE_GROUP_DEVICE                 0x00010254u
+#define AFE_PARAM_ID_GROUP_DEVICE_ENABLE        0x00010256u
+#define AFE_PARAM_ID_GROUP_DEVICE_TDM_CONFIG    0x0001029eu
+#define AFE_MODULE_CLOCK_SET                    0x0001028fu
+#define AFE_PARAM_ID_CLOCK_SET                  0x00010290u
+
+#define AFE_PARAM_ID_I2S_CONFIG                 0x0001020du
+#define PORT                    (board->port)   /* sm7325: PRI_TDM_RX_0 0x9000; cepheus: QUAT_MI2S_RX 0x1006 */
+#define GROUP                   0x9100          /* PRI_TDM_RX */
+#define GROUP_OTHER_PORT        0x9002
+#define PORT_INVALID            0xffff
+#define CLOCK_PRI_TDM_IBIT      0x200
+#define CLOCK_INVERT_COUPLE_NO  4
+#define RATE                    48000
+#define SLOTS                   2
+#define SLOT_BITS               32
+#define PORT_BITS               32              /* the mixer path's S32_LE (sm7325's TDM) */
+
+struct afe_param {
+	uint32_t module, param;
+	uint16_t size, reserved;
+} __attribute__((packed));
+
+struct afe_clock_set {
+	uint32_t version, id, hz;
+	uint16_t attribute, root;
+	uint32_t enable;
+} __attribute__((packed));
+
+struct afe_group_tdm {
+	uint32_t version;
+	uint16_t group, reserved;
+	uint16_t ports[8];
+	uint32_t channels, rate, bits;
+	uint16_t slots, slot_bits;
+	uint32_t slot_mask;
+} __attribute__((packed));
+
+struct afe_group_enable {
+	uint16_t group, enable;
+} __attribute__((packed));
+
+struct afe_tdm {
+	uint32_t version, channels, rate, bits;
+	uint16_t data_format, sync_mode, sync_source, slots, data_out, invert_sync, data_delay, slot_bits;
+	uint32_t slot_mask;
+} __attribute__((packed));
+
+struct afe_i2s {
+	uint32_t version;
+	uint16_t bits, lines, mono_stereo, word_select;
+	uint32_t rate;
+	uint16_t data_format, reserved;
+} __attribute__((packed));
+
+struct afe_slot_mapping {
+	uint32_t version;
+	uint16_t channels, bits;
+	uint32_t align;
+	uint16_t offsets[8];
+} __attribute__((packed));
+
+/* A parameter for the AFE as a whole (its clocks, its groups): in the packet, not in shared memory. */
+static bool
+afe_service_param(const char *what, uint32_t module, uint32_t param, const void *data, uint16_t size)
+{
+	uint8_t packet[16 + sizeof(struct afe_param) + 64];
+	uint32_t *head = (uint32_t *)packet;
+	struct afe_param *p = (struct afe_param *)(packet + 16);
+
+	bzero(packet, sizeof(packet));
+	head[0] = (uint32_t)sizeof(*p) + size;          /* payload size; address 0 and handle 0: in band */
+	p->module = module;
+	p->param = param;
+	p->size = size;
+	memcpy(packet + 16 + sizeof(*p), data, size);
+	return command(what, APR_SVC_AFE, 0, AFE_SVC_CMD_SET_PARAM, packet, 16 + (uint32_t)sizeof(*p) + size, 0, NULL);
+}
+
+/* A parameter of the port. */
+static bool
+afe_port_param(const char *what, uint32_t module, uint32_t param, const void *data, uint16_t size)
+{
+	uint8_t packet[16 + sizeof(struct afe_param) + 64];
+	struct afe_param *p = (struct afe_param *)(packet + 16);
+
+	bzero(packet, sizeof(packet));
+	*(uint16_t *)packet = PORT;
+	*(uint16_t *)(packet + 2) = (uint16_t)(sizeof(*p) + size);
+	p->module = module;
+	p->param = param;
+	p->size = size;
+	memcpy(packet + 16 + sizeof(*p), data, size);
+	return command(what, APR_SVC_AFE, 0, AFE_PORT_CMD_SET_PARAM_V2, packet, 16 + (uint32_t)sizeof(*p) + size, 0, NULL);
+}
+
+static bool clock_on, group_on, port_on;
+
+static bool
+afe_clock(bool on)
+{
+	struct afe_clock_set clock = { 1, board->clock_id, board->clock_hz, board->clock_attribute, 0, on };
+	char what[80];
+
+	snprintf(what, sizeof(what), on ? "the interface's bit clock (%#x) at %u Hz, on" : "the interface's bit clock (%#x), off",
+	    board->clock_id, board->clock_hz);
+	return afe_service_param(what, AFE_MODULE_CLOCK_SET, AFE_PARAM_ID_CLOCK_SET, &clock, sizeof(clock));
+}
+
+static bool
+afe_on(void)
+{
+	struct afe_group_tdm group = {
+		.version = 1, .group = GROUP, .ports = { PORT, GROUP_OTHER_PORT, PORT_INVALID, PORT_INVALID, PORT_INVALID,
+		                                         PORT_INVALID, PORT_INVALID, PORT_INVALID },
+		.channels = SLOTS, .rate = RATE, .bits = SLOT_BITS, .slots = SLOTS, .slot_bits = SLOT_BITS, .slot_mask = 3,
+	};
+	struct afe_group_enable enable = { GROUP, 1 };
+	struct afe_tdm tdm = {
+		.version = 1, .channels = 2, .rate = RATE, .bits = PORT_BITS, .data_format = 0, .sync_mode = 0, .sync_source = 1,
+		.slots = SLOTS, .data_out = 0, .invert_sync = 1, .data_delay = 1, .slot_bits = SLOT_BITS, .slot_mask = 3,
+	};
+	struct afe_slot_mapping mapping = { .version = 1, .channels = 2, .bits = PORT_BITS, .align = 0,
+		                            .offsets = { 0, 4, 0xffff, 0xffff, 0xffff, 0xffff, 0xffff, 0xffff } };
+	uint16_t start[2] = { PORT, 0 };
+
+	if (board->i2s) {
+		/* one channel of 24 bits on SD0 at 48 kHz, the word select ours (msm-dai-q6-v2.c, for the mixer path's S24_LE) */
+		struct afe_i2s i2s = { .version = 1, .bits = board->port_bits, .lines = 1, .mono_stereo = board->port_channels > 1,
+			               .word_select = 1, .rate = RATE, .data_format = 0, .reserved = 0 };
+
+		announce("the DSP is asked for the MI2S interface's bit clock, the port and its start (AFE)");
+		clock_on = afe_clock(true);
+		if (!clock_on) {
+			return false;
+		}
+		if (!afe_port_param("the port: I2S, 1 channel of 24 bits on SD0 at 48 kHz, the word select ours",
+		    AFE_MODULE_AUDIO_DEV_INTERFACE, AFE_PARAM_ID_I2S_CONFIG, &i2s, sizeof(i2s))) {
+			return false;
+		}
+		port_on = command("the port, started", APR_SVC_AFE, 0, AFE_PORT_CMD_DEVICE_START, start, sizeof(start), 0, NULL);
+		return port_on;
+	}
+	announce("the DSP is asked for the TDM interface's bit clock, the group, the port and its start (AFE)");
+	clock_on = afe_clock(true);
+	if (!clock_on) {
+		return false;
+	}
+	group_on = afe_service_param("the group 0x9100: ports 0x9000 0x9002, 2 slots of 32 bits, 48 kHz", AFE_MODULE_GROUP_DEVICE,
+	    AFE_PARAM_ID_GROUP_DEVICE_TDM_CONFIG, &group, sizeof(group)) &&
+	    afe_service_param("the group 0x9100, on", AFE_MODULE_GROUP_DEVICE, AFE_PARAM_ID_GROUP_DEVICE_ENABLE, &enable,
+	    sizeof(enable));
+	if (!group_on) {
+		return false;
+	}
+	if (!afe_port_param("the port 0x9000: 2 channels of 32 bits at 48 kHz in 2 slots, sync 0 1, inverted, delay 1",
+	    AFE_MODULE_AUDIO_DEV_INTERFACE, AFE_PARAM_ID_TDM_CONFIG, &tdm, sizeof(tdm)) ||
+	    !afe_port_param("the port's slots: channels at bytes 0 and 4", AFE_MODULE_TDM, AFE_PARAM_ID_PORT_SLOT_MAPPING_CONFIG,
+	    &mapping, sizeof(mapping))) {
+		return false;
+	}
+	port_on = command("the port 0x9000, started", APR_SVC_AFE, 0, AFE_PORT_CMD_DEVICE_START, start, sizeof(start), 0, NULL);
+	return port_on;
+}
+
+static void
+afe_off(void)
+{
+	uint16_t stop[2] = { PORT, 0 };
+	struct afe_group_enable disable = { GROUP, 0 };
+
+	if (port_on) {
+		command("the port, stopped", APR_SVC_AFE, 0, AFE_PORT_CMD_DEVICE_STOP, stop, sizeof(stop), 0, NULL);
+		port_on = false;
+	}
+	if (group_on) {
+		afe_service_param("the group 0x9100, off", AFE_MODULE_GROUP_DEVICE, AFE_PARAM_ID_GROUP_DEVICE_ENABLE, &disable,
+		    sizeof(disable));
+		group_on = false;
+	}
+	if (clock_on) {
+		afe_clock(false);
+		clock_on = false;
+	}
+}
+
+/* ---- the DSP's view of our memory: stream 0x1801 of the SMMU ------------------------------------------- */
+
+static struct block apps_smmu = { "apps smmu", 0x15000000, 0x2000 };
+static struct block apps_smmu_second = { "apps smmu", 0, 0x1000 };              /* the second page: a word per context */
+static struct block apps_smmu_context = { "apps smmu, the audio context", 0, 0x1000 };
+#define SMMU_SCR0               0x000
+#define SMMU_IDR0               0x020
+#define SMMU_IDR1               0x024
+#define SMMU_SGFSR              0x048
+#define SMMU_SGFSYNR1           0x054
+#define SMMU_SMR(n)             (0x800 + 4 * (n))       /* bit 31 valid, [30:16] mask, [14:0] stream */
+#define SMMU_S2CR(n)            (0xc00 + 4 * (n))       /* [17:16] 0 translate 1 bypass 2 fault, [7:0] context */
+#define SMMU_CBAR(n)            (4 * (n))
+#define SMMU_CBAR_STAGE_1       (1u << 16 | 3u << 8 | 0xfu << 12)
+#define SMMU_CBA2R(n)           (0x800 + 4 * (n))
+#define SMMU_CBA2R_64_BIT       1
+#define SMMU_CB_SCTLR           0x00
+#define SMMU_CB_TCR2            0x10
+#define SMMU_CB_TTBR0           0x20
+#define SMMU_CB_TTBR1           0x28
+#define SMMU_CB_TCR             0x30
+#define SMMU_CB_MAIR0           0x38
+#define SMMU_CB_MAIR1           0x3c
+#define SMMU_CB_FSR             0x58
+#define SMMU_CB_FAR             0x60
+#define SMMU_CB_FSYNR0          0x68
+#define SMMU_CB_TLBIASID        0x610
+#define SMMU_CB_TLBSYNC         0x7f0
+#define SMMU_CB_TLBSTATUS       0x7f4
+#define SMMU_SCTLR_ON           (1u << 0 | 1u << 1 | 1u << 2 | 1u << 5 | 1u << 8 | 1u << 12)
+#define SMMU_TCR_39_BITS        (25u | 1u << 8 | 1u << 10 | 3u << 12 | 1u << 23)
+#define SMMU_TCR2               (1u | 1u << 4 | 7u << 15)
+#define SMMU_MAIR0              0xf404ff44
+#define SMMU_FSR_ALL            0xc00001fe
+#define PTE_ADDRESS             0x0000fffffffff000ull
+#define AUDIO_PTE               (3ull | 1ull << 6 | 2ull << 8 | 1ull << 10 | 1ull << 11)       /* as hakios.wifi.c's */
+
+#define AUDIO_STREAM            (board->stream) /* sm7325 0x1801, cepheus 0x1b21 */
+#define AUDIO_ADDRESSES         0x10000000ull   /* dt: qcom,iommu-dma-addr-pool of qcom,msm-audio-ion */
+#define AUDIO_STREAM_BITS       ((uint64_t)(AUDIO_STREAM & 0xf) << 32)  /* the stream's low bits (& 0xf: 1 on both phones),
+	                                                                   where the DSP takes them from */
+
+#define PERIODS                 8
+#define PERIOD_FRAMES           960             /* 20 ms */
+#define PERIOD_BYTES            (PERIOD_FRAMES * 4)
+#define BUFFER_BYTES            (PERIODS * 4096)        /* a page each */
+#define MIC_BYTES               (16 * 4096)             /* the microphones' (hakios.mic.c), behind the periods */
+#define SHARED_BYTES            (BUFFER_BYTES + MIC_BYTES)
+
+static struct {
+	bool found, on, passed;         /* passed: the boot chain lets the stream through untranslated */
+	uint32_t page, pages, match, context, old_smr, old_s2cr, old_sctlr;
+	vm_offset_t tables;             /* three of 4K: the root, one of the second level, one of the third */
+} space;
+static vm_offset_t buffer;              /* BUFFER_BYTES of ours, the periods (and MIC_BYTES behind them: the microphones') */
+static uint64_t buffer_address;         /* as the DSP is to know it */
+
+static bool
+space_find(void)
+{
+	bool used[256] = { false };
+	uint32_t scr0 = get(&apps_smmu, "scr0", SMMU_SCR0), idr0 = get(&apps_smmu, "idr0", SMMU_IDR0);
+	uint32_t idr1 = get(&apps_smmu, "idr1", SMMU_IDR1), matches = idr0 & 0xff, contexts = idr1 & 0xff;
+
+	if (scr0 & 1u << 3) {
+		say("sound: this SMMU numbers its streams with 16 bits, which nothing here is written for\n");
+		return false;
+	}
+	space.page = idr1 >> 31 ? 0x10000 : 0x1000;
+	space.pages = 2u << (idr1 >> 28 & 7);
+	if (2 * space.pages * space.page != 0x100000) {
+		say("sound: the SMMU says it has 2 x %u pages of %#x bytes, not a megabyte: its contexts are not looked for\n",
+		    space.pages, space.page);
+		return false;
+	}
+	space.match = ~0u;
+	for (uint32_t n = 0; n < matches && SMMU_SMR(n) < 0xc00; n++) {
+		uint32_t smr = rd(apps_smmu.base + SMMU_SMR(n)), s2cr = rd(apps_smmu.base + SMMU_S2CR(n));
+		uint32_t stream = smr & 0x7fff, mask = smr >> 16 & 0x7fff;
+
+		if (smr >> 31) {
+			used[s2cr & 0xff] = true;
+			if (((stream ^ AUDIO_STREAM) & ~mask) == 0) {
+				say("sound: match register %u covers the audio stream already: stream %#x mask %#x, s2cr %#x\n", n,
+				    stream, mask, s2cr);
+				if ((s2cr >> 16 & 3) == 1) {
+					space.passed = true;
+					return true;
+				}
+				say("sound: ... and does not let it through untranslated: it is somebody's, and is left alone\n");
+				return false;
+			}
+		} else if (space.match == ~0u) {
+			space.match = n;
+			space.old_smr = smr;
+			space.old_s2cr = s2cr;
+		}
+	}
+	for (space.context = 0; space.context < contexts && used[space.context]; space.context++) {
+	}
+	if (space.match == ~0u || space.context >= contexts) {
+		say("sound: the SMMU has no match register or no context left\n");
+		return false;
+	}
+	apps_smmu_second.phys = apps_smmu.phys + space.page;
+	apps_smmu_context.phys = apps_smmu.phys + (space.pages + space.context) * space.page;
+	say("sound: the boot chain has set nothing up for stream %#x; free: match register %u (smr %#x, s2cr %#x) and context %u, at "
+	    "%#x\n", AUDIO_STREAM, space.match, space.old_smr, space.old_s2cr, space.context, apps_smmu_context.phys);
+	space.old_sctlr = get(&apps_smmu_context, "sctlr", SMMU_CB_SCTLR);
+	if (space.old_sctlr & 1) {
+		say("sound: CONTEXT %u IS SWITCHED ON although no stream is sent through it: it is somebody's, and is left alone\n",
+		    space.context);
+		return false;
+	}
+	space.found = true;
+	return true;
+}
+
+static void
+space_faults(void)
+{
+	uint32_t status, global;
+
+	if (!space.on) {
+		return;
+	}
+	status = rd(apps_smmu_context.base + SMMU_CB_FSR);
+	global = rd(apps_smmu.base + SMMU_SGFSR);
+	if ((status & SMMU_FSR_ALL) == 0 && global == 0) {
+		say("sound: the SMMU has refused the DSP nothing (context %u: fsr %#x; sgfsr 0)\n", space.context, status);
+		return;
+	}
+	say("sound: THE SMMU HAS REFUSED A REQUEST: context %u: status %#x, address %#llx, syndrome %#x; the SMMU as a whole: status "
+	    "%#x, stream %#x\n", space.context, status, (uint64_t)rd(apps_smmu_context.base + SMMU_CB_FAR + 4) << 32 |
+	    rd(apps_smmu_context.base + SMMU_CB_FAR), rd(apps_smmu_context.base + SMMU_CB_FSYNR0), global,
+	    rd(apps_smmu.base + SMMU_SGFSYNR1));
+}
+
+/* Our buffer behind the DSP's addresses from AUDIO_ADDRESSES on, through a context of ours. */
+static bool
+space_on(void)
+{
+	uint64_t *root, *second, *third, table_root;
+	uint32_t smr = SMMU_SMR(space.match), s2cr = SMMU_S2CR(space.match), sees = 1u << 31 | AUDIO_STREAM;
+
+	/*
+	 * (the page tables are allocated once and reused: this runs at every first user of the DSP's buffers, and nothing frees
+	 * the tables, so a new allocation each time would lose 12 KB of wired memory per recording or run)
+	 */
+	if (space.tables != 0) {
+		bzero((void *)space.tables, 3 * 4096);
+	} else if (kmem_alloc(kernel_map, &space.tables, 3 * 4096, KMA_KOBJECT | KMA_ZERO | KMA_DATA, VM_KERN_MEMORY_IOKIT) !=
+	    KERN_SUCCESS) {
+		space.tables = 0;
+		return false;
+	}
+	root = (uint64_t *)space.tables;
+	second = (uint64_t *)(space.tables + 4096);
+	third = (uint64_t *)(space.tables + 8192);
+	root[AUDIO_ADDRESSES >> 30 & 0x1ff] = kvtophys((vm_offset_t)second) | 3;
+	second[AUDIO_ADDRESSES >> 21 & 0x1ff] = kvtophys((vm_offset_t)third) | 3;
+	for (unsigned page = 0; page < SHARED_BYTES / 4096; page++) {
+		third[(AUDIO_ADDRESSES >> 12 & 0x1ff) + page] = kvtophys(buffer + 4096 * page) | AUDIO_PTE;
+	}
+	for (vm_offset_t line = space.tables; line < space.tables + 3 * 4096; line += 64) {
+		__asm__ volatile ("dc civac, %0" : : "r" (line));
+	}
+	__asm__ volatile ("dsb sy");
+	table_root = kvtophys(space.tables) | (uint64_t)space.context << 48;
+	say("sound: THE SMMU IS ABOUT TO BE WRITTEN: context %u gets page tables of ours (root %#llx) for the %u KB of the periods and the microphones' "
+	    "at %#llx, and match register %u sends stream %#x through it\n", space.context, table_root & PTE_ADDRESS,
+	    SHARED_BYTES / 1024, AUDIO_ADDRESSES, space.match, AUDIO_STREAM);
+	if (pause_ms) {
+		sleep_ms(pause_ms);
+	}
+	put(&apps_smmu_context, "sctlr", SMMU_CB_SCTLR, 0);
+	put(&apps_smmu_second, "cba2r", SMMU_CBA2R(space.context), SMMU_CBA2R_64_BIT);
+	put(&apps_smmu_second, "cbar", SMMU_CBAR(space.context), SMMU_CBAR_STAGE_1);
+	put(&apps_smmu_context, "tcr2", SMMU_CB_TCR2, SMMU_TCR2);
+	put(&apps_smmu_context, "tcr", SMMU_CB_TCR, SMMU_TCR_39_BITS);
+	put(&apps_smmu_context, "ttbr0, low", SMMU_CB_TTBR0, (uint32_t)table_root);
+	put(&apps_smmu_context, "ttbr0, high", SMMU_CB_TTBR0 + 4, (uint32_t)(table_root >> 32));
+	put(&apps_smmu_context, "ttbr1, low", SMMU_CB_TTBR1, 0);
+	put(&apps_smmu_context, "ttbr1, high", SMMU_CB_TTBR1 + 4, 0);
+	put(&apps_smmu_context, "mair0", SMMU_CB_MAIR0, SMMU_MAIR0);
+	put(&apps_smmu_context, "mair1", SMMU_CB_MAIR1, 0);
+	put(&apps_smmu_context, "fsr", SMMU_CB_FSR, SMMU_FSR_ALL);
+	put(&apps_smmu_context, "tlbiasid", SMMU_CB_TLBIASID, space.context);
+	put(&apps_smmu_context, "tlbsync", SMMU_CB_TLBSYNC, 1);
+	for (unsigned ms = 0; rd(apps_smmu_context.base + SMMU_CB_TLBSTATUS) & 1; ms++) {
+		if (ms == 100) {
+			say("sound: the SMMU does not finish forgetting old translations\n");
+			return false;
+		}
+		sleep_ms(1);
+	}
+	put(&apps_smmu_context, "sctlr", SMMU_CB_SCTLR, SMMU_SCTLR_ON);
+	space.on = true;
+	put(&apps_smmu, "s2cr", s2cr, space.context);
+	put(&apps_smmu, "smr", smr, sees);
+	if (get(&apps_smmu, "smr", smr) != sees || (get(&apps_smmu, "s2cr", s2cr) & 0x300ff) != space.context ||
+	    !(get(&apps_smmu_context, "sctlr", SMMU_CB_SCTLR) & 1) ||
+	    get(&apps_smmu_context, "ttbr0, low", SMMU_CB_TTBR0) != (uint32_t)table_root) {
+		say("sound: THE SMMU DID NOT TAKE WHAT WAS WRITTEN: stream %#x is not going through context %u\n", AUDIO_STREAM,
+		    space.context);
+		return false;
+	}
+	say("sound: THE AUDIO STREAM GOES THROUGH CONTEXT %u of the SMMU, with our page tables\n", space.context);
+	return true;
+}
+
+static void
+space_off(void)
+{
+	if (!space.on) {
+		return;
+	}
+	space_faults();
+	say("sound: the audio stream and context %u of the SMMU are put back as they were found\n", space.context);
+	put(&apps_smmu, "smr", SMMU_SMR(space.match), space.old_smr);
+	put(&apps_smmu, "s2cr", SMMU_S2CR(space.match), space.old_s2cr);
+	put(&apps_smmu_context, "sctlr", SMMU_CB_SCTLR, space.old_sctlr);
+	get(&apps_smmu, "smr", SMMU_SMR(space.match));
+	space.on = false;
+}
+
+/*
+ * The DSP's view of our memory is one: the sound's periods and the microphones' buffers behind them
+ * (hakios.mic.c), through the same stream and context. Whoever comes first sets it up, whoever
+ * leaves last takes it down. user: 0 the sound, 1 the microphones. With hakios_smmu_lock held.
+ */
+static uint32_t space_users;
+
+static bool
+shared_get(unsigned user)
+{
+	if (space_users == 0) {
+		if (buffer == 0 && kmem_alloc(kernel_map, &buffer, SHARED_BYTES, KMA_KOBJECT | KMA_ZERO | KMA_DATA,
+		    VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+			buffer = 0;
+			say("sound: no memory for the DSP's buffers\n");
+			return false;
+		}
+		if (!space.found && !space.passed && !space_find()) {
+			return false;
+		}
+		if (!space.passed && !space.on && !space_on()) {
+			return false;
+		}
+		buffer_address = space.passed ? (kvtophys(buffer) | AUDIO_STREAM_BITS) : (AUDIO_ADDRESSES | AUDIO_STREAM_BITS);
+		if (space.passed) {
+			for (unsigned page = 1; page < SHARED_BYTES / 4096; page++) {
+				if (kvtophys(buffer + 4096 * page) != kvtophys(buffer) + 4096 * page) {
+					say("sound: the DSP's buffers are not one piece of memory, and the stream is not translated\n");
+					return false;
+				}
+			}
+		}
+	}
+	space_users |= 1u << user;
+	return true;
+}
+
+static void
+shared_put(unsigned user)
+{
+	if (!(space_users & 1u << user)) {
+		return;
+	}
+	space_users &= ~(1u << user);
+	if (space_users == 0) {
+		space_off();
+	}
+}
+
+bool
+hakios_audio_dsp_memory(uintptr_t *memory, uint64_t *dsp_address, uint32_t *bytes)
+{
+	bool ok;
+
+	lck_mtx_lock(&hakios_smmu_lock);
+	ok = shared_get(1);
+	lck_mtx_unlock(&hakios_smmu_lock);
+	if (ok) {
+		*memory = buffer + BUFFER_BYTES;
+		*dsp_address = buffer_address + BUFFER_BYTES;
+		*bytes = MIC_BYTES;
+	}
+	return ok;
+}
+
+void
+hakios_audio_dsp_memory_put(void)
+{
+	lck_mtx_lock(&hakios_smmu_lock);
+	shared_put(1);
+	lck_mtx_unlock(&hakios_smmu_lock);
+}
+
+/* ---- ADM and ASM: the path and the stream --------------------------------------------------------------- */
+
+#define ADM_CMD_DEVICE_OPEN_V5                  0x00010326u
+#define ADM_CMDRSP_DEVICE_OPEN_V5               0x00010329u
+#define ADM_CMD_DEVICE_CLOSE_V5                 0x00010327u
+#define ADM_CMD_MATRIX_MAP_ROUTINGS_V5          0x00010325u
+#define ADM_PATH_PLAYBACK                       1
+#define ADM_MATRIX_AUDIO_RX                     0
+#define ADM_TOPOLOGY_NONE                       0x00010312u
+#define ADM_BITS                                24
+
+#define ASM_CMD_SHARED_MEM_MAP_REGIONS          0x00010d92u
+#define ASM_CMDRSP_SHARED_MEM_MAP_REGIONS       0x00010d93u
+#define ASM_CMD_SHARED_MEM_UNMAP_REGIONS        0x00010d94u
+#define ASM_STREAM_CMD_OPEN_WRITE_V3            0x00010db3u
+#define ASM_DATA_CMD_MEDIA_FMT_UPDATE_V2        0x00010d98u
+#define ASM_SESSION_CMD_RUN_V2                  0x00010daau
+#define ASM_DATA_CMD_WRITE_V2                   0x00010dabu
+#define ASM_DATA_EVENT_WRITE_DONE_V2            0x00010d99u
+#define ASM_SESSION_EVENT_RX_UNDERFLOW          0x00010c17u
+#define ASM_STREAM_CMD_CLOSE                    0x00010bcdu
+#define ASM_TOPOLOGY_NONE                       0x00010c68u
+#define ASM_MEDIA_FMT_MULTI_CHANNEL_PCM_V2      0x00010da5u
+#define ASM_SHMEM_4K_POOL                       3
+#define SESSION                                 1
+#define STREAM_PORT                             (SESSION << 8 | 1)
+#define WRITE_TOKEN                             0x80000000u     /* | the period: what a write's "done" carries back */
+#define PCM_CHANNEL_FL                          1
+#define PCM_CHANNEL_FR                          2
+#define PCM_CHANNEL_FC                          3
+
+static volatile bool stopping;          /* the run is ending: whatever plays stops */
+static bool mapped, copp_open, stream_open;
+static uint32_t map_handle, copp;
+static volatile uint32_t returned;      /* the periods the DSP has said it is done with (a bit each) */
+static volatile uint32_t written_done, underflows, write_errors;
+
+/* The DSP's events: the "done" of every write, and underflows. On the link's thread. */
+static bool
+events(uint8_t service, __unused uint16_t port, uint32_t opcode, uint32_t token, const uint32_t *payload, uint32_t length)
+{
+	if (service != APR_SVC_ASM) {
+		return false;
+	}
+	if (opcode == ASM_DATA_EVENT_WRITE_DONE_V2 && (token & WRITE_TOKEN)) {
+		if (length >= 16 && payload[3] != 0) {
+			OSIncrementAtomic((volatile SInt32 *)&write_errors);
+		}
+		OSIncrementAtomic((volatile SInt32 *)&written_done);
+		OSBitOrAtomic(1u << (token & 31), &returned);
+		return true;
+	}
+	if (opcode == APR_BASIC_RSP_RESULT && (token & WRITE_TOKEN)) {
+		/* (a write the DSP refused outright: it answers it as a command) */
+		OSIncrementAtomic((volatile SInt32 *)&write_errors);
+		OSIncrementAtomic((volatile SInt32 *)&written_done);
+		OSBitOrAtomic(1u << (token & 31), &returned);
+		return true;
+	}
+	if (opcode == ASM_SESSION_EVENT_RX_UNDERFLOW) {
+		OSIncrementAtomic((volatile SInt32 *)&underflows);
+		return true;
+	}
+	return false;
+}
+
+static bool
+stream_on(void)
+{
+	struct {
+		uint16_t pool, regions;
+		uint32_t property;
+		uint32_t low, high, size;
+	} __attribute__((packed)) map = { ASM_SHMEM_4K_POOL, 1, 0, (uint32_t)buffer_address, (uint32_t)(buffer_address >> 32),
+		                          BUFFER_BYTES };
+	struct {
+		uint16_t flags, mode, endpoint1, endpoint2;
+		uint32_t topology;
+		uint16_t channels, bits;
+		uint32_t rate;
+		uint8_t map[8];
+	} __attribute__((packed)) open = { 0, ADM_PATH_PLAYBACK, PORT, 0xffff, ADM_TOPOLOGY_NONE, board->adm_channels, ADM_BITS, RATE,
+		                           { board->adm_channels == 1 ? PCM_CHANNEL_FC : PCM_CHANNEL_FL,
+		                             board->adm_channels == 1 ? 0 : PCM_CHANNEL_FR } };
+	struct {
+		uint32_t matrix, sessions;
+		uint16_t session, copps;
+		uint16_t copp[2];
+	} __attribute__((packed)) route = { ADM_MATRIX_AUDIO_RX, 1, SESSION, 1, { 0, 0 } };
+	struct {
+		uint32_t flags;
+		uint16_t sink, bits;
+		uint32_t topology, format;
+	} __attribute__((packed)) write = { 0, 0, 16, ASM_TOPOLOGY_NONE, ASM_MEDIA_FMT_MULTI_CHANNEL_PCM_V2 };
+	struct {
+		uint32_t size;
+		uint16_t channels, bits;
+		uint32_t rate;
+		uint16_t is_signed, reserved;
+		uint8_t map[8];
+	} __attribute__((packed)) format = { 20, 2, 16, RATE, 1, 0, { PCM_CHANNEL_FL, PCM_CHANNEL_FR } };
+	uint32_t run[3] = { 0, 0, 0 };
+	struct hakios_apr_answer answer;
+
+	announce("the DSP is given our periods (ASM), a device path to the port (ADM) and a stream routed to it (ASM)");
+	if (!command("our periods, mapped for the DSP", APR_SVC_ASM, 0, ASM_CMD_SHARED_MEM_MAP_REGIONS, &map, sizeof(map),
+	    ASM_CMDRSP_SHARED_MEM_MAP_REGIONS, &answer)) {
+		return false;
+	}
+	mapped = true;
+	map_handle = answer.words[0];
+	say("sound: our %u KB at %#llx are the DSP's handle %#x\n", BUFFER_BYTES / 1024, buffer_address, map_handle);
+	if (!command(board->adm_channels == 1 ? "a device path to the port: playback, no processing, 1 channel (front centre) of 24 "
+	    "bits at 48 kHz" : "a device path to the port: playback, no processing, 2 channels of 24 bits at 48 kHz", APR_SVC_ADM, PORT,
+	    ADM_CMD_DEVICE_OPEN_V5, &open, sizeof(open), ADM_CMDRSP_DEVICE_OPEN_V5, &answer)) {
+		return false;
+	}
+	if (answer.words[0] != 0) {
+		say("sound: the device path: REFUSED: %s\n", dsp_error(answer.words[0]));
+		return false;
+	}
+	copp_open = true;
+	copp = answer.words[1] & 0xffff;        /* (the upper half is reserved) */
+	route.copp[0] = (uint16_t)copp;
+	say("sound: the device path is open: COPP %u\n", copp);
+	if (!command("the stream, opened for writing: 16-bit linear PCM, no processing", APR_SVC_ASM, STREAM_PORT,
+	    ASM_STREAM_CMD_OPEN_WRITE_V3, &write, sizeof(write), 0, NULL)) {
+		return false;
+	}
+	stream_open = true;
+	return command("session 1 routed to the device path", APR_SVC_ADM, 0, ADM_CMD_MATRIX_MAP_ROUTINGS_V5, &route, sizeof(route),
+	           0, NULL) &&
+	       command("the stream's format: 2 channels of 16 bits at 48 kHz, left and right", APR_SVC_ASM, STREAM_PORT,
+	           ASM_DATA_CMD_MEDIA_FMT_UPDATE_V2, &format, sizeof(format), 0, NULL) &&
+	       command("the session, run", APR_SVC_ASM, STREAM_PORT, ASM_SESSION_CMD_RUN_V2, run, sizeof(run), 0, NULL);
+}
+
+static void
+stream_off(void)
+{
+	uint32_t handle = map_handle;
+
+	if (stream_open) {
+		command("the stream, closed", APR_SVC_ASM, STREAM_PORT, ASM_STREAM_CMD_CLOSE, NULL, 0, 0, NULL);
+		stream_open = false;
+	}
+	if (copp_open) {
+		command("the device path, closed", APR_SVC_ADM, (uint16_t)copp, ADM_CMD_DEVICE_CLOSE_V5, NULL, 0, 0, NULL);
+		copp_open = false;
+	}
+	if (mapped) {
+		command("our periods, unmapped", APR_SVC_ASM, 0, ASM_CMD_SHARED_MEM_UNMAP_REGIONS, &handle, sizeof(handle), 0, NULL);
+		mapped = false;
+	}
+}
+
+/* ---- the test tone ----------------------------------------------------------------------------------- */
+
+/* 1 kHz at 48 kHz, -20 dBFS (a peak of 3277): one cycle */
+static const int16_t tone[48] = {
+	0, 428, 848, 1254, 1638, 1995, 2317, 2600, 2838, 3028, 3165, 3249,
+	3277, 3249, 3165, 3028, 2838, 2600, 2317, 1995, 1638, 1254, 848, 428,
+	0, -428, -848, -1254, -1638, -1995, -2317, -2600, -2838, -3028, -3165, -3249,
+	-3277, -3249, -3165, -3028, -2838, -2600, -2317, -1995, -1638, -1254, -848, -428,
+};
+static uint32_t tone_at;
+
+static void
+period_fill(unsigned period, bool silent)
+{
+	int16_t *samples = (int16_t *)(buffer + 4096 * period);
+
+	for (unsigned frame = 0; frame < PERIOD_FRAMES; frame++) {
+		int16_t sample = silent ? 0 : tone[tone_at++ % 48];
+
+		samples[2 * frame] = sample;
+		samples[2 * frame + 1] = sample;
+	}
+	for (vm_offset_t line = (vm_offset_t)samples; line < (vm_offset_t)samples + PERIOD_BYTES; line += 64) {
+		__asm__ volatile ("dc cvac, %0" : : "r" (line));        /* the DSP reads memory, not our caches */
+	}
+	__asm__ volatile ("dsb sy");
+}
+
+static bool
+period_write(unsigned period)
+{
+	uint32_t write[8] = { (uint32_t)(buffer_address + 4096 * period), (uint32_t)((buffer_address + 4096 * period) >> 32),
+		              map_handle, PERIOD_BYTES, period, 0, 0, 0 };
+
+	return hakios_adsp_apr(APR_SVC_ASM, STREAM_PORT, WRITE_TOKEN | period, ASM_DATA_CMD_WRITE_V2, write, sizeof(write), 0, NULL);
+}
+
+/*
+ * The tone, written period after period as the DSP gives them back, for `ms'; then silence until
+ * the DSP has given every period back. What came back and how fast is said.
+ */
+static bool
+play(uint32_t ms, bool amplifiers)
+{
+	uint64_t began, last_look, ended;
+	uint32_t sent = 0, done_before = written_done, healthy_looks = 0;
+	bool ok = true, tone_over = false;
+
+	returned = 0;
+	tone_at = 0;
+	for (unsigned p = 0; p < PERIODS; p++) {
+		period_fill(p, false);
+	}
+	began = last_look = now_us();
+	for (unsigned p = 0; p < PERIODS; p++) {
+		if (!period_write(p)) {
+			say("sound: the write of period %u could not be sent\n", p);
+			return false;
+		}
+		sent++;
+	}
+	for (;;) {
+		uint32_t back = returned;
+		uint64_t now = now_us();
+
+		if (back != 0) {
+			OSBitAndAtomic(~back, &returned);
+			for (unsigned p = 0; p < PERIODS; p++) {
+				if (!(back & 1u << p) || tone_over) {
+					continue;
+				}
+				period_fill(p, false);
+				if (!period_write(p)) {
+					say("sound: the write of period %u could not be sent\n", p);
+					ok = false;
+					tone_over = true;
+					break;
+				}
+				sent++;
+			}
+		}
+		if (!tone_over && (now - began >= ms * 1000ull || stopping)) {
+			tone_over = true;
+		}
+		if (tone_over && written_done - done_before >= sent) {
+			break;
+		}
+		if (now - began > ms * 1000ull + 2000000) {
+			say("sound: THE DSP HAS NOT GIVEN EVERY PERIOD BACK 2 s after the end (%u of %u)\n", written_done - done_before,
+			    sent);
+			ok = false;
+			break;
+		}
+		if (written_done == done_before && now - began > 1000000) {
+			say("sound: THE DSP HAS GIVEN NO PERIOD BACK IN A SECOND\n");
+			ok = false;
+			break;
+		}
+		if (amplifiers && now - last_look >= 200000) {
+			last_look = now;
+			healthy_looks++;
+			if (!hakios_speaker_healthy()) {
+				ok = false;
+				tone_over = true;
+			}
+		}
+		sleep_ms(2);
+	}
+	ended = now_us();
+	{
+		uint32_t done = written_done - done_before;
+		uint64_t frames = (uint64_t)done * PERIOD_FRAMES, us = ended - began;
+
+		say("sound: %u periods written, %u given back (%u with an error), %u underflows, in %llu ms: the DSP took %llu frames a "
+		    "second%s\n", sent, done, write_errors, underflows, us / 1000, us ? frames * 1000000 / us : 0,
+		    amplifiers ? "" : " (the amplifiers off: nothing to hear)");
+		if (amplifiers) {
+			say("sound: the amplifiers' status looked at %u times while it played\n", healthy_looks);
+		}
+	}
+	return ok;
+}
+
+/* ---- sound=4: what Darwin plays ------------------------------------------------------------------------------ */
+
+/*
+ * /dev/hakios-audio's writer (the audio server's real-time thread, hakios.audio.c) puts frames
+ * into a ring and does not wait; the feeder, a thread of ours, takes them from there into each
+ * period the DSP gives back (and silence when there is nothing), so the stream never stops
+ * while the run lasts. The amplifiers are only on while there is sound: the watcher starts them
+ * (and fades them in to sound_below) when a write is not silence, and stops them after three
+ * seconds of silence or no writes.
+ */
+#define RING_FRAMES             32768           /* 0.68 s; a power of two, the indices run on and wrap */
+#define SILENCE                 8               /* samples no larger than this are silence (as hakios.audio.c's) */
+#define QUIET_BEFORE_OFF_US     3000000ull
+
+static int16_t ring[RING_FRAMES * 2];
+static volatile uint32_t ring_head, ring_tail;  /* frames: written by the sink, taken by the feeder */
+static volatile uint64_t last_sound_us;         /* when the latest write that was not silence came */
+static volatile bool feeder_runs, watcher_runs;
+static uint64_t fed_frames, silent_frames, darwin_frames;
+static volatile uint32_t darwin_peak;              /* the largest sample since the amplifiers last started */
+
+/* From the writer's thread, under hakios.audio.c's lock: never waits. */
+static uint32_t
+darwin_sink(const int16_t *frames, uint32_t count)
+{
+	uint32_t head = ring_head, room = RING_FRAMES - (head - ring_tail), taken = count < room ? count : room;
+	bool sound = false;
+
+	for (uint32_t i = 0; i < taken; i++) {
+		int16_t left = frames[2 * i], right = frames[2 * i + 1];
+		uint32_t l = left < 0 ? (uint32_t)-(int32_t)left : (uint32_t)left, r = right < 0 ? (uint32_t)-(int32_t)right : (uint32_t)right;
+
+		ring[2 * ((head + i) % RING_FRAMES)] = left;
+		ring[2 * ((head + i) % RING_FRAMES) + 1] = right;
+		sound |= l > SILENCE || r > SILENCE;
+		if (l > darwin_peak || r > darwin_peak) {
+			darwin_peak = l > r ? l : r;
+		}
+	}
+	OSMemoryBarrier();
+	ring_head = head + taken;
+	darwin_frames += taken;
+	if (sound) {
+		last_sound_us = now_us();
+	}
+	return taken;
+}
+
+static uint32_t guard_periods;                  /* periods through the guard */
+static volatile bool guard_on;                  /* the amplifiers are on: what the guard lets through is heard */
+
+/* tenths of a dB as text: "-5.7" */
+static const char *
+db_text(char *text, int tenths)
+{
+	snprintf(text, 16, "%s%d.%d", tenths < 0 ? "-" : "", (tenths < 0 ? -tenths : tenths) / 10, (tenths < 0 ? -tenths : tenths) % 10);
+	return text;
+}
+
+/* What the guard has done since it was last said (hakios.guard.c), as one line; nothing if `quiet'. */
+static void
+guard_say(const char *when, bool quiet)
+{
+	struct hakios_guard_report r;
+	char t[6][16];
+
+	hakios_guard_take_report(&r);
+	if (r.blocks == 0 || quiet) {
+		return;
+	}
+	/* (levels at the speakers: dB under a full-scale square wave at Android's level; gains in dB) */
+	say("sound: the guard%s: peaks in %u, out %u (of 32768); gain now %s dB, least %s dB, held down by the 0.2 s/3 s/60 s "
+	    "averages in %u/%u/%u of %u periods; peaks limited in %u frames (by %s dB at most); averages %s/%s/%s dB\n",
+	    when, r.peak_in, r.peak_out, db_text(t[0], hakios_guard_decibels(r.gain * r.gain >> 30)),
+	    db_text(t[1], hakios_guard_decibels(r.least_gain * r.least_gain >> 30)), r.rms_blocks, r.fast_blocks, r.slow_blocks,
+	    r.blocks, r.limited_frames, db_text(t[2], hakios_guard_decibels((uint64_t)r.least_peak_gain * r.least_peak_gain >> 2)),
+	    db_text(t[3], hakios_guard_decibels(r.rms)), db_text(t[4], hakios_guard_decibels(r.fast)),
+	    db_text(t[5], hakios_guard_decibels(r.slow)));
+}
+
+/* A period from the ring, the rest of it silence. */
+static void
+period_fill_darwin(unsigned period)
+{
+	int16_t *samples = (int16_t *)(buffer + 4096 * period);
+	uint32_t tail = ring_tail, available = ring_head - tail, n = available < PERIOD_FRAMES ? available : PERIOD_FRAMES;
+
+	OSMemoryBarrier();
+	for (uint32_t i = 0; i < n; i++) {
+		int16_t left = ring[2 * ((tail + i) % RING_FRAMES)], right = ring[2 * ((tail + i) % RING_FRAMES) + 1];
+
+		if (board->adm_channels == 1) {
+			/*
+			 * One speaker (cepheus): the two channels mixed here, (L + R) / 2 in both, rather than left to the DSP's
+			 * matrix, which might take only one of them -- what Darwin plays on one side alone is heard too.
+			 */
+			int16_t mono = (int16_t)(((int32_t)left + right) / 2);
+
+			left = right = mono;
+		}
+		samples[2 * i] = left;
+		samples[2 * i + 1] = right;
+	}
+	bzero(samples + 2 * n, (PERIOD_FRAMES - n) * 4);
+	OSMemoryBarrier();
+	ring_tail = tail + n;
+	fed_frames += n;
+	silent_frames += PERIOD_FRAMES - n;
+	/* the guard, on every period, silence too: its filter and its averages go on (hakios.guard.c) */
+	hakios_guard_process(samples, PERIOD_FRAMES);
+	if (n != 0 && hakios_audio_recording_fed()) {
+		hakios_audio_record_fed(samples, n);
+	}
+	guard_periods++;
+	for (vm_offset_t line = (vm_offset_t)samples; line < (vm_offset_t)samples + PERIOD_BYTES; line += 64) {
+		__asm__ volatile ("dc cvac, %0" : : "r" (line));
+	}
+	__asm__ volatile ("dsb sy");
+}
+
+static void
+feeder_thread(__unused void *parameter, __unused wait_result_t result)
+{
+	uint32_t sent = 0, failed = 0;
+
+	returned = 0;
+	for (unsigned p = 0; p < PERIODS; p++) {
+		period_fill_darwin(p);
+		sent += period_write(p);
+	}
+	while (!stopping) {
+		uint32_t back = returned;
+		static bool was_on;
+
+		if (guard_on && !was_on) {
+			guard_say("", true);    /* (what it did to the silence meanwhile is of no interest) */
+			guard_periods = 0;
+		} else if (was_on && !guard_on) {
+			guard_say(" until the amplifiers stopped", false);
+		} else if (guard_on && guard_periods >= 250) {
+			guard_say(", 5 s", false);
+			guard_periods = 0;
+		}
+		was_on = guard_on;
+		if (back != 0) {
+			OSBitAndAtomic(~back, &returned);
+			for (unsigned p = 0; p < PERIODS; p++) {
+				if (back & 1u << p) {
+					period_fill_darwin(p);
+					if (period_write(p)) {
+						sent++;
+					} else {
+						failed++;
+					}
+				}
+			}
+		}
+		sleep_ms(2);
+	}
+	say("sound: the feeder stops: %u periods written (%u could not be sent), %u given back (%u with an error), %u underflows; "
+	    "from Darwin %llu frames came, %llu went to the DSP, %llu of silence filled in\n", sent, failed, written_done, write_errors,
+	    underflows, darwin_frames, fed_frames, silent_frames);
+	feeder_runs = false;
+	thread_terminate(current_thread());
+}
+
+/* The amplifiers' level as the guard is to reckon with it (sound_guard_as: louder than it is, for a test). */
+static void
+guard_level(uint32_t level_below)
+{
+	uint32_t as = level_below < guard_as ? level_below : guard_as;
+
+	/* (HAKIOS_GUARD_SILENT means "the amplifiers are off": a level must never be taken for it, it would turn the power limits off) */
+	hakios_guard_attenuation(as >= HAKIOS_GUARD_SILENT ? HAKIOS_GUARD_SILENT - 1 : as);
+}
+
+/*
+ * sound_below and the volume Darwin has set (`extra', eighths of a dB under it), added up: saturating, so that a
+ * huge sound_below or `extra' cannot wrap the sum round to a small number, that is to a loud level.
+ */
+static uint32_t
+below_with(uint32_t extra)
+{
+	uint64_t total = (uint64_t)below + extra;
+
+	return total > HAKIOS_GUARD_SILENT - 1 ? HAKIOS_GUARD_SILENT - 1 : (uint32_t)total;
+}
+
+/*
+ * The amplifiers are off. The guard goes on at their level all the same: what it lets through now reaches them
+ * 160 ms later, behind the periods queued at the DSP, and if that is sound, they will have been started by then
+ * (70 ms after it comes). While they are off nothing but silence comes, and the averages fall as a speaker cools.
+ * Only when nothing can be heard at all -- Darwin's volume at 0, the amplifiers given up on -- is the guard told so.
+ */
+static void
+guard_off(bool unheard)
+{
+	guard_on = false;
+	if (unheard) {
+		hakios_guard_attenuation(HAKIOS_GUARD_SILENT);
+	}
+}
+
+/*
+ * The amplifiers on while there is sound, at the volume Darwin has set (hakios_audio_volume(): how
+ * far under the loudest, sound_below under Android's level), and off while Darwin's volume is 0;
+ * their status looked at every 200 ms while they are on. On the sound's thread.
+ */
+static void
+watch(void)
+{
+	bool on = false, given_up = false, muted = false;
+	uint64_t last_look = 0, last_monitor = 0;
+	uint32_t starts = 0, changes = 0, generation = 0, extra = 0, monitor = 0, monitor_looks = 0;
+
+	guard_level(below);                     /* (from the first sample on: see guard_off()) */
+
+	while (!stopping) {
+		uint64_t now = now_us(), sounded = last_sound_us;
+		uint32_t extra_now, generation_now;
+		bool muted_now;
+
+		if (hakios_audio_volume(&extra_now, &muted_now, &generation_now) && generation_now != generation) {
+			generation = generation_now;
+			extra = extra_now;
+			muted = muted_now;
+			changes++;
+			say("sound: Darwin sets the volume: %s%u.%03u dB under the loudest, which is %u.%03u dB under Android's level%s\n",
+			    muted ? "muted (0), " : "", extra / 8, extra % 8 * 125, below / 8, below % 8 * 125,
+			    on ? (muted ? ": the amplifiers are stopped" : ": the amplifiers follow") : "");
+			if (muted) {
+				guard_off(true);
+				if (on) {
+					hakios_speaker_stop();
+					on = false;
+				}
+			} else if (on && !hakios_speaker_volume(below_with(extra), 1)) {
+				guard_off(true);
+				on = false;
+				given_up = true;
+			} else if (!given_up) {
+				guard_level(below_with(extra));
+			}
+		}
+		if (!on && !given_up && !muted && sounded != 0 && now - sounded < 100000) {
+			say_when("Darwin plays: the amplifiers are started");
+			starts++;
+			darwin_peak = 0;
+			if (!hakios_speaker_start() || !hakios_speaker_volume(below_with(extra), 1)) {
+				say("sound: THE AMPLIFIERS DID NOT START; Darwin's sound goes on to the DSP, unheard\n");
+				guard_off(true);
+				given_up = true;
+			} else {
+				on = true;
+				guard_on = true;
+				last_look = now_us();
+				last_monitor = 0;
+				monitor_looks = 0;
+				/* (what is written now is heard after the periods already queued at the DSP: PERIODS x 20 ms) */
+				say("sound: the amplifiers are up %llu ms after the first write that was not silence; that write reaches "
+				    "them %u ms after it was made, behind the periods queued at the DSP\n", (last_look - sounded) / 1000,
+				    PERIODS * PERIOD_FRAMES / 48);
+			}
+		} else if (on && now - sounded > QUIET_BEFORE_OFF_US) {
+			say_when("three seconds of silence: the amplifiers are stopped");
+			say("sound: what Darwin wrote while they were on peaked at %u%% of full scale (%u)\n", darwin_peak * 100 / 32768,
+			    darwin_peak);
+			guard_off(false);
+			hakios_speaker_stop();
+			on = false;
+		} else if (on && now - last_look >= 200000) {
+			last_look = now;
+			if (!hakios_speaker_healthy()) {
+				guard_off(true);
+				on = false;
+				given_up = true;
+			} else if (now - last_monitor >= 1000000) {
+				/* the amplifiers' temperature and the battery as they see it, every second: a reduction if Android's table asks for one */
+				uint32_t wanted;
+
+				last_monitor = now;
+				wanted = hakios_speaker_monitor(monitor_looks++ % 10 == 0);
+				if (wanted != monitor) {
+					say("sound: the amplifiers' watch asks for %u.%03u dB less (it was %u.%03u)\n", wanted / 8, wanted % 8 * 125,
+					    monitor / 8, monitor % 8 * 125);
+					monitor = wanted;
+					hakios_guard_monitor(monitor);
+				}
+			}
+		}
+		sleep_ms(5);
+	}
+	guard_off(true);
+	say("sound: the watcher stops; the amplifiers were started %u times, Darwin set the volume %u times%s\n", starts, changes,
+	    given_up ? ", and the amplifiers were then given up on" : "");
+	watcher_runs = false;
+}
+
+/* ---- the whole ---------------------------------------------------------------------------------------- */
+
+static bool running, taken_down;
+
+static void
+take_down(void)
+{
+	stopping = true;
+	if (level >= 4) {
+		hakios_audio_set_sink("nothing", NULL);
+	}
+	for (unsigned ms = 0; ms < 3000 && (feeder_runs || watcher_runs); ms++) {
+		sleep_ms(1);
+	}
+	lck_mtx_lock(&sound_lock);
+	if (running && !taken_down) {
+		taken_down = true;
+		hakios_speaker_stop();
+		stream_off();
+		afe_off();
+		pins_off();
+		lck_mtx_lock(&hakios_smmu_lock);
+		shared_put(0);
+		lck_mtx_unlock(&hakios_smmu_lock);
+		hakios_adsp_apr_events(NULL);
+		say("sound: everything of the sound's is stopped and put back\n");
+	}
+	lck_mtx_unlock(&sound_lock);
+}
+
+static void
+sound_thread(__unused void *parameter, __unused wait_result_t result)
+{
+	const uint8_t *acf = NULL;
+	uint64_t acf_size = 0;
+	uint32_t changes, ones, sync_changes, sync_ones;
+	bool ok = false;
+
+	lck_mtx_lock(&sound_lock);
+	if (taken_down) {
+		lck_mtx_unlock(&sound_lock);
+		thread_terminate(current_thread());
+	}
+	if (level == 4) {
+		say("sound: level 4: what Darwin plays, through the port, a stream and the amplifiers, until the run ends\n");
+	} else {
+		say("sound: level %u (%s): %s, for %u s\n", level, board->name, level == 1 ? board->what : level == 2 ?
+		    "the port and a stream with a test tone, the amplifiers off" :
+		    "the port, a stream with a test tone, and the amplifiers", seconds);
+	}
+	if (level >= 3 && board->acf != NULL) {
+		acf = hakios_adsp_fw_file(board->acf, &acf_size);
+		if (acf == NULL) {
+			say("sound: no /fw/aw882xx_acf.bin: put the phone's /vendor/etc/aw882xx_acf.bin into fw-audio/ and run SYSTEM=1 "
+			    "userland/build.sh\n");
+			goto out;
+		}
+	}
+	if (level >= 2) {
+		lck_mtx_lock(&hakios_smmu_lock);
+		ok = shared_get(0);
+		lck_mtx_unlock(&hakios_smmu_lock);
+		if (!ok) {
+			goto out;
+		}
+		ok = false;
+		hakios_adsp_apr_events(events);
+	}
+	announce("the interface's pins to the interface, as Android's active state has them");
+	pins_on();
+	if (!afe_on()) {
+		goto out;
+	}
+	sleep_ms(20);
+	pin_activity(board->clock_pin, board->pins[0].name, &changes, &ones);
+	pin_activity(board->sync_pin, board->pins[1].name, &sync_changes, &sync_ones);
+	say("sound: %s\n", changes > 100 && sync_changes > 4 ? "THE INTERFACE'S CLOCK AND FRAME SYNC RUN at the pins" :
+	    "THE PINS DO NOT SHOW A RUNNING CLOCK");
+	if (level == 1) {
+		sleep_ms(seconds * 1000);
+		ok = true;
+		goto out;
+	}
+	if (!stream_on()) {
+		goto out;
+	}
+	if (level == 4) {
+		thread_t feeder;
+
+		announce(board->acf != NULL ? "the amplifiers, set up from Android's Music profile, powered down until Darwin plays" :
+		    "the amplifier, set up as Android's driver sets it up, powered down until Darwin plays");
+		if (!hakios_speaker_prepare(acf, acf_size)) {
+			goto out;
+		}
+		hakios_adsp_fw_free(acf, acf_size);
+		acf = NULL;
+		feeder_runs = true;
+		if (kernel_thread_start(feeder_thread, NULL, &feeder) != KERN_SUCCESS) {
+			feeder_runs = false;
+			say("sound: no thread for the feeder\n");
+			goto out;
+		}
+		thread_deallocate(feeder);
+		watcher_runs = true;
+		hakios_audio_set_sink("the speakers (the audio DSP, hakios.sound.c)", darwin_sink);
+		say("sound: WHAT DARWIN PLAYS GOES TO THE SPEAKERS from here on, %u.%03u dB under Android's level, until the run ends\n",
+		    below / 8, below % 8 * 125);
+		say("sound: through the guard (hakios.guard.c): %u.%03u dB of gain first (sound_gain), then high-pass at 200 Hz; peaks "
+		    "3 dB, the 0.2 s/3 s/60 s power 6/9/12 dB under full scale at Android's level\n", gain / 8, gain % 8 * 125);
+		if (guard_as < below) {
+			say("sound: sound_guard_as=%u: FOR A TEST the guard reckons the amplifiers %u.%03u dB under Android's level, louder "
+			    "than they are, and holds back as much as it would there\n", guard_as, guard_as / 8, guard_as % 8 * 125);
+		}
+		lck_mtx_unlock(&sound_lock);
+		watch();
+		thread_terminate(current_thread());
+	}
+	if (level >= 3) {
+		/* the clock runs (the port is started, the stream as well): the amplifiers can lock to it */
+		announce(board->acf != NULL ? "the amplifiers, set up from Android's Music profile, then started at the lowest volume" :
+		    "the amplifier, set up as Android's driver sets it up, then started at the lowest volume");
+		if (!hakios_speaker_prepare(acf, acf_size) || !hakios_speaker_start()) {
+			goto out;
+		}
+	}
+	/* (the amplifiers are faded in before the tone begins: they fade in on silence, and the tone starts at that level) */
+	if (level >= 3 && !hakios_speaker_volume(below, 50)) {
+		goto out;
+	}
+	if (level >= 3) {
+		say("sound: THE TONE PLAYS NOW for %u s: 1 kHz at -20 dBFS, %s, %u.%03u dB under Android's level\n",
+		    seconds, board->adm_channels == 1 ? "the speaker" : "both speakers", below / 8, below % 8 * 125);
+	}
+	say_when("the tone begins");
+	ok = play(seconds * 1000, level >= 3);
+	say_when("the tone has ended");
+	space_faults();
+out:
+	if (acf != NULL) {
+		hakios_adsp_fw_free(acf, acf_size);
+	}
+	lck_mtx_unlock(&sound_lock);
+	take_down();
+	say("sound: %s; last: %s\n", ok ? "LEVEL DONE" : "STOPPED SHORT", last_write);
+	thread_terminate(current_thread());
+}
+
+void
+hakios_sound_dsp_up(void)
+{
+	thread_t thread;
+
+	if (!PE_parse_boot_argn("sound", &level, sizeof(level)) || level == 0) {
+		return;
+	}
+	choose_board();
+	below = board->below;
+	gain = board->gain;
+	if (level > 4) {
+		level = 4;
+	}
+	PE_parse_boot_argn("sound_secs", &seconds, sizeof(seconds));
+	PE_parse_boot_argn("sound_below", &below, sizeof(below));
+	PE_parse_boot_argn("sound_pause", &pause_ms, sizeof(pause_ms));
+	PE_parse_boot_argn("sound_guard_as", &guard_as, sizeof(guard_as));
+	PE_parse_boot_argn("sound_gain", &gain, sizeof(gain));
+	if (gain > HAKIOS_GUARD_MAX_GAIN) {
+		gain = HAKIOS_GUARD_MAX_GAIN;
+	}
+	hakios_guard_configure(true, gain);
+	if (level >= 2 && level <= 3 && seconds > 3) {
+		seconds = 3;            /* the test tone: three seconds at most */
+	}
+	running = true;
+	if (kernel_thread_start(sound_thread, NULL, &thread) != KERN_SUCCESS) {
+		running = false;
+		say("sound: no thread\n");
+		return;
+	}
+	thread_deallocate(thread);
+}
+
+void
+hakios_sound_dsp_down(void)
+{
+	if (running) {
+		take_down();
+	}
+}
+
+void
+hakios_sound_quiesce(void)
+{
+	hakios_speaker_quiesce();
+}
